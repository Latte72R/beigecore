import eei::*;
interface core_inst_if {
    #[ifdef(LOG_KONATA)]
    var trace_id: logic<64>;
    #[ifdef(LOG_KONATA)]
    var trace_id_next: logic<64>;
    var rvalid       : logic    ;
    var rready       : logic    ;
    var raddr        : Addr     ;
    var rdata        : Inst     ;
    var is_redirect  : logic    ;
    var next_pc      : Addr     ;

    modport master {
        #[ifdef(LOG_KONATA)]
        trace_id: input,
        #[ifdef(LOG_KONATA)]
        trace_id_next: input ,
        rvalid       : input ,
        rready       : output,
        raddr        : input ,
        rdata        : input ,
        is_redirect  : output, // control hazard
        next_pc      : output, // actual next pc
    }

    modport slave {
        ..converse(master)
    }
}
