import eei::*;
interface core_inst_if {
    var rvalid                  : logic;
    var rready                  : logic;
    var raddr                   : Addr ;
    var rdata                   : Inst ;
    var is_rvc                  : logic;
    var is_redirect             : logic;
    var redirect_fetch_now      : logic;
    var redirect_fetch_pc       : Addr ;
    var next_pc                 : Addr ;
    var prediction_query_pc     : Addr ;
    var prediction_bimodal_taken: logic;
    var prediction_bimodal_valid: logic;
    var prediction_btb_hit      : logic;
    var prediction_btb_target   : Addr ;
    var prediction_taken        : logic;
    var prediction_target       : Addr ;
    var prediction_redirect     : logic;

    modport master {
        rvalid                  : input ,
        rready                  : output,
        raddr                   : input ,
        rdata                   : input ,
        is_rvc                  : input ,
        is_redirect             : output, // control hazard
        redirect_fetch_now      : output,
        redirect_fetch_pc       : output,
        next_pc                 : output, // actual next pc
        prediction_query_pc     : input ,
        prediction_bimodal_taken: output,
        prediction_bimodal_valid: output,
        prediction_btb_hit      : output,
        prediction_btb_target   : output,
        prediction_taken        : input ,
        prediction_target       : input ,
        prediction_redirect     : input ,
    }

    // Veryl のバグのため
    // modport slave {
    //     ..converse(master)
    // }

    modport slave {
        rvalid                  : output,
        rready                  : input ,
        raddr                   : output,
        rdata                   : output,
        is_rvc                  : output,
        is_redirect             : input ,
        redirect_fetch_now      : input ,
        redirect_fetch_pc       : input ,
        next_pc                 : input ,
        prediction_query_pc     : output,
        prediction_bimodal_taken: input ,
        prediction_bimodal_valid: input ,
        prediction_btb_hit      : input ,
        prediction_btb_target   : input ,
        prediction_taken        : output,
        prediction_target       : output,
        prediction_redirect     : output,
    }
}
