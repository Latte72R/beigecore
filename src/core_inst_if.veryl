import eei::*;
interface core_inst_if {
    var rvalid     : logic;
    var rready     : logic;
    var raddr      : Addr ;
    var rdata      : Inst ;
    var is_rvc     : logic;
    var is_redirect: logic;
    var next_pc    : Addr ;

    modport master {
        rvalid     : input ,
        rready     : output,
        raddr      : input ,
        rdata      : input ,
        is_rvc     : input ,
        is_redirect: output, // control hazard
        next_pc    : output, // actual next pc
    }

    // Veryl のバグのため
    // modport slave {
    //     ..converse(master)
    // }

    modport slave {
        rvalid     : output,
        rready     : input ,
        raddr      : output,
        rdata      : output,
        is_rvc     : output,
        is_redirect: input ,
        next_pc    : input ,
    }
}
