import eei::*;
import corectrl::*;

module issue_queue (
    clk  : input clock,
    rst  : input reset,
    flush: input logic,

    squash     : input logic ,
    squash_head: input RobTag,
    squash_tag : input RobTag,

    // dispatch
    wvalid   : input  logic   ,
    wready   : output logic   ,
    wdata    : input  euq_type,
    wrs1ready: input  logic   ,
    wrs2ready: input  logic   ,

    // registered wakeup
    wakeup0_valid: input logic  ,
    wakeup0_preg : input PhysReg,
    wakeup1_valid: input logic  ,
    wakeup1_preg : input PhysReg,
    wakeup2_valid: input logic  ,
    wakeup2_preg : input PhysReg,
    wakeup3_valid: input logic  ,
    wakeup3_preg : input PhysReg,

    // issue
    rvalid: output logic   ,
    rready: input  logic   ,
    rdata : output euq_type,
) {
    // entry[0]が最古，entry[count - 1]が最新
    // 任意entryをissueした後は後続entryを前へ詰める
    struct issue_entry_type {
        valid    : logic   ,
        data     : euq_type,
        rs1_ready: logic   ,
        rs2_ready: logic   ,
        ready    : logic   ,
    }

    var entries     : issue_entry_type    [8];
    var entries_next: issue_entry_type    [8];
    var count       : logic           <4>    ;
    var count_next  : logic           <4>    ;

    var selected_valid: logic          ;
    var selected_index: logic   <3>    ;
    var lower_index   : logic   <3>    ;
    var upper_index   : logic   <3>    ;
    var lower_data    : euq_type       ;
    var upper_data    : euq_type       ;
    var keep_count    : logic   <4>    ;
    var squash_keep   : logic       [8];
    var squash_sum1   : logic   <2> [4];
    var squash_sum2   : logic   <3> [2];
    var squash_sum3   : logic   <4>    ;

    let ready0     : logic = entries[0].valid && entries[0].ready;
    let ready1     : logic = entries[1].valid && entries[1].ready;
    let ready2     : logic = entries[2].valid && entries[2].ready;
    let ready3     : logic = entries[3].valid && entries[3].ready;
    let ready4     : logic = entries[4].valid && entries[4].ready;
    let ready5     : logic = entries[5].valid && entries[5].ready;
    let ready6     : logic = entries[6].valid && entries[6].ready;
    let ready7     : logic = entries[7].valid && entries[7].ready;
    let lower_ready: logic = ready0 || ready1 || ready2 || ready3;

    // readyなentryのうち最も古いものを選択する
    always_comb {
        selected_valid = ready0 || ready1 || ready2 || ready3 || ready4 || ready5 || ready6 || ready7;

        selected_index = switch {
            ready0 : 0,
            ready1 : 1,
            ready2 : 2,
            ready3 : 3,
            ready4 : 4,
            ready5 : 5,
            ready6 : 6,
            ready7 : 7,
            default: 0,
        };

        // 8-wayのentry muxを4-way mux二つに分け、選択経路を短縮する。
        // lower側にreadyがあれば必ずそちらが最古なので、upper側は選ばない。
        rvalid      = selected_valid;
        lower_index = switch {
            ready0 : 0,
            ready1 : 1,
            ready2 : 2,
            ready3 : 3,
            default: 0,
        };
        upper_index = switch {
            ready4 : 4,
            ready5 : 5,
            ready6 : 6,
            ready7 : 7,
            default: 4,
        };
        lower_data = entries[lower_index].data;
        upper_data = entries[upper_index].data;
        rdata      = if lower_ready ? lower_data : upper_data;
    }

    // When full, accept a new entry in the same cycle that the selected
    // entry is issued, so a full queue does not create a dispatch bubble.
    assign wready = count != 8 || (rvalid && rready);

    // 次状態の更新順序:
    //   1. writeback tagによるwakeup
    //   2. issue済みentryの削除とcompact
    //   3. dispatchされたentryを末尾へ追加
    always_comb {
        count_next   = count;
        entries_next = entries;
        keep_count   = 0;
        for i in 0..8 {
            squash_keep[i] = 0;
        }
        for i in 0..4 {
            squash_sum1[i] = 0;
        }
        for i in 0..2 {
            squash_sum2[i] = 0;
        }
        squash_sum3 = 0;

        for i in 0..8 {
            if (wakeup0_valid && entries[i].data.rs1_preg == wakeup0_preg)
                || (wakeup1_valid && entries[i].data.rs1_preg == wakeup1_preg)
                || (wakeup2_valid && entries[i].data.rs1_preg == wakeup2_preg)
                || (wakeup3_valid && entries[i].data.rs1_preg == wakeup3_preg) {
                entries_next[i].rs1_ready = 1;
            }

            if (wakeup0_valid && entries[i].data.rs2_preg == wakeup0_preg)
                || (wakeup1_valid && entries[i].data.rs2_preg == wakeup1_preg)
                || (wakeup2_valid && entries[i].data.rs2_preg == wakeup2_preg)
                || (wakeup3_valid && entries[i].data.rs2_preg == wakeup3_preg) {
                entries_next[i].rs2_ready = 1;
            }

            entries_next[i].ready = entries_next[i].rs1_ready && entries_next[i].rs2_ready;
        }

        // issueされたentryを削除し後続entryを1つ前へ詰める
        if rvalid && rready {
            for i in 0..7 {
                if i >= selected_index {
                    entries_next[i] = entries_next[i + 1];
                }
            }
            entries_next[7] =  '0;
            count_next      -= 1;
        }

        // 新しい末尾indexに書き込み
        let write_index: logic<3> = count_next[2:0];
        if wvalid && wready {
            entries_next[write_index].valid     =  1;
            entries_next[write_index].data      =  wdata;
            entries_next[write_index].rs1_ready =  wrs1ready;
            entries_next[write_index].rs2_ready =  wrs2ready;
            entries_next[write_index].ready     =  wrs1ready && wrs2ready;
            count_next                          += 1;
        }

        // Entries are kept in program order, so all instructions younger than
        // the resolving branch form one suffix.  Keep only the older prefix.
        if squash {
            for i in 0..8 {
                // branch_redirect時はcontrol_hazardでissue/dispatchが止まるため、
                // recovery対象は現在のentryだけで判定できる。
                squash_keep[i] = entries[i].valid
                    && !((entries[i].data.rob_tag - squash_head) >: (squash_tag - squash_head));
                if !squash_keep[i] {
                    entries_next[i].valid = 0;
                }
            }
            squash_sum1[0] = {1'b0, squash_keep[0]} + {1'b0, squash_keep[1]};
            squash_sum1[1] = {1'b0, squash_keep[2]} + {1'b0, squash_keep[3]};
            squash_sum1[2] = {1'b0, squash_keep[4]} + {1'b0, squash_keep[5]};
            squash_sum1[3] = {1'b0, squash_keep[6]} + {1'b0, squash_keep[7]};
            squash_sum2[0] = {1'b0, squash_sum1[0]} + {1'b0, squash_sum1[1]};
            squash_sum2[1] = {1'b0, squash_sum1[2]} + {1'b0, squash_sum1[3]};
            squash_sum3    = {1'b0, squash_sum2[0]} + {1'b0, squash_sum2[1]};
            keep_count     = squash_sum3;
            count_next     = keep_count;
        }
    }

    // Queue state update.
    // flush時はcountだけを0にすれば全entryが無効になる
    always_ff {
        if_reset {
            count = 0;
            for i in 0..8 {
                entries[i] = '0;
            }
        } else if flush {
            count = 0;
            for i in 0..8 {
                entries[i].valid = 0;
            }
        } else {
            entries = entries_next;
            count   = count_next;
        }
    }
}
