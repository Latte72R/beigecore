import eei::*;
import corectrl::*;

module issue_queue #(
    param ENTRY_COUNT: u32 = 4,
    param INDEX_WIDTH: u32 = 2,
) (
    clk  : input clock,
    rst  : input reset,
    flush: input logic,

    // branch mispredictによる若い命令の削除
    squash     : input logic ,
    squash_head: input RobTag, // 現在のROB head tag
    squash_tag : input RobTag, // mispredict branchのROB tag

    // dispatch
    wvalid   : input  logic   ,
    wready   : output logic   ,
    wdata    : input  euq_type,
    wrs1ready: input  logic   ,
    wrs2ready: input  logic   ,

    // registered wakeup
    wakeup0_valid: input logic  ,
    wakeup0_preg : input PhysReg,
    wakeup1_valid: input logic  ,
    wakeup1_preg : input PhysReg,
    wakeup2_valid: input logic  ,
    wakeup2_preg : input PhysReg,
    wakeup3_valid: input logic  ,
    wakeup3_preg : input PhysReg,

    // issue
    rvalid: output logic   ,
    rready: input  logic   ,
    rdata : output euq_type,

    // program order上で最も古いentry
    // operandがreadyでなくてもmemory依存判定に使用する
    oldest_valid: output logic   ,
    oldest_data : output euq_type,
) {
    // entry[0]が最古，entry[count - 1]が最新
    // 任意entryをissueした後は後続entryを前へ詰める
    struct issue_entry_type {
        valid    : logic   ,
        data     : euq_type,
        rs1_ready: logic   ,
        rs2_ready: logic   ,
    }

    type Index = logic<INDEX_WIDTH>    ;
    type Count = logic<INDEX_WIDTH + 1>;

    var entries          : issue_entry_type [ENTRY_COUNT];
    var entries_next     : issue_entry_type [ENTRY_COUNT];
    var count            : Count                         ;
    var count_next       : Count                         ;
    var remove           : logic            [ENTRY_COUNT];
    var compacted_entries: issue_entry_type [ENTRY_COUNT];

    var selected_valid: logic              ;
    var selected_index: Index              ;
    var ready         : logic [ENTRY_COUNT];

    always_comb {
        for i in 0..ENTRY_COUNT {
            ready[i] = entries[i].valid && entries[i].rs1_ready && entries[i].rs2_ready;
        }
    }

    if ENTRY_COUNT == 8 :select_eight {
        let ready_low: logic = ready[0] || ready[1] || ready[2] || ready[3];

        let ready_high: logic = ready[4] || ready[5] || ready[6] || ready[7];

        var low_index : logic<2>;
        var high_index: logic<2>;

        let low_data01 : euq_type = if ready[0] ? entries[0].data : entries[1].data;
        let low_data23 : euq_type = if ready[2] ? entries[2].data : entries[3].data;
        let high_data45: euq_type = if ready[4] ? entries[4].data : entries[5].data;
        let high_data67: euq_type = if ready[6] ? entries[6].data : entries[7].data;
        let low_data   : euq_type = if ready[0] || ready[1] ? low_data01 : low_data23;
        let high_data  : euq_type = if ready[4] || ready[5] ? high_data45 : high_data67;

        always_comb {
            low_index = switch {
                ready[0]: 0,
                ready[1]: 1,
                ready[2]: 2,
                default : 3,
            };
            high_index = switch {
                ready[4]: 0,
                ready[5]: 1,
                ready[6]: 2,
                default : 3,
            };

            selected_valid = ready_low || ready_high;
            selected_index = if ready_low ? {1'b0, low_index} : {1'b1, high_index};
            rvalid         = selected_valid;

            // 重要：selected_indexで8:1 MUXを作らない
            rdata = if ready_low ? low_data : high_data;
        }
    } else {
        always_comb {
            selected_valid = ready[0] || ready[1] || ready[2] || ready[3];

            selected_index = switch {
                ready[0]: 0,
                ready[1]: 1,
                ready[2]: 2,
                default : 3,
            };

            rvalid = selected_valid;
            rdata  = entries[selected_index].data;
        }
    }

    always_comb {
        wready       = count != ENTRY_COUNT as Count || (rvalid && rready);
        oldest_valid = count != 0;
        oldest_data  = entries[0].data;
    }

    // 次状態の更新順序:
    //   1. writeback tagによるwakeup
    //   2. issue済みentryの削除とcompact
    //   3. dispatchされたentryを末尾へ追加
    always_comb {
        count_next   = count;
        entries_next = entries;

        for i in 0..ENTRY_COUNT {
            if (wakeup0_valid && entries[i].data.rs1_preg == wakeup0_preg)
                || (wakeup1_valid && entries[i].data.rs1_preg == wakeup1_preg)
                || (wakeup2_valid && entries[i].data.rs1_preg == wakeup2_preg)
                || (wakeup3_valid && entries[i].data.rs1_preg == wakeup3_preg) {
                entries_next[i].rs1_ready = 1;
            }

            if (wakeup0_valid && entries[i].data.rs2_preg == wakeup0_preg)
                || (wakeup1_valid && entries[i].data.rs2_preg == wakeup1_preg)
                || (wakeup2_valid && entries[i].data.rs2_preg == wakeup2_preg)
                || (wakeup3_valid && entries[i].data.rs2_preg == wakeup3_preg) {
                entries_next[i].rs2_ready = 1;
            }
        }

        // (issueされた or oldな) entryを削除し後続entryを1つ前へ詰める
        let issue_fire       : logic            = rvalid && rready;
        let squash_branch_age: logic<ROB_WIDTH> = squash_tag - squash_head;
        for i in 0..ENTRY_COUNT {
            remove[i] = (issue_fire && i == (selected_index as u32))
                || (squash && entries_next[i].valid && (entries_next[i].data.rob_tag - squash_head)
                    >: squash_branch_age);
        }

        // issueまたはsquashされていないentryだけを前へ詰める
        for i in 0..ENTRY_COUNT {
            compacted_entries[i] = 0;
        }
        count_next = 0;
        for i in 0..ENTRY_COUNT {
            if entries_next[i].valid && !remove[i] {
                compacted_entries[count_next[INDEX_WIDTH - 1:0]] =  entries_next[i];
                count_next                                       += 1;
            }
        }
        entries_next = compacted_entries;

        // 新しい末尾indexに書き込み
        let write_index: Index = count_next[INDEX_WIDTH - 1:0];
        if wvalid && wready {
            entries_next[write_index].valid     =  1;
            entries_next[write_index].data      =  wdata;
            entries_next[write_index].rs1_ready =  wrs1ready;
            entries_next[write_index].rs2_ready =  wrs2ready;
            count_next                          += 1;
        }
    }

    // Queue state update.
    // flush時はcountだけを0にすれば全entryが無効になる
    always_ff {
        if_reset {
            count = 0;
            for i in 0..ENTRY_COUNT {
                entries[i] = '0;
            }
        } else if flush {
            count = 0;
            for i in 0..ENTRY_COUNT {
                entries[i].valid = 0;
            }
        } else {
            entries = entries_next;
            count   = count_next;
        }
    }
}
