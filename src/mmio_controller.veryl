import eei::*;

module mmio_controller (
    clk       : input   clock         ,
    rst       : input   reset         ,
    DBG_ADDR  : input   Addr          ,
    req_core  : modport Membus::slave ,
    ram_membus: modport Membus::master,
    rom_membus: modport Membus::master,
    dbg_membus: modport Membus::master,
) {

    enum Device {
        UNKNOWN,
        RAM,
        ROM,
        DEBUG,
    }

    // MMIO要求のうち、保存・転送が必要な部分
    struct Request {
        valid: logic                       ,
        addr : Addr                        ,
        wen  : logic                       ,
        wdata: logic<MEMBUS_DATA_WIDTH>    ,
        wmask: logic<MEMBUS_DATA_WIDTH / 8>,
    }

    // req_coreの要求部分を通常の値へ変換する
    let core_req: Request = Request'{
        valid   : req_core.valid,
        addr    : req_core.addr ,
        wen     : req_core.wen  ,
        wdata   : req_core.wdata,
        wmask   : req_core.wmask,
    };

    var req_saved   : Request;
    var last_device : Device ;
    var is_requested: logic  ;

    // すべてのデバイスへの要求を解除する (reset_membus_masterの代わり)
    function reset_all_device_masters () {
        ram_membus <> 0;
        rom_membus <> 0;
        dbg_membus <> 0;
    }

    // アドレスからデバイスを取得する
    function get_device (
        addr: input Addr,
    ) -> Device {
        if DBG_ADDR <= addr && addr <= DBG_ADDR + 7 {
            return Device::DEBUG;
        }
        if MMAP_ROM_BEGIN <= addr && addr <= MMAP_ROM_END {
            return Device::ROM;
        }
        if addr >= MMAP_RAM_BEGIN {
            return Device::RAM;
        }
        return Device::UNKNOWN;
    }

    // デバイスのmasterにreqの情報を割り当てる
    function assign_device_master (
        req: input Request,
    ) {
        case get_device(req.addr) {
            Device::RAM: {
                ram_membus.valid = req.valid;
                ram_membus.addr  = req.addr - MMAP_RAM_BEGIN;
                ram_membus.wen   = req.wen;
                ram_membus.wdata = req.wdata;
                ram_membus.wmask = req.wmask;
            }
            Device::ROM: {
                rom_membus.valid = req.valid;
                rom_membus.addr  = req.addr - MMAP_ROM_BEGIN;
                rom_membus.wen   = req.wen;
                rom_membus.wdata = req.wdata;
                rom_membus.wmask = req.wmask;
            }
            Device::DEBUG: {
                dbg_membus.valid = req.valid;
                dbg_membus.addr  = req.addr - DBG_ADDR;
                dbg_membus.wen   = req.wen;
                dbg_membus.wdata = req.wdata;
                dbg_membus.wmask = req.wmask;
            }
            default: {}
        }
    }

    // デバイスの応答をreq_coreへ割り当てる
    function assign_device_slave (
        device: input Device,
    ) {
        // UNKNOWNへのアクセスは即座に0を返す
        req_core.rvalid = 1;
        req_core.rdata  = 0;

        case device {
            Device::RAM: {
                req_core.rvalid = ram_membus.rvalid;
                req_core.rdata  = ram_membus.rdata;
            }
            Device::ROM: {
                req_core.rvalid = rom_membus.rvalid;
                req_core.rdata  = rom_membus.rdata;
            }
            Device::DEBUG: {
                req_core.rvalid = dbg_membus.rvalid;
                req_core.rdata  = dbg_membus.rdata;
            }
            default: {}
        }
    }

    // デバイスが要求を受理できるか
    function get_device_ready (
        device: input Device,
    ) -> logic {
        case device {
            Device::RAM  : return ram_membus.ready;
            Device::ROM  : return rom_membus.ready;
            Device::DEBUG: return dbg_membus.ready;
            default      : {}
        }

        return 1;
    }

    // デバイスから応答が返っているか
    function get_device_rvalid (
        device: input Device,
    ) -> logic {
        case device {
            Device::RAM  : return ram_membus.rvalid;
            Device::ROM  : return rom_membus.rvalid;
            Device::DEBUG: return dbg_membus.rvalid;
            default      : {}
        }

        return 1;
    }

    // req_coreの割り当て
    always_comb {
        req_core.ready  = 0;
        req_core.rvalid = 0;
        req_core.rdata  = 0;

        if req_saved.valid {
            if is_requested {
                // 結果を返す
                assign_device_slave(last_device);
                req_core.ready = get_device_rvalid(last_device);
            }
        } else {
            req_core.ready = 1;
        }
    }

    // デバイスのmasterの割り当て
    always_comb {
        reset_all_device_masters();

        if req_saved.valid {
            if is_requested {
                if get_device_rvalid(last_device) {
                    // 新しく要求を受け入れる
                    if req_core.ready && req_core.valid {
                        assign_device_master(core_req);
                    }
                }
            } else {
                // デバイスにreq_savedを割り当てる
                assign_device_master(req_saved);
            }
        } else {
            // 新しく要求を受け入れる
            if req_core.ready && req_core.valid {
                assign_device_master(core_req);
            }
        }
    }

    // 新しく要求を受け入れる
    function accept_request () {
        req_saved.valid = req_core.ready && req_core.valid;
        if req_core.ready && req_core.valid {
            last_device  = get_device(req_core.addr);
            is_requested = get_device_ready(last_device);
            // reqを保存
            req_saved.addr  = req_core.addr;
            req_saved.wen   = req_core.wen;
            req_saved.wdata = req_core.wdata;
            req_saved.wmask = req_core.wmask;
        }
    }

    function on_clock () {
        if req_saved.valid {
            if is_requested {
                if get_device_rvalid(last_device) {
                    accept_request();
                }
            } else {
                is_requested = get_device_ready(last_device);
            }
        } else {
            accept_request();
        }
    }

    function on_reset () {
        last_device  = Device::UNKNOWN;
        is_requested = 0;
        req_saved    = 0;
    }

    always_ff {
        if_reset {
            on_reset();
        } else {
            on_clock();
        }
    }
}
