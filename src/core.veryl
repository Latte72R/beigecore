import eei::*;
import corectrl::*;

module core (
    clk     : input   clock               ,
    rst     : input   reset               ,
    i_membus: modport core_inst_if::master,
    d_membus: modport core_data_if::master,
    led     : output  UIntX               ,
    aclint  : modport aclint_if::slave    ,
) {
    struct exq_type {
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        pred_taken : logic        ,
        pred_target: Addr         ,
        rs1_preg   : PhysReg      ,
        rs2_preg   : PhysReg      ,
        rd_preg    : PhysReg      ,
        rd_old_preg: PhysReg      ,
    }

    struct euq_type {
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        pred_taken : logic        ,
        pred_target: Addr         ,
        rs1_preg   : PhysReg      ,
        rs2_preg   : PhysReg      ,
        rd_preg    : PhysReg      ,
        old_preg   : PhysReg      ,
        rob_tag    : RobTag       ,
    }

    struct memq_type {
        rob_tag    : RobTag       ,
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        alu_result : UIntX        ,
        rs1_areg   : ArchReg      ,
        rs1_data   : UIntX        ,
        rs2_data   : UIntX        ,
        br_taken   : logic        ,
        jump_addr  : Addr         ,
        pred_taken : logic        ,
        pred_target: Addr         ,
    }

    struct rob_entry_type {
        addr      : Addr         ,
        bits      : Inst         ,
        ctrl      : InstCtrl     ,
        rd_areg   : ArchReg      ,
        old_preg  : PhysReg      ,
        result    : UIntX        ,
        expt      : ExceptionInfo,
        raise_trap: logic        ,
    }

    // ID -> EXのFIFO
    var exq_wready: logic   ;
    var exq_wvalid: logic   ;
    var exq_wdata : exq_type;
    var exq_rready: logic   ;
    var exq_rvalid: logic   ;
    var exq_rdata : exq_type;

    // EX -> MEMのFIFO
    // var memq_wready: logic    ;
    // var memq_wvalid: logic;
    // var memq_wdata : memq_type;
    // var memq_rready: logic    ;
    // var memq_rvalid: logic;
    // var memq_rdata : memq_type;

    // (EX, MEM) -> WB の Reorder Buffer
    var rob_allocate_valid: logic         ;
    var rob_allocate_ready: logic         ;
    var rob_allocate_done : logic         ;
    var rob_allocate_data : rob_entry_type;
    var rob_allocate_tag  : RobTag        ;

    var rob_complete_valid: logic         ;
    var rob_complete_tag  : RobTag        ;
    var rob_complete_data : rob_entry_type;

    var rob_commit_valid: logic         ;
    var rob_commit_ready: logic         ;
    var rob_commit_data : rob_entry_type;

    var rob_head_valid: logic ;
    var rob_head_tag  : RobTag;

    var rob_query1_tag : RobTag        ;
    var rob_query1_done: logic         ;
    var rob_query1_data: rob_entry_type;
    var rob_query2_tag : RobTag        ;
    var rob_query2_done: logic         ;
    var rob_query2_data: rob_entry_type;

    ///////////////////////////////// IF Stage /////////////////////////////////

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;

    var exs_is_jalr      : logic;
    var exs_actual_target: Addr ;

    var prediction_redirect: logic;
    var ids_imm            : UIntX;
    var ids_pred_target    : Addr ;

    let frontend_redirect: logic = control_hazard || prediction_redirect;
    always_comb {
        i_membus.is_redirect = frontend_redirect;

        if control_hazard {
            i_membus.next_pc = control_hazard_pc_next;
        } else {
            i_membus.next_pc = ids_pred_target;
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_valid     = i_membus.rvalid;
    let ids_inst_bits = i_membus.rdata;

    let ids_fire      : logic    = !control_hazard && i_membus.rvalid && i_membus.rready;
    var ids_inst_valid: logic   ;
    var ids_ctrl      : InstCtrl;

    var bimodal_pred_taken: logic;
    var bimodal_pred_valid: logic;

    let ids_btfnt_taken      : logic = ids_imm[msb]; // 負のoffsetならbackward
    let ids_branch_pred_taken: logic = if bimodal_pred_valid ? bimodal_pred_taken : ids_btfnt_taken;

    var btb_hit   : logic;
    var btb_target: Addr ;

    let ids_is_jal : logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::J;
    let ids_is_jalr: logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::I;

    let ids_pred_taken: logic = ids_inst_valid
        && (ids_is_jal || (ids_is_jalr && btb_hit) || (inst_is_br(ids_ctrl) && ids_branch_pred_taken));

    let ids_pc: Addr = i_membus.raddr;
    always_comb {
        prediction_redirect = !control_hazard && ids_fire && ids_pred_taken;
        ids_pred_target     = if ids_is_jalr ? btb_target : ids_pc + ids_imm;
    }

    inst decoder: inst_decoder (
        bits  : ids_inst_bits  ,
        is_rvc: i_membus.is_rvc,
        valid : ids_inst_valid ,
        ctrl  : ids_ctrl       ,
        imm   : ids_imm        ,
    );

    let ids_rd_areg   : ArchReg = ids_inst_bits[11:7];
    let ids_rs1_areg  : ArchReg = ids_inst_bits[19:15];
    let ids_rs2_areg  : ArchReg = ids_inst_bits[24:20];
    let ids_need_alloc: logic   = ids_fire && ids_ctrl.rwb_en && ids_rd_areg != 0;

    var flist_rready: logic  ;
    var flist_rvalid: logic  ;
    var flist_rdata : PhysReg;
    var flist_wready: logic  ;
    var flist_wvalid: logic  ;
    var flist_wdata : PhysReg;

    var rat_read1_data : PhysReg;
    var rat_read2_data : PhysReg;
    var rat_read1_addr : ArchReg;
    var rat_read2_addr : ArchReg;
    var rat_write_old  : PhysReg;
    var rat_write_valid: logic  ;
    var rat_write_addr : ArchReg;
    var rat_write_data : PhysReg;

    var rat_flush: logic;

    let ids_new_preg: PhysReg = flist_rdata;
    let ids_old_preg: PhysReg = rat_write_old;

    always_comb {
        flist_rready    = ids_need_alloc;
        rat_read1_addr  = ids_rs1_areg;
        rat_read2_addr  = ids_rs2_areg;
        rat_write_valid = ids_need_alloc;
        rat_write_addr  = ids_rd_areg;
        rat_write_data  = ids_new_preg;
        rat_flush       = control_hazard;
    }

    var csru_priv_mode: PrivMode;

    var alu_read1_addr : PhysReg;
    var alu_read1_data : UIntX  ;
    var alu_read2_addr : PhysReg;
    var alu_read2_data : UIntX  ;
    var memu_read1_addr: PhysReg;
    var memu_read1_data: UIntX  ;
    var memu_read2_addr: PhysReg;
    var memu_read2_data: UIntX  ;
    var mdu_read1_addr : PhysReg;
    var mdu_read1_data : UIntX  ;
    var mdu_read2_addr : PhysReg;
    var mdu_read2_data : UIntX  ;

    var alu_write_valid : logic  ;
    var alu_write_addr  : PhysReg;
    var alu_write_data  : UIntX  ;
    var memu_write_valid: logic  ;
    var memu_write_addr : PhysReg;
    var memu_write_data : UIntX  ;
    var mdu_write_valid : logic  ;
    var mdu_write_addr  : PhysReg;
    var mdu_write_data  : UIntX  ;
    var csr_write_valid : logic  ;
    var csr_write_addr  : PhysReg;
    var csr_write_data  : UIntX  ;

    var aluq_wready: logic   ;
    var aluq_wvalid: logic   ;
    var aluq_rready: logic   ;
    var aluq_rvalid: logic   ;
    var aluq_wdata : euq_type;
    var aluq_rdata : euq_type;

    var memq_wready: logic   ;
    var memq_wvalid: logic   ;
    var memq_rready: logic   ;
    var memq_rvalid: logic   ;
    var memq_wdata : euq_type;
    var memq_rdata : euq_type;

    var muldivq_wready: logic   ;
    var muldivq_wvalid: logic   ;
    var muldivq_rready: logic   ;
    var muldivq_rvalid: logic   ;
    var muldivq_wdata : euq_type;
    var muldivq_rdata : euq_type;

    var csrq_wready: logic   ;
    var csrq_wvalid: logic   ;
    var csrq_rready: logic   ;
    var csrq_rvalid: logic   ;
    var csrq_wdata : euq_type;
    var csrq_rdata : euq_type;

    // dispatch: 命令種別に応じて該当キューに格納
    let ids_is_alu   : logic = !inst_is_memop(ids_ctrl) && !ids_ctrl.is_muldiv && !ids_ctrl.is_csr;
    let ids_is_load  : logic = ids_ctrl.is_load;
    let ids_is_store : logic = inst_is_store(ids_ctrl);
    let ids_is_muldiv: logic = ids_ctrl.is_muldiv;
    let ids_is_csr   : logic = ids_ctrl.is_csr;

    var dispatch_data: euq_type;

    // 未解決の直列化命令がROB/MEM内にある
    var serial_pending: logic;

    always_comb {
        // ID rready: 該当キューが空き + ROB 空き
        let ids_target_ready: logic = switch {
            ids_is_alu   : aluq_wready,
            ids_is_load  : memq_wready,
            ids_is_store : memq_wready,
            ids_is_muldiv: muldivq_wready,
            ids_is_csr   : csrq_wready,
            default      : 1,
        };
        i_membus.rready = rob_allocate_ready && ids_target_ready;

        // exception
        exq_wdata.expt = 0;
        if !ids_inst_valid {
            // illegal instruction
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            exq_wdata.expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            exq_wdata.expt.valid      = 1;
            exq_wdata.expt.cause      = CsrCause::ENVIRONMENT_CALL_FROM_U_MODE;
            exq_wdata.expt.cause[1:0] = csru_priv_mode; // adjust mode
            exq_wdata.expt.value      = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::BREAKPOINT;
            exq_wdata.expt.value = ids_pc;
        }

        // 該当キューの wvalid / wdata を駆動
        aluq_wvalid    = ids_fire && ids_is_alu && aluq_wready;
        memq_wvalid    = ids_fire && (ids_is_load || ids_is_store) && memq_wready;
        muldivq_wvalid = ids_fire && ids_is_muldiv && muldivq_wready;
        csrq_wvalid    = ids_fire && ids_is_csr && csrq_wready;

        // dispatch_data を組み立て
        dispatch_data.addr        = ids_pc;
        dispatch_data.bits        = ids_inst_bits;
        dispatch_data.ctrl        = ids_ctrl;
        dispatch_data.imm         = ids_imm;
        dispatch_data.expt        = exq_wdata.expt; // 既存の例外検出ロジックの結果
        dispatch_data.rs1_preg    = rat_read1_data;
        dispatch_data.rs2_preg    = rat_read2_data;
        dispatch_data.rd_preg     = ids_new_preg;
        dispatch_data.old_preg    = ids_old_preg;
        dispatch_data.rob_tag     = rob_allocate_tag;
        dispatch_data.pred_taken  = ids_pred_taken;
        dispatch_data.pred_target = ids_pred_target;

        // dispatch_data を代入
        aluq_wdata    = dispatch_data;
        memq_wdata    = dispatch_data;
        muldivq_wdata = dispatch_data;
        csrq_wdata    = dispatch_data;

        // === ROB allocate (dispatch 時) ===
        rob_allocate_valid           = ids_fire;
        rob_allocate_done            = 0;
        rob_allocate_data.addr       = ids_pc;
        rob_allocate_data.bits       = ids_inst_bits;
        rob_allocate_data.ctrl       = ids_ctrl;
        rob_allocate_data.rd_areg    = ids_rd_areg;
        rob_allocate_data.old_preg   = ids_old_preg;
        rob_allocate_data.result     = 0; // 後で complete 時に上書き
        rob_allocate_data.expt       = exq_wdata.expt;
        rob_allocate_data.raise_trap = 0;
    }

    always_comb {
        // ID -> EX
        // i_membus.rready = exq_wready;
        // exq_wvalid = i_membus.rvalid;
        exq_wvalid = 0;

        // exq_wdata.addr = i_membus.raddr;
        // exq_wdata.bits = i_membus.rdata;
        // exq_wdata.ctrl = ids_ctrl;
        // exq_wdata.imm  = ids_imm;

        // exq_wdata.pred_taken  = ids_pred_taken;
        // exq_wdata.pred_target = ids_pred_target;

        // exq_wdata.rs1_preg    = rat_read1_data;
        // exq_wdata.rs2_preg    = rat_read2_data;
        // exq_wdata.rd_preg     = ids_new_preg;
        // exq_wdata.rd_old_preg = ids_old_preg;
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    always_comb {
        alu_read1_addr  = aluq_rdata.rs1_preg;
        alu_read2_addr  = aluq_rdata.rs2_preg;
        memu_read1_addr = memq_rdata.rs1_preg;
        memu_read2_addr = memq_rdata.rs2_preg;
        mdu_read1_addr  = muldivq_rdata.rs1_preg;
        mdu_read2_addr  = muldivq_rdata.rs2_preg;
    }

    let exs_valid    : logic    = exq_rvalid;
    let exs_pc       : Addr     = exq_rdata.addr;
    let exs_inst_bits: Inst     = exq_rdata.bits;
    let exs_ctrl     : InstCtrl = exq_rdata.ctrl;
    let exs_imm      : UIntX    = exq_rdata.imm;

    // レジスタ
    var regfile: UIntX<AREG_COUNT>;

    // 各レジスタを最後に書く予定のROBエントリ
    var producer_valid: logic  [AREG_COUNT];
    var producer_tag  : RobTag [AREG_COUNT];

    // レジスタ番号
    let exs_rs1_areg: ArchReg = exs_inst_bits[19:15];
    let exs_rs2_areg: ArchReg = exs_inst_bits[24:20];

    // データハザード
    let exs_uses_rs1: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::I: if exs_ctrl.is_csr ? exs_ctrl.funct3[1:0] != 0 && !exs_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_uses_rs2: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_rs1_has_producer: logic = exs_uses_rs1 && exs_rs1_areg != 0 && producer_valid[exs_rs1_areg];
    let exs_rs2_has_producer: logic = exs_uses_rs2 && exs_rs2_areg != 0 && producer_valid[exs_rs2_areg];
    let exs_rs1_data_hazard : logic = exs_valid && exs_rs1_has_producer && !rob_query1_done;
    let exs_rs2_data_hazard : logic = exs_valid && exs_rs2_has_producer && !rob_query2_done;
    let exs_data_hazard     : logic = exs_rs1_data_hazard || exs_rs2_data_hazard;

    // ソースレジスタのデータ
    let exs_rs1_data: UIntX = switch {
        exs_rs1_areg == 0                      : 0,
        exs_rs1_has_producer && rob_query1_done: rob_query1_data.result,
        default                                : regfile[exs_rs1_areg],
    };
    let exs_rs2_data: UIntX = switch {
        exs_rs2_areg == 0                      : 0,
        exs_rs2_has_producer && rob_query2_done: rob_query2_data.result,
        default                                : regfile[exs_rs2_areg],
    };

    // ALU
    var exs_op1       : UIntX;
    var exs_op2       : UIntX;
    var exs_alu_result: UIntX;
    let exs_add_result: UIntX = exs_op1 + exs_op2;

    // always_comb {
    //     case exs_ctrl.itype {
    //         InstType::R, InstType::B: {
    //             exs_op1 = exs_rs1_data;
    //             exs_op2 = exs_rs2_data;
    //         }
    //         InstType::I, InstType::S: {
    //             exs_op1 = exs_rs1_data;
    //             exs_op2 = exs_imm;
    //         }
    //         InstType::U, InstType::J: {
    //             exs_op1 = exs_pc;
    //             exs_op2 = exs_imm;
    //         }
    //         default: {
    //             exs_op1 = 'x;
    //             exs_op2 = 'x;
    //         }
    //     }
    // }

    var aluq_op1: UIntX;
    var aluq_op2: UIntX;

    always_comb {
        let rs1_areg: ArchReg = aluq_rdata.bits[19:15];
        let rs2_areg: ArchReg = aluq_rdata.bits[24:20];

        case aluq_rdata.ctrl.itype {
            InstType::R, InstType::B: {
                // R-type (add, sub, and, ...) / B-type (branch)
                aluq_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                aluq_op2 = if rs2_areg == 0 ? 0 : alu_read2_data;
            }
            InstType::I, InstType::S: {
                // I-type (addi, load, store, JALR, CSR) / S-type
                aluq_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                aluq_op2 = aluq_rdata.imm;
            }
            InstType::U, InstType::J: {
                // U-type (LUI, AUIPC) / J-type (JAL)
                // op1 = PC, op2 = immediate
                aluq_op1 = aluq_rdata.addr;
                aluq_op2 = aluq_rdata.imm;
            }
            default: {
                aluq_op1 = 0;
                aluq_op2 = 0;
            }
        }
    }

    // inst alum: alu (
    //     ctrl  : exs_ctrl      ,
    //     op1   : exs_op1       ,
    //     op2   : exs_op2       ,
    //     result: exs_alu_result,
    // );

    var aluq_result: UIntX;
    inst aluq_alu: alu (
        ctrl  : aluq_rdata.ctrl,
        op1   : aluq_op1       ,
        op2   : aluq_op2       ,
        result: aluq_result    ,
    );

    var exs_muldiv_is_requested: logic;
    let exs_muldiv_valid       : logic = exs_valid && exs_ctrl.is_muldiv && !exs_data_hazard
        && !exs_muldiv_is_requested;
    var exs_muldiv_ready       : logic;
    var exs_muldiv_rvalid      : logic;
    var exs_muldiv_result      : UIntX;

    inst mdu: muldivunit (
        clk                       ,
        rst                       ,
        valid  : exs_muldiv_valid ,
        ready  : exs_muldiv_ready ,
        funct3 : exs_ctrl.funct3  ,
        is_op32: exs_ctrl.is_op32 ,
        op1    : exs_op1          ,
        op2    : exs_op2          ,
        rvalid : exs_muldiv_rvalid,
        result : exs_muldiv_result,
    );

    always_ff {
        if_reset {
            exs_muldiv_is_requested = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_is_requested = 0;
            } else {
                // muldivunitにリクエストしたか判定する
                if exs_muldiv_valid && exs_muldiv_ready {
                    exs_muldiv_is_requested = 1;
                }
            }
        }
    }

    var exs_muldiv_rvalided: logic;
    let exs_muldiv_stall   : logic = exs_ctrl.is_muldiv && !(exs_muldiv_rvalid && exs_muldiv_is_requested)
        && !exs_muldiv_rvalided;

    always_ff {
        if_reset {
            exs_muldiv_rvalided = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_rvalided = 0;
            } else if exs_muldiv_is_requested {
                // muldivunitの処理が完了していたら1にする
                exs_muldiv_rvalided |= exs_muldiv_rvalid;
            }
        }
    }

    var exs_brunit_take: logic;
    // inst bru: brunit (
    //     funct3: exs_ctrl.funct3,
    //     op1   : exs_op1        ,
    //     op2   : exs_op2        ,
    //     take  : exs_brunit_take,
    // );

    let exs_stall    : logic = exs_data_hazard || exs_muldiv_stall;
    let exs_needs_mem: logic = inst_is_memop(exs_ctrl) || exs_ctrl.is_csr || exs_ctrl.is_jump || inst_is_br(exs_ctrl)
        || exq_rdata.expt.valid;

    let aluq_is_br  : logic = inst_is_br(aluq_rdata.ctrl);
    let aluq_is_jalr: logic = aluq_rdata.ctrl.is_jump && aluq_rdata.ctrl.itype == InstType::I;
    let aluq_is_jal : logic = aluq_rdata.ctrl.is_jump && aluq_rdata.ctrl.itype == InstType::J;

    var aluq_br_take: logic;
    inst aluq_bru: brunit (
        funct3: aluq_rdata.ctrl.funct3,
        op1   : aluq_op1              ,
        op2   : aluq_op2              ,
        take  : aluq_br_take          ,
    );

    let aluq_actual_target: Addr  = if aluq_is_jalr ? (aluq_result & ~1) : (aluq_rdata.addr + aluq_rdata.imm);
    let aluq_mispredict   : logic = aluq_rvalid
        && ((aluq_is_br && aluq_rdata.pred_taken != aluq_br_take)
            || (aluq_is_jalr && (aluq_rdata.pred_taken != 1 || aluq_rdata.pred_target != (aluq_result & ~1))));

    let aluq_writes_rd: logic = aluq_rvalid && aluq_rdata.ctrl.rwb_en && aluq_rdata.bits[11:7] != 0;

    var aluq_complete: logic;

    always_comb {
        // rob_allocate_done          = !exs_needs_mem;
        // rob_allocate_data.addr     = exq_rdata.addr;
        // rob_allocate_data.bits     = exq_rdata.bits;
        // rob_allocate_data.ctrl     = exq_rdata.ctrl;
        // rob_allocate_data.rd_areg  = exq_rdata.bits[11:7];
        // rob_allocate_data.old_preg = exq_rdata.rd_old_preg;
        // rob_allocate_data.result   = switch {
        //     exs_ctrl.is_lui   : exq_rdata.imm,
        //     exs_ctrl.is_muldiv: exs_muldiv_result,
        //     default           : exs_alu_result,
        // };

        // rob_allocate_data.expt       = memq_wdata.expt;
        // rob_allocate_data.raise_trap = 0;

        alu_write_valid = aluq_writes_rd && aluq_rready;
        alu_write_addr  = aluq_rdata.rd_preg;
        alu_write_data  = if aluq_rdata.ctrl.is_lui ? aluq_rdata.imm : aluq_result;

        rob_query1_tag = producer_tag[exs_rs1_areg];
        rob_query2_tag = producer_tag[exs_rs2_areg];

        aluq_complete = aluq_rvalid && aluq_rready;
    }

    var csru_rdata      : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;
    var csru_trap_return: logic;

    // 命令が進む経路に空きがあるか
    let exs_route_ready: logic = !exs_needs_mem || memq_wready;
    // EX段の命令がROBへ実際に登録された
    let rob_allocate_fire: logic = rob_allocate_valid && rob_allocate_ready;
    // ROBに登録された命令が直列化命令（後続命令を確定できない命令）かどうか
    // 分岐予測の確認はMEM段で行うため，解決前の若い命令をROBへ登録しない
    let exs_is_serializing: logic = exs_ctrl.is_jump || inst_is_br(exs_ctrl) || exs_ctrl.is_csr
        || memq_wdata.expt.valid;
    // ROBに登録された命令が直列化命令の場合，次の命令のROB登録を待つ
    // let serial_allocate: logic = rob_allocate_fire && exs_is_serializing;

    let producer_allocate: logic = rob_allocate_fire && rob_allocate_data.ctrl.rwb_en && rob_allocate_data.rd_areg != 0;

    // always_comb {
    //     // EX -> MEM
    //     // 予測の確認
    //     exs_is_jalr       = exs_ctrl.is_jump && exs_ctrl.itype == InstType::I;
    //     exs_actual_target = exs_add_result & ~1;

    //     // ROBだけallocationされたり MEM FIFOだけ書き込まれたりするのを防ぐ
    //     // rob_allocate_valid = exq_rvalid && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
    //     exq_rready = rob_allocate_ready && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
    //     memq_wvalid = rob_allocate_fire && exs_needs_mem;

    //     memq_wdata.addr = exq_rdata.addr;
    //     memq_wdata.bits = exq_rdata.bits;
    //     memq_wdata.ctrl = exq_rdata.ctrl;
    //     memq_wdata.imm  = exq_rdata.imm;

    //     memq_wdata.rs1_areg = exs_rs1_areg;
    //     memq_wdata.rs1_data = exs_rs1_data;
    //     memq_wdata.rs2_data = exs_rs2_data;
    //     // MEMへ進む命令で必要なALU結果はロード/ストアのアドレスだけ
    //     // 汎用ALUのシフタ等をMEM FIFOの入力へ接続しない
    //     memq_wdata.alu_result = exs_add_result;
    //     memq_wdata.br_taken   = exs_ctrl.is_jump || inst_is_br(exs_ctrl) && exs_brunit_take;
    //     memq_wdata.jump_addr  = if inst_is_br(exs_ctrl) ? exs_pc + exs_imm : exs_add_result & ~1;
    //     memq_wdata.rob_tag    = rob_allocate_tag;

    //     memq_wdata.pred_taken  = exq_rdata.pred_taken;
    //     memq_wdata.pred_target = exq_rdata.pred_target;

    //     // exception
    //     let instruction_address_misaligned: logic = IALIGN == 32 && memq_wdata.br_taken && memq_wdata.jump_addr[1:0]
    //         != 2'b00;
    //     let memaddr                       : Addr  = if exs_ctrl.is_amo ? exs_rs1_data : exs_add_result;
    //     let loadstore_address_misaligned  : logic = inst_is_memop(exs_ctrl)
    //         && case exs_ctrl.funct3[1:0] {
    //             2'b00  : 1'b0, // B
    //             2'b01  : memaddr[0] != 1'b0, // H
    //             2'b10  : memaddr[1:0] != 2'b0, // W
    //             2'b11  : memaddr[2:0] != 3'b0, // D
    //             default: 1'b0,
    //         };
    //     memq_wdata.expt = exq_rdata.expt;
    //     if !memq_wdata.expt.valid {
    //         if instruction_address_misaligned {
    //             memq_wdata.expt.valid = 1;
    //             memq_wdata.expt.cause = CsrCause::INSTRUCTION_ADDRESS_MISALIGNED;
    //             memq_wdata.expt.value = memq_wdata.jump_addr;
    //         } else if loadstore_address_misaligned {
    //             memq_wdata.expt.valid = 1;
    //             memq_wdata.expt.cause = if exs_ctrl.is_load ?
    //                 CsrCause::LOAD_ADDRESS_MISALIGNED
    //             :
    //                 CsrCause::STORE_AMO_ADDRESS_MISALIGNED
    //             ;
    //             memq_wdata.expt.value = memaddr;
    //         }
    //     }
    // }

    ///////////////////////////////// MEM Stage /////////////////////////////////

    let mems_valid    : logic         = memq_rvalid;
    let mems_pc       : Addr          = memq_rdata.addr;
    let mems_inst_bits: Inst          = memq_rdata.bits;
    let mems_ctrl     : InstCtrl      = memq_rdata.ctrl;
    let mems_expt     : ExceptionInfo = memq_rdata.expt;
    let mems_rd_areg  : ArchReg       = mems_inst_bits[11:7];

    // let mems_is_jalr              : logic = mems_ctrl.is_jump && mems_ctrl.itype == InstType::I;
    // let mems_is_branch            : logic = inst_is_br(mems_ctrl);
    // let mems_branch_mispredict    : logic = mems_is_branch && memq_rdata.pred_taken != memq_rdata.br_taken;
    // let mems_jalr_mispredict      : logic = mems_is_jalr
    //     && (!memq_rdata.pred_taken || memq_rdata.pred_target != memq_rdata.jump_addr);
    // let mems_prediction_mispredict: logic = mems_valid && (mems_branch_mispredict || mems_jalr_mispredict);
    // let mems_recovery_pc: Addr = if memq_rdata.br_taken ?
    //     memq_rdata.jump_addr
    // :
    //     mems_pc + (if mems_ctrl.is_rvc ? 2 : 4)
    // ;

    let mems_is_store   : logic = inst_is_store(mems_ctrl);
    let mems_at_rob_head: logic = rob_head_valid && rob_head_tag == memq_rdata.rob_tag;

    // 命令が直列化命令（後続命令を確定できない命令）かどうか
    let mems_is_serializing: logic = mems_ctrl.is_jump || inst_is_br(mems_ctrl) || mems_ctrl.is_csr || mems_expt.valid;

    // Storeまたは直列化命令ならROB先頭の場合だけ実行してよい
    let mems_requires_head: logic = mems_is_store || mems_ctrl.is_amo || mems_ctrl.is_csr || mems_expt.valid;
    let mems_can_execute  : logic = !mems_requires_head || mems_at_rob_head;

    // let serial_complete: logic = rob_complete_valid && mems_is_serializing;

    // always_ff {
    //     if_reset {
    //         serial_pending = 0;
    //     } else {
    //         if serial_complete {
    //             serial_pending = 0;
    //         } else if serial_allocate {
    //             serial_pending = 1;
    //         }
    //     }
    // }

    var memu_rdata: UIntX;
    var memu_stall: logic;
    // let memu_addr : Addr  = if mems_ctrl.is_amo ? memq_rdata.rs1_data : memq_rdata.alu_result;

    var minstret: UInt64;

    // ROB先頭命令の最初のサイクルでだけ受け付ける
    var mems_intr_checked: logic;
    let mems_can_intr    : logic = mems_valid && mems_at_rob_head && !mems_intr_checked;

    always_ff {
        if_reset {
            mems_intr_checked = 0;
        } else if !mems_valid || memq_rready {
            // 空または現在の命令をMEMから取り出した
            mems_intr_checked = 0;
        } else if mems_at_rob_head {
            mems_intr_checked = 1;
        }
    }

    // inst memu: memunit (
    //     clk                                                       ,
    //     rst                                                       ,
    //     valid : mems_valid && mems_can_execute && !csru_raise_trap,
    //     ctrl  : mems_ctrl                                         ,
    //     addr  : memu_addr                                         ,
    //     rs2   : memq_rdata.rs2_data                               ,
    //     rdata : memu_rdata                                        ,
    //     stall : memu_stall                                        ,
    //     membus: d_membus                                          ,
    // );

    let memq_at_head: logic = memq_rvalid && rob_head_valid && rob_head_tag == memq_rdata.rob_tag;
    let memq_done   : logic = memq_at_head && !memu_stall;

    // CSR execution
    let csrq_at_head: logic = csrq_rvalid && rob_head_valid && rob_head_tag == csrq_rdata.rob_tag;
    let csrq_result : UIntX = 0;

    inst memu: memunit (
        clk   : clk                             ,
        rst   : rst                             ,
        valid : memq_rvalid && memq_at_head, // ← 実行中ずっと 1
        ctrl  : memq_rdata.ctrl                 ,
        addr  : memu_read1_data + memq_rdata.imm,
        rs2   : memu_read2_data                 ,
        rdata : memu_rdata                      ,
        stall : memu_stall                      ,
        membus: d_membus                        ,
    );

    // inst csru: csrunit (
    //     clk                                        ,
    //     rst                                        ,
    //     valid      : mems_valid && mems_can_execute,
    //     pc         : mems_pc                       ,
    //     inst_bits  : mems_inst_bits                ,
    //     ctrl       : mems_ctrl                     ,
    //     expt_info  : mems_expt                     ,
    //     rd_areg    : mems_rd_areg                  ,
    //     csr_addr   : mems_inst_bits[31:20]         ,
    //     rs1_areg   : csrq_rdata.rs1_areg           ,
    //     rs1_data   : csrq_rdata.rs1_data           ,
    //     can_intr   : mems_can_intr                 ,
    //     rdata      : csru_rdata                    ,
    //     mode       : csru_priv_mode                ,
    //     raise_trap : csru_raise_trap               ,
    //     trap_vector: csru_trap_vector              ,
    //     trap_return: csru_trap_return              ,
    //     minstret                                   ,
    //     led                                        ,
    //     aclint                                     ,
    // );

    // Completion arbitration: MEM > CSR > ALU
    let memq_grant: logic = memq_done;
    let csrq_grant: logic = csrq_at_head && !memq_done;
    let aluq_grant: logic = aluq_rvalid && !memq_done && !csrq_at_head;

    always_comb {
        // MEM -> WB
        aluq_rready = aluq_grant;
        memq_rready = memq_grant;
        csrq_rready = csrq_grant;

        rob_complete_valid = aluq_grant || memq_grant || csrq_grant;
        rob_complete_tag   = switch {
            aluq_grant: aluq_rdata.rob_tag,
            memq_grant: memq_rdata.rob_tag,
            csrq_grant: csrq_rdata.rob_tag,
            default   : 0
        };
        rob_complete_data.addr = switch {
            aluq_grant: aluq_rdata.addr,
            memq_grant: memq_rdata.addr,
            csrq_grant: csrq_rdata.addr,
            default   : 0
        };
        rob_complete_data.bits = switch {
            aluq_grant: aluq_rdata.bits,
            memq_grant: memq_rdata.bits,
            csrq_grant: csrq_rdata.bits,
            default   : 0
        };
        rob_complete_data.ctrl = switch {
            aluq_grant: aluq_rdata.ctrl,
            memq_grant: memq_rdata.ctrl,
            csrq_grant: csrq_rdata.ctrl,
            default   : 0
        };
        rob_complete_data.rd_areg = switch {
            aluq_grant: aluq_rdata.bits[11:7],
            memq_grant: memq_rdata.bits[11:7],
            csrq_grant: csrq_rdata.bits[11:7],
            default   : 0
        };
        rob_complete_data.old_preg = switch {
            aluq_grant: aluq_rdata.old_preg,
            memq_grant: memq_rdata.old_preg,
            csrq_grant: csrq_rdata.old_preg,
            default   : 0
        };
        rob_complete_data.result = switch {
            aluq_grant: aluq_result,
            memq_grant: memu_rdata,
            csrq_grant: csrq_result,
            default   : 0,
        };
        rob_complete_data.expt = switch {
            aluq_grant: aluq_rdata.expt,
            memq_grant: memq_rdata.expt,
            csrq_grant: csrq_rdata.expt,
            default   : 0,
        };
        rob_complete_data.raise_trap = 0;

        memu_write_valid = memq_done && memq_rdata.ctrl.is_load;
        memu_write_addr  = memq_rdata.rd_preg;
        memu_write_data  = memu_rdata;

        csr_write_valid = csrq_grant && csrq_rdata.ctrl.rwb_en && csrq_rdata.bits[11:7] != 0;
        csr_write_addr  = csrq_rdata.rd_preg;
        csr_write_data  = csrq_result;
    }

    always_comb {
        control_hazard   = aluq_complete && aluq_mispredict;
        let aluq_recovery_pc: Addr = switch {
            aluq_is_jalr: (aluq_result & ~1),
            aluq_br_take: (aluq_rdata.addr + aluq_rdata.imm),
            default     : (aluq_rdata.addr + (if aluq_rdata.ctrl.is_rvc ? 2 : 4))
        };
        control_hazard_pc_next = if aluq_mispredict ? aluq_recovery_pc : csru_trap_vector;
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    let wbs_valid  : logic    = rob_commit_valid;
    let wbs_ctrl   : InstCtrl = rob_commit_data.ctrl;
    let wbs_rd_areg: ArchReg  = rob_commit_data.rd_areg;
    let wbs_wb_data: UIntX    = rob_commit_data.result;

    always_ff {
        if_reset {
            minstret = 0;
        } else {
            if rob_commit_valid && rob_commit_ready && !rob_commit_data.raise_trap {
                minstret += 1;
            }
        }
    }

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_commit_valid && rob_commit_ready && rob_commit_data.ctrl.rwb_en
        && rob_commit_data.rd_areg != 0 && !rob_commit_data.raise_trap;

    always_ff {
        // ROB先頭が完成済み & コミットが成立 & レジスタ書込み命令 & x0ではない & trapではない
        if rob_commit_fire {
            regfile[rob_commit_data.rd_areg] = rob_commit_data.result;
        }
    }

    // set: 分岐/ジャンプを dispatch した時
    // clear: 分岐/ジャンプが commit した時
    always_ff {
        if_reset {
            serial_pending = 0;
        } else if rob_commit_fire && (wbs_ctrl.is_jump || inst_is_br(wbs_ctrl)) {
            serial_pending = 0;
        } else if ids_fire && (ids_ctrl.is_jump || inst_is_br(ids_ctrl)) {
            serial_pending = 1;
        }
    }

    always_comb {
        // WB -> END
        rob_commit_ready = 1;

        flist_wvalid = rob_commit_fire;
        flist_wdata  = rob_commit_data.old_preg;
    }

    ///////////////////////////////// Pending Writes /////////////////////////////////

    let producer_commit: logic = rob_commit_fire && rob_commit_data.ctrl.rwb_en && rob_commit_data.rd_areg != 0;

    always_ff {
        if_reset {
            for i in 0..AREG_COUNT {
                producer_valid[i] = 0;
                producer_tag[i]   = 0;
            }
        } else if csru_raise_trap {
            // ROBと一緒に、フラッシュした命令の依存情報も破棄する
            for i in 0..AREG_COUNT {
                producer_valid[i] = 0;
                producer_tag[i]   = 0;
            }
        } else {
            // 最新producer自身がcommitした場合だけ解除
            if producer_commit && producer_valid[rob_commit_data.rd_areg] && producer_tag[rob_commit_data.rd_areg]
                == rob_head_tag && !(producer_allocate && rob_allocate_data.rd_areg == rob_commit_data.rd_areg) {
                producer_valid[rob_commit_data.rd_areg] = 0;
            }

            // 同じサイクルなら新しいallocationを優先
            if producer_allocate {
                producer_valid[rob_allocate_data.rd_areg] = 1;
                producer_tag[rob_allocate_data.rd_areg]   = rob_allocate_tag;
            }
        }
    }

    ///////////////////////////////// DEBUG /////////////////////////////////

    #[ifdef(PRINT_DEBUG)]
    {
        var clock_count: u64;

        var perf_cycles         : u64;
        var perf_issued         : u64;
        var perf_committed      : u64;
        var perf_ex_empty       : u64;
        var perf_serial_stall   : u64;
        var perf_raw_stall      : u64;
        var perf_muldiv_stall   : u64;
        var perf_rob_full_stall : u64;
        var perf_memq_full_stall: u64;
        var perf_mem_wait       : u64;
        var perf_head_wait      : u64;
        var perf_control_hazard : u64;

        always_ff {
            if_reset {
                clock_count = 1;

                perf_cycles          = 0;
                perf_issued          = 0;
                perf_committed       = 0;
                perf_ex_empty        = 0;
                perf_serial_stall    = 0;
                perf_raw_stall       = 0;
                perf_muldiv_stall    = 0;
                perf_rob_full_stall  = 0;
                perf_memq_full_stall = 0;
                perf_mem_wait        = 0;
                perf_head_wait       = 0;
                perf_control_hazard  = 0;
            } else {
                clock_count += 1;

                perf_cycles += 1;

                if rob_allocate_fire {
                    perf_issued += 1;
                }

                if rob_commit_fire {
                    perf_committed += 1;
                }

                // EX段の停止理由を排他的に数える
                if !exq_rvalid {
                    perf_ex_empty += 1;
                } else if control_hazard {
                    perf_control_hazard += 1;
                } else if serial_pending {
                    perf_serial_stall += 1;
                } else if exs_data_hazard {
                    perf_raw_stall += 1;
                } else if exs_muldiv_stall {
                    perf_muldiv_stall += 1;
                } else if !rob_allocate_ready {
                    perf_rob_full_stall += 1;
                } else if !exs_route_ready {
                    perf_memq_full_stall += 1;
                }

                // MEM側はEX停止理由と重複してもよい独立カウンタ
                if memq_rvalid && memu_stall {
                    perf_mem_wait += 1;
                }

                if memq_rvalid && !mems_can_execute {
                    perf_head_wait += 1;
                }

                $display("");
                $display("# %d", clock_count);

                $display("FRONTEND ------");
                $display(" redirect : %b", frontend_redirect);
                $display(" next pc  : %h", i_membus.next_pc);
                $display("ID ------");
                if ids_valid {
                    $display("  %h : %h", ids_pc, ids_inst_bits);
                    $display("  itype : %b", ids_ctrl.itype);
                    $display("  imm   : %h", ids_imm);
                }
                $display("EX -----");
                if exs_valid {
                    $display("  %h : %h", exq_rdata.addr, exq_rdata.bits);
                    $display("  op1     : %h", exs_op1);
                    $display("  op2     : %h", exs_op2);
                    $display("  alu     : %h", exs_alu_result);
                    $display("  dhazard : %b", exs_data_hazard);
                    if inst_is_br(exs_ctrl) {
                        $display("  br take : %b", exs_brunit_take);
                    }
                }
                // $display("MEM -----");
                // if mems_valid {
                //     $display("  %h : %h", memq_rdata.addr, memq_rdata.bits);
                //     $display("  mem stall : %b", memu_stall);
                //     $display("  mem rdata : %h", memu_rdata);
                //     if mems_ctrl.is_csr {
                //         $display("  csr rdata : %h", csru_rdata);
                //         $display("  csr trap  : %b", csru_raise_trap);
                //         $display("  csr vec   : %h", csru_trap_vector);
                //     }
                //     if memq_rdata.br_taken {
                //         $display("  JUMP TO   : %h", memq_rdata.jump_addr);
                //     }
                // }
                $display("WB ----");
                if wbs_valid {
                    $display("  %h : %h", rob_commit_data.addr, rob_commit_data.bits);
                    if wbs_ctrl.rwb_en {
                        $display("  reg[%d] <= %h", wbs_rd_areg, wbs_wb_data);
                    }
                }

                $display("PERFORMANCE COUNTERS");
                $display("  total cycles             : %0d", perf_cycles);
                $display("  instructions issued      : %0d", perf_issued);
                $display("  instructions committed   : %0d", perf_committed);
                $display("  EX has no instruction    : %0d", perf_ex_empty);
                $display("  control hazard / flush   : %0d", perf_control_hazard);
                $display("  serializing instruction  : %0d", perf_serial_stall);
                $display("  RAW dependency           : %0d", perf_raw_stall);
                $display("  multiply/divide wait     : %0d", perf_muldiv_stall);
                $display("  ROB full                 : %0d", perf_rob_full_stall);
                $display("  EX/MEM queue full        : %0d", perf_memq_full_stall);
                $display("  memory response wait     : %0d", perf_mem_wait);
                $display("  waiting for ROB head     : %0d", perf_head_wait);
            }
        }
    }

    ///////////////////////////////// Pipeline trace /////////////////////////////////

    #[ifdef(LOG_PIPELINE)]
    {
        var trace_cycle: u64;
        always_ff {
            if_reset {
                trace_cycle = 0;
                $display("KTRACE\t1");
            } else {
                // Each line records only information available at this point.
                // test/konata.py assigns dynamic instruction IDs and resolves flushes.
                if ids_fire {
                    $display("K\t%0d\tX\t%h\t%h\t%b", trace_cycle, ids_pc, ids_inst_bits, ids_ctrl.itype);
                }
                if rob_allocate_fire {
                    $display(
                        "K\t%0d\tA\t%0d\t%h\t%h\t%b",
                        trace_cycle,
                        rob_allocate_tag,
                        exs_pc,
                        exs_inst_bits,
                        exs_needs_mem,
                    );
                }
                if rob_complete_valid {
                    $display("K\t%0d\tC\t%0d", trace_cycle, rob_complete_tag);
                }
                if rob_commit_fire {
                    $display(
                        "K\t%0d\tW\t%0d\t%h\t%h",
                        trace_cycle,
                        rob_head_tag,
                        rob_commit_data.addr,
                        rob_commit_data.bits,
                    );
                }
                if control_hazard {
                    $display(
                        "K\t%0d\tR\tMEM\t%h\t%h\t%h",
                        trace_cycle,
                        mems_pc,
                        mems_inst_bits,
                        control_hazard_pc_next,
                    );
                } else if prediction_redirect {
                    $display("K\t%0d\tR\tPRED\t%h\t%h\t%h", trace_cycle, ids_pc, ids_inst_bits, ids_pred_target);
                }
                trace_cycle += 1;
            }
        }
    }

    ///////////////////////////////// Bimodal & BTB/////////////////////////////////

    inst bp: bimodal_predictor (
        clk  ,
        rst  ,

        predict_pc   : ids_pc            ,
        predict_taken: bimodal_pred_taken,
        predict_valid: bimodal_pred_valid,

        update_valid: aluq_rvalid && aluq_rready && inst_is_br(aluq_rdata.ctrl),
        update_pc   : aluq_rdata.addr                                          ,
        update_taken: aluq_br_take                                             ,
    );

    inst btb: branch_target_buffer (
        clk  ,
        rst  ,

        predict_pc    : ids_pc    ,
        predict_hit   : btb_hit   ,
        predict_target: btb_target,

        update_valid : aluq_rvalid && aluq_rready && aluq_is_jalr,
        update_pc    : aluq_rdata.addr                           ,
        update_target: aluq_result & ~1,
    );

    ///////////////////////////////// FIFO /////////////////////////////////

    inst aluq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: aluq_wready   ,
        wvalid: aluq_wvalid   ,
        wdata : aluq_wdata    ,
        rready: aluq_rready   ,
        rvalid: aluq_rvalid   ,
        rdata : aluq_rdata    ,
    );

    inst memq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: memq_wready   ,
        wvalid: memq_wvalid   ,
        wdata : memq_wdata    ,
        rready: memq_rready   ,
        rvalid: memq_rvalid   ,
        rdata : memq_rdata    ,
    );

    inst muldivq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: muldivq_wready,
        wvalid: muldivq_wvalid,
        wdata : muldivq_wdata ,
        rready: muldivq_rready,
        rvalid: muldivq_rvalid,
        rdata : muldivq_rdata ,
    );

    inst csrq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: csrq_wready   ,
        wvalid: csrq_wvalid   ,
        wdata : csrq_wdata    ,
        rready: csrq_rready   ,
        rvalid: csrq_rvalid   ,
        rdata : csrq_rdata    ,
    );

    inst id_ex_fifo: fifo #(
        DATA_TYPE: exq_type,
        WIDTH    : 4       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: exq_wready    ,
        wvalid: exq_wvalid    ,
        wdata : exq_wdata     ,
        rready: exq_rready    ,
        rvalid: exq_rvalid    ,
        rdata : exq_rdata     ,
    );

    // inst ex_mem_fifo: fifo #(
    //     DATA_TYPE: memq_type,
    //     WIDTH    : 4        ,
    // ) (
    //     clk                   ,
    //     rst                   ,
    //     flush : control_hazard,
    //     wready: memq_wready   ,
    //     wvalid: memq_wvalid   ,
    //     wdata : memq_wdata    ,
    //     rready: memq_rready   ,
    //     rvalid: memq_rvalid   ,
    //     rdata : memq_rdata    ,
    // );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk  ,
        rst  ,
        // トラップはROB先頭でのみ受理するため、ここで全破棄できる
        flush: control_hazard,

        allocate_valid: rob_allocate_valid,
        allocate_ready: rob_allocate_ready,
        allocate_done : rob_allocate_done ,
        allocate_data : rob_allocate_data ,
        allocate_tag  : rob_allocate_tag  ,

        complete_valid: rob_complete_valid,
        complete_tag  : rob_complete_tag  ,
        complete_data : rob_complete_data ,

        commit_valid: rob_commit_valid,
        commit_ready: rob_commit_ready,
        commit_data : rob_commit_data ,

        head_valid: rob_head_valid,
        head_tag  : rob_head_tag  ,

        query1_tag : rob_query1_tag ,
        query1_done: rob_query1_done,
        query1_data: rob_query1_data,

        query2_tag : rob_query2_tag ,
        query2_done: rob_query2_done,
        query2_data: rob_query2_data,
    );

    inst flist: free_list (
        clk                 ,
        rst                 ,
        rready: flist_rready,
        rvalid: flist_rvalid,
        rdata : flist_rdata ,
        wready: flist_wready,
        wvalid: flist_wvalid,
        wdata : flist_wdata ,
    );

    inst rat: register_alias_table (
        clk                         ,
        rst                         ,
        flush      : rat_flush      ,
        read1_addr : rat_read1_addr ,
        read1_data : rat_read1_data ,
        read2_addr : rat_read2_addr ,
        read2_data : rat_read2_data ,
        write_valid: rat_write_valid,
        write_addr : rat_write_addr ,
        write_data : rat_write_data ,
        write_old  : rat_write_old  ,
    );

    inst prf: physical_register_file (
        clk                           ,
        rst                           ,
        read1_addr  : alu_read1_addr  ,
        read1_data  : alu_read1_data  ,
        read2_addr  : alu_read2_addr  ,
        read2_data  : alu_read2_data  ,
        read3_addr  : memu_read1_addr ,
        read3_data  : memu_read1_data ,
        read4_addr  : memu_read2_addr ,
        read4_data  : memu_read2_data ,
        read5_addr  : mdu_read1_addr  ,
        read5_data  : mdu_read1_data  ,
        read6_addr  : mdu_read2_addr  ,
        read6_data  : mdu_read2_data  ,
        write1_valid: alu_write_valid ,
        write1_addr : alu_write_addr  ,
        write1_data : alu_write_data  ,
        write2_valid: memu_write_valid,
        write2_addr : memu_write_addr ,
        write2_data : memu_write_data ,
        write3_valid: mdu_write_valid ,
        write3_addr : mdu_write_addr  ,
        write3_data : mdu_write_data  ,
        write4_valid: csr_write_valid ,
        write4_addr : csr_write_addr  ,
        write4_data : csr_write_data  ,
    );
}
