import eei::*;
import corectrl::*;

module core (
    clk     : input   clock               ,
    rst     : input   reset               ,
    i_membus: modport core_inst_if::master,
    d_membus: modport core_data_if::master,
    led     : output  UIntX               ,
) {
    struct exq_type {
        #[ifdef(LOG_KONATA)]
        trace_id: logic<64>,
        #[ifdef(LOG_KONATA)]
        pred_trace_id_next: logic        <64>,
        addr              : Addr             ,
        bits              : Inst             ,
        ctrl              : InstCtrl         ,
        imm               : UIntX            ,
        expt              : ExceptionInfo    ,
        pred_taken        : logic            ,
    }

    struct memq_type {
        #[ifdef(LOG_KONATA)]
        trace_id  : logic        <64>,
        rob_tag   : RobTag           ,
        addr      : Addr             ,
        bits      : Inst             ,
        ctrl      : InstCtrl         ,
        imm       : UIntX            ,
        expt      : ExceptionInfo    ,
        alu_result: UIntX            ,
        rs1_addr  : logic        <5> ,
        rs1_data  : UIntX            ,
        rs2_data  : UIntX            ,
        br_taken  : logic            ,
        jump_addr : Addr             ,
    }

    struct wbq_type {
        #[ifdef(LOG_KONATA)]
        trace_id  : logic   <64>,
        addr      : Addr        ,
        bits      : Inst        ,
        ctrl      : InstCtrl    ,
        imm       : UIntX       ,
        alu_result: UIntX       ,
        mem_rdata : UIntX       ,
        csr_rdata : UIntX       ,
        raise_trap: logic       ,
    }

    struct rob_entry_type {
        #[ifdef(LOG_KONATA)]
        trace_id  : logic        <64>,
        addr      : Addr             ,
        bits      : Inst             ,
        ctrl      : InstCtrl         ,
        rd_addr   : logic        <5> ,
        result    : UIntX            ,
        expt      : ExceptionInfo    ,
        raise_trap: logic            ,
    }

    // ID -> EXのFIFO
    var exq_wready: logic   ;
    var exq_wvalid: logic   ;
    var exq_wdata : exq_type;
    var exq_rready: logic   ;
    var exq_rvalid: logic   ;
    var exq_rdata : exq_type;

    // EX -> MEMのFIFO
    var memq_wready: logic    ;
    var memq_wvalid: logic    ;
    var memq_wdata : memq_type;
    var memq_rready: logic    ;
    var memq_rvalid: logic    ;
    var memq_rdata : memq_type;

    // (EX, MEM) -> WB の Reorder Buffer
    var rob_allocate_valid: logic         ;
    var rob_allocate_ready: logic         ;
    var rob_allocate_done : logic         ;
    var rob_allocate_data : rob_entry_type;
    var rob_allocate_tag  : RobTag        ;

    var rob_complete_valid: logic         ;
    var rob_complete_tag  : RobTag        ;
    var rob_complete_data : rob_entry_type;

    var rob_commit_valid: logic         ;
    var rob_commit_ready: logic         ;
    var rob_commit_data : rob_entry_type;

    var rob_head_valid: logic ;
    var rob_head_tag  : RobTag;

    var rob_query1_tag : RobTag        ;
    var rob_query1_done: logic         ;
    var rob_query1_data: rob_entry_type;
    var rob_query2_tag : RobTag        ;
    var rob_query2_done: logic         ;
    var rob_query2_data: rob_entry_type;

    ///////////////////////////////// IF Stage /////////////////////////////////

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;

    var exs_branch_mispredict: logic;
    var exs_recovery_pc      : Addr ;

    var prediction_redirect: logic;
    var ids_pc             : Addr ;
    var ids_imm            : UIntX;

    let frontend_redirect: logic = control_hazard || exs_branch_mispredict || prediction_redirect;
    always_comb {
        i_membus.is_redirect = frontend_redirect;

        if control_hazard {
            i_membus.next_pc = control_hazard_pc_next;
        } else if exs_branch_mispredict {
            i_membus.next_pc = exs_recovery_pc;
        } else {
            i_membus.next_pc = ids_pc + ids_imm;
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_valid     = i_membus.rvalid;
    let ids_inst_bits = i_membus.rdata;

    let ids_fire: logic = !control_hazard && !exs_branch_mispredict && i_membus.rvalid && i_membus.rready;
    #[ifdef(LOG_KONATA)]
    let id_ex_fire: logic = ids_fire;

    #[ifdef(LOG_KONATA)]
    let ids_trace_id: logic<64> = i_membus.trace_id;

    var ids_inst_valid: logic   ;
    var ids_ctrl      : InstCtrl;

    // Backward Taken, Forward Not Taken の静的分岐予測
    let ids_pred_taken: logic = ids_inst_valid && inst_is_br(ids_ctrl) && ids_imm[msb];
    always_comb {
        ids_pc              = i_membus.raddr;
        prediction_redirect = !control_hazard && ids_fire && ids_pred_taken;
    }

    inst decoder: inst_decoder (
        bits  : ids_inst_bits  ,
        is_rvc: i_membus.is_rvc,
        valid : ids_inst_valid ,
        ctrl  : ids_ctrl       ,
        imm   : ids_imm        ,
    );

    always_comb {
        // ID -> EX
        i_membus.rready = exq_wready;
        exq_wvalid      = i_membus.rvalid;

        exq_wdata.addr       = i_membus.raddr;
        exq_wdata.bits       = i_membus.rdata;
        exq_wdata.ctrl       = ids_ctrl;
        exq_wdata.imm        = ids_imm;
        exq_wdata.pred_taken = ids_pred_taken;

        #[ifdef(LOG_KONATA)]
        exq_wdata.trace_id = i_membus.trace_id;

        #[ifdef(LOG_KONATA)]
        exq_wdata.pred_trace_id_next = i_membus.trace_id_next;

        // exception
        exq_wdata.expt = 0;
        if !ids_inst_valid {
            // illegal instruction
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            exq_wdata.expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::ENVIRONMENT_CALL_FROM_M_MODE;
            exq_wdata.expt.value = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::BREAKPOINT;
            exq_wdata.expt.value = ids_pc;
        }
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    let exs_valid    : logic    = exq_rvalid;
    let exs_pc       : Addr     = exq_rdata.addr;
    let exs_inst_bits: Inst     = exq_rdata.bits;
    let exs_ctrl     : InstCtrl = exq_rdata.ctrl;
    let exs_imm      : UIntX    = exq_rdata.imm;

    #[ifdef(LOG_KONATA)]
    let exs_trace_id: logic<64> = exq_rdata.trace_id;

    // レジスタ
    var regfile: UIntX<32>;

    // 各レジスタを最後に書く予定のROBエントリ
    var producer_valid: logic  [32];
    var producer_tag  : RobTag [32];

    // レジスタ番号
    let exs_rs1_addr: logic<5> = exs_inst_bits[19:15];
    let exs_rs2_addr: logic<5> = exs_inst_bits[24:20];

    // データハザード
    let exs_uses_rs1: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::I: if exs_ctrl.is_csr ? exs_ctrl.funct3[1:0] != 0 && !exs_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_uses_rs2: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_rs1_has_producer: logic = exs_uses_rs1 && exs_rs1_addr != 0 && producer_valid[exs_rs1_addr];
    let exs_rs2_has_producer: logic = exs_uses_rs2 && exs_rs2_addr != 0 && producer_valid[exs_rs2_addr];
    let exs_rs1_data_hazard : logic = exs_valid && exs_rs1_has_producer && !rob_query1_done;
    let exs_rs2_data_hazard : logic = exs_valid && exs_rs2_has_producer && !rob_query2_done;
    let exs_data_hazard     : logic = exs_rs1_data_hazard || exs_rs2_data_hazard;

    // ソースレジスタのデータ
    let exs_rs1_data: UIntX = switch {
        exs_rs1_addr == 0                      : 0,
        exs_rs1_has_producer && rob_query1_done: rob_query1_data.result,
        default                                : regfile[exs_rs1_addr],
    };
    let exs_rs2_data: UIntX = switch {
        exs_rs2_addr == 0                      : 0,
        exs_rs2_has_producer && rob_query2_done: rob_query2_data.result,
        default                                : regfile[exs_rs2_addr],
    };

    // ALU
    var exs_op1       : UIntX;
    var exs_op2       : UIntX;
    var exs_alu_result: UIntX;

    always_comb {
        case exs_ctrl.itype {
            InstType::R, InstType::B: {
                exs_op1 = exs_rs1_data;
                exs_op2 = exs_rs2_data;
            }
            InstType::I, InstType::S: {
                exs_op1 = exs_rs1_data;
                exs_op2 = exs_imm;
            }
            InstType::U, InstType::J: {
                exs_op1 = exs_pc;
                exs_op2 = exs_imm;
            }
            default: {
                exs_op1 = 'x;
                exs_op2 = 'x;
            }
        }
    }

    inst alum: alu (
        ctrl  : exs_ctrl      ,
        op1   : exs_op1       ,
        op2   : exs_op2       ,
        result: exs_alu_result,
    );

    var exs_muldiv_is_requested: logic;
    let exs_muldiv_valid       : logic = exs_valid && exs_ctrl.is_muldiv && !exs_data_hazard
        && !exs_muldiv_is_requested;
    var exs_muldiv_ready       : logic;
    var exs_muldiv_rvalid      : logic;
    var exs_muldiv_result      : UIntX;

    inst mdu: muldivunit (
        clk                       ,
        rst                       ,
        valid  : exs_muldiv_valid ,
        ready  : exs_muldiv_ready ,
        funct3 : exs_ctrl.funct3  ,
        is_op32: exs_ctrl.is_op32 ,
        op1    : exs_op1          ,
        op2    : exs_op2          ,
        rvalid : exs_muldiv_rvalid,
        result : exs_muldiv_result,
    );

    always_ff {
        if_reset {
            exs_muldiv_is_requested = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_is_requested = 0;
            } else {
                // muldivunitにリクエストしたか判定する
                if exs_muldiv_valid && exs_muldiv_ready {
                    exs_muldiv_is_requested = 1;
                }
            }
        }
    }

    var exs_muldiv_rvalided: logic;
    let exs_muldiv_stall   : logic = exs_ctrl.is_muldiv && !(exs_muldiv_rvalid && exs_muldiv_is_requested)
        && !exs_muldiv_rvalided;

    always_ff {
        if_reset {
            exs_muldiv_rvalided = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_rvalided = 0;
            } else if exs_muldiv_is_requested {
                // muldivunitの処理が完了していたら1にする
                exs_muldiv_rvalided |= exs_muldiv_rvalid;
            }
        }
    }

    var exs_brunit_take: logic;
    inst bru: brunit (
        funct3: exs_ctrl.funct3,
        op1   : exs_op1        ,
        op2   : exs_op2        ,
        take  : exs_brunit_take,
    );

    let exs_stall    : logic = exs_data_hazard || exs_muldiv_stall;
    let exs_needs_mem: logic = inst_is_memop(exs_ctrl) || exs_ctrl.is_csr || exs_ctrl.is_jump || inst_is_br(exs_ctrl)
        || exq_rdata.expt.valid;

    always_comb {
        rob_allocate_done         = !exs_needs_mem;
        rob_allocate_data.addr    = exq_rdata.addr;
        rob_allocate_data.bits    = exq_rdata.bits;
        rob_allocate_data.ctrl    = exq_rdata.ctrl;
        rob_allocate_data.rd_addr = exq_rdata.bits[11:7];
        rob_allocate_data.result  = switch {
            exs_ctrl.is_lui   : exq_rdata.imm,
            exs_ctrl.is_muldiv: exs_muldiv_result,
            default           : exs_alu_result,
        };

        #[ifdef(LOG_KONATA)]
        rob_allocate_data.trace_id = exq_rdata.trace_id;

        rob_allocate_data.expt       = memq_wdata.expt;
        rob_allocate_data.raise_trap = 0;

        rob_query1_tag = producer_tag[exs_rs1_addr];
        rob_query2_tag = producer_tag[exs_rs2_addr];
    }

    // 未解決の直列化命令がROB/MEM内にある
    var serial_pending: logic;

    // 命令が進む経路に空きがあるか
    let exs_route_ready: logic = !exs_needs_mem || memq_wready;
    // EX段の命令がROBへ実際に登録された
    let rob_allocate_fire: logic = rob_allocate_valid && rob_allocate_ready;
    // ROBに登録された命令が直列化命令（後続命令を確定できない命令）かどうか
    let exs_redirect      : logic = exs_ctrl.is_jump || (inst_is_br(exs_ctrl) && exs_brunit_take);
    let exs_is_serializing: logic = exs_redirect || exs_ctrl.is_csr || memq_wdata.expt.valid;
    // ROBに登録された命令が直列化命令の場合，次の命令のROB登録を待つ
    let serial_allocate: logic = rob_allocate_fire && exs_is_serializing;

    let producer_allocate: logic = rob_allocate_fire && rob_allocate_data.ctrl.rwb_en && rob_allocate_data.rd_addr != 0;

    always_comb {
        // EX -> MEM
        // 分岐予測の確認
        exs_branch_mispredict = rob_allocate_fire && inst_is_br(exs_ctrl) && (exq_rdata.pred_taken != exs_brunit_take);
        if exs_brunit_take {
            exs_recovery_pc = exs_pc + exs_imm;
        } else {
            exs_recovery_pc = exs_pc + (if exs_ctrl.is_rvc ? 2 : 4);
        }

        // ROBだけallocationされたり MEM FIFOだけ書き込まれたりするのを防ぐ
        rob_allocate_valid = exq_rvalid && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
        exq_rready         = rob_allocate_ready && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
        memq_wvalid        = rob_allocate_fire && exs_needs_mem;

        memq_wdata.addr = exq_rdata.addr;
        memq_wdata.bits = exq_rdata.bits;
        memq_wdata.ctrl = exq_rdata.ctrl;
        memq_wdata.imm  = exq_rdata.imm;

        #[ifdef(LOG_KONATA)]
        memq_wdata.trace_id = exq_rdata.trace_id;

        memq_wdata.rs1_addr   = exs_rs1_addr;
        memq_wdata.rs1_data   = exs_rs1_data;
        memq_wdata.rs2_data   = exs_rs2_data;
        memq_wdata.alu_result = if exs_ctrl.is_muldiv ? exs_muldiv_result : exs_alu_result;
        memq_wdata.br_taken   = exs_ctrl.is_jump || inst_is_br(exs_ctrl) && exs_brunit_take;
        memq_wdata.jump_addr  = if inst_is_br(exs_ctrl) ? exs_pc + exs_imm : exs_alu_result & ~1;
        memq_wdata.rob_tag    = rob_allocate_tag;

        // exception
        let instruction_address_misaligned: logic = IALIGN == 32 && memq_wdata.br_taken && memq_wdata.jump_addr[1:0]
            != 2'b00;
        let memaddr                       : Addr  = if exs_ctrl.is_amo ? exs_rs1_data : exs_alu_result;
        let loadstore_address_misaligned  : logic = inst_is_memop(exs_ctrl)
            && case exs_ctrl.funct3[1:0] {
                2'b00  : 1'b0, // B
                2'b01  : memaddr[0] != 1'b0, // H
                2'b10  : memaddr[1:0] != 2'b0, // W
                2'b11  : memaddr[2:0] != 3'b0, // D
                default: 1'b0,
            };
        memq_wdata.expt = exq_rdata.expt;
        if !memq_wdata.expt.valid {
            if instruction_address_misaligned {
                memq_wdata.expt.valid = 1;
                memq_wdata.expt.cause = CsrCause::INSTRUCTION_ADDRESS_MISALIGNED;
                memq_wdata.expt.value = memq_wdata.jump_addr;
            } else if loadstore_address_misaligned {
                memq_wdata.expt.valid = 1;
                memq_wdata.expt.cause = if exs_ctrl.is_load ?
                    CsrCause::LOAD_ADDRESS_MISALIGNED
                :
                    CsrCause::STORE_AMO_ADDRESS_MISALIGNED
                ;
                memq_wdata.expt.value = memaddr;
            }
        }
    }

    ///////////////////////////////// MEM Stage /////////////////////////////////

    let mems_valid    : logic            = memq_rvalid;
    let mems_pc       : Addr             = memq_rdata.addr;
    let mems_inst_bits: Inst             = memq_rdata.bits;
    let mems_ctrl     : InstCtrl         = memq_rdata.ctrl;
    let mems_expt     : ExceptionInfo    = memq_rdata.expt;
    let mems_rd_addr  : logic        <5> = mems_inst_bits[11:7];

    #[ifdef(LOG_KONATA)]
    let mems_trace_id: logic<64> = memq_rdata.trace_id;

    let mems_is_store   : logic = inst_is_store(mems_ctrl);
    let mems_at_rob_head: logic = rob_head_valid && rob_head_tag == memq_rdata.rob_tag;

    // 命令が直列化命令（後続命令を確定できない命令）かどうか
    let mems_is_serializing: logic = memq_rdata.br_taken || mems_ctrl.is_csr || mems_expt.valid;

    // Storeまたは直列化命令ならROB先頭の場合だけ実行してよい
    let mems_requires_head: logic = mems_is_store || mems_ctrl.is_amo || mems_ctrl.is_csr || mems_expt.valid;
    let mems_can_execute  : logic = !mems_requires_head || mems_at_rob_head;

    let serial_complete: logic = rob_complete_valid && mems_is_serializing;

    always_ff {
        if_reset {
            serial_pending = 0;
        } else {
            if serial_complete {
                serial_pending = 0;
            } else if serial_allocate {
                serial_pending = 1;
            }
        }
    }

    var memu_rdata: UIntX;
    var memu_stall: logic;
    let memu_addr : Addr  = if mems_ctrl.is_amo ? memq_rdata.rs1_data : memq_rdata.alu_result;

    inst memu: memunit (
        clk                                                       ,
        rst                                                       ,
        valid : mems_valid && mems_can_execute && !mems_expt.valid,
        ctrl  : mems_ctrl                                         ,
        addr  : memu_addr                                         ,
        rs2   : memq_rdata.rs2_data                               ,
        rdata : memu_rdata                                        ,
        stall : memu_stall                                        ,
        membus: d_membus                                          ,
    );

    var csru_rdata      : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;

    inst csru: csrunit (
        clk                                        ,
        rst                                        ,
        valid      : mems_valid && mems_can_execute,
        pc         : mems_pc                       ,
        inst_bits  : mems_inst_bits                ,
        ctrl       : mems_ctrl                     ,
        expt_info  : mems_expt                     ,
        rd_addr    : mems_rd_addr                  ,
        csr_addr   : mems_inst_bits[31:20]         ,
        rs1_addr   : memq_rdata.rs1_addr           ,
        rs1_data   : memq_rdata.rs1_data           ,
        rdata      : csru_rdata                    ,
        raise_trap : csru_raise_trap               ,
        trap_vector: csru_trap_vector              ,
        led                                        ,
    );

    always_comb {
        // MEM -> WB
        memq_rready        = mems_can_execute && !memu_stall;
        rob_complete_valid = memq_rvalid && mems_can_execute && !memu_stall;
        rob_complete_tag   = memq_rdata.rob_tag;

        rob_complete_data.addr    = memq_rdata.addr;
        rob_complete_data.bits    = memq_rdata.bits;
        rob_complete_data.ctrl    = memq_rdata.ctrl;
        rob_complete_data.rd_addr = memq_rdata.bits[11:7];

        rob_complete_data.result = switch {
            mems_ctrl.is_lui                     : memq_rdata.imm,
            mems_ctrl.is_jump                    : memq_rdata.addr + (if mems_ctrl.is_rvc ? 2 : 4),
            mems_ctrl.is_load || mems_ctrl.is_amo: memu_rdata,
            mems_ctrl.is_csr                     : csru_rdata,
            default                              : memq_rdata.alu_result
        };

        rob_complete_data.expt       = memq_rdata.expt;
        rob_complete_data.raise_trap = csru_raise_trap;

        #[ifdef(LOG_KONATA)]
        rob_complete_data.trace_id = memq_rdata.trace_id;

    }

    always_comb {
        control_hazard         = mems_valid && mems_can_execute && (csru_raise_trap || mems_ctrl.is_jump);
        control_hazard_pc_next = if csru_raise_trap ? csru_trap_vector : memq_rdata.jump_addr;
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    let wbs_valid  : logic       = rob_commit_valid;
    let wbs_ctrl   : InstCtrl    = rob_commit_data.ctrl;
    let wbs_rd_addr: logic   <5> = rob_commit_data.rd_addr;
    let wbs_wb_data: UIntX       = rob_commit_data.result;

    #[ifdef(LOG_KONATA)]
    let wbs_trace_id: logic<64> = rob_commit_data.trace_id;

    always_ff {
        // ROB先頭が完成済み & コミットが成立 & レジスタ書込み命令 & x0ではない & trapではない
        if rob_commit_valid && rob_commit_ready && rob_commit_data.ctrl.rwb_en && rob_commit_data.rd_addr != 0
            && !rob_commit_data.raise_trap {
            regfile[rob_commit_data.rd_addr] = rob_commit_data.result;
        }
    }

    always_comb {
        // WB -> END
        rob_commit_ready = 1;
    }

    ///////////////////////////////// Pending Writes /////////////////////////////////

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_commit_valid && rob_commit_ready;

    let producer_commit: logic = rob_commit_fire && rob_commit_data.ctrl.rwb_en && rob_commit_data.rd_addr != 0;

    always_ff {
        if_reset {
            for i in 0..32 {
                producer_valid[i] = 0;
                producer_tag[i]   = 0;
            }
        } else {
            // 最新producer自身がcommitした場合だけ解除
            if producer_commit && producer_valid[rob_commit_data.rd_addr] && producer_tag[rob_commit_data.rd_addr]
                == rob_head_tag && !(producer_allocate && rob_allocate_data.rd_addr == rob_commit_data.rd_addr) {
                producer_valid[rob_commit_data.rd_addr] = 0;
            }

            // 同じサイクルなら新しいallocationを優先
            if producer_allocate {
                producer_valid[rob_allocate_data.rd_addr] = 1;
                producer_tag[rob_allocate_data.rd_addr]   = rob_allocate_tag;
            }
        }
    }

    ///////////////////////////////// DEBUG /////////////////////////////////

    #[ifdef(PRINT_DEBUG)]
    {
        var clock_count: u64;

        var perf_cycles         : u64;
        var perf_issued         : u64;
        var perf_committed      : u64;
        var perf_ex_empty       : u64;
        var perf_serial_stall   : u64;
        var perf_raw_stall      : u64;
        var perf_muldiv_stall   : u64;
        var perf_rob_full_stall : u64;
        var perf_memq_full_stall: u64;
        var perf_mem_wait       : u64;
        var perf_head_wait      : u64;
        var perf_control_hazard : u64;

        always_ff {
            if_reset {
                clock_count = 1;

                perf_cycles          = 0;
                perf_issued          = 0;
                perf_committed       = 0;
                perf_ex_empty        = 0;
                perf_serial_stall    = 0;
                perf_raw_stall       = 0;
                perf_muldiv_stall    = 0;
                perf_rob_full_stall  = 0;
                perf_memq_full_stall = 0;
                perf_mem_wait        = 0;
                perf_head_wait       = 0;
                perf_control_hazard  = 0;
            } else {
                clock_count += 1;

                perf_cycles += 1;

                if rob_allocate_fire {
                    perf_issued += 1;
                }

                if rob_commit_fire {
                    perf_committed += 1;
                }

                // EX段の停止理由を排他的に数える
                if !exq_rvalid {
                    perf_ex_empty += 1;
                } else if control_hazard {
                    perf_control_hazard += 1;
                } else if serial_pending {
                    perf_serial_stall += 1;
                } else if exs_data_hazard {
                    perf_raw_stall += 1;
                } else if exs_muldiv_stall {
                    perf_muldiv_stall += 1;
                } else if !rob_allocate_ready {
                    perf_rob_full_stall += 1;
                } else if !exs_route_ready {
                    perf_memq_full_stall += 1;
                }

                // MEM側はEX停止理由と重複してもよい独立カウンタ
                if memq_rvalid && memu_stall {
                    perf_mem_wait += 1;
                }

                if memq_rvalid && !mems_can_execute {
                    perf_head_wait += 1;
                }

                $display("");
                $display("# %d", clock_count);

                $display("FRONTEND ------");
                $display(" redirect : %b", frontend_redirect);
                $display(" next pc  : %h", i_membus.next_pc);
                $display("ID ------");
                if ids_valid {
                    $display("  %h : %h", ids_pc, ids_inst_bits);
                    $display("  itype : %b", ids_ctrl.itype);
                    $display("  imm   : %h", ids_imm);
                }
                $display("EX -----");
                if exs_valid {
                    $display("  %h : %h", exq_rdata.addr, exq_rdata.bits);
                    $display("  op1     : %h", exs_op1);
                    $display("  op2     : %h", exs_op2);
                    $display("  alu     : %h", exs_alu_result);
                    $display("  dhazard : %b", exs_data_hazard);
                    if inst_is_br(exs_ctrl) {
                        $display("  br take : %b", exs_brunit_take);
                    }
                }
                $display("MEM -----");
                if mems_valid {
                    $display("  %h : %h", memq_rdata.addr, memq_rdata.bits);
                    $display("  mem stall : %b", memu_stall);
                    $display("  mem rdata : %h", memu_rdata);
                    if mems_ctrl.is_csr {
                        $display("  csr rdata : %h", csru_rdata);
                        $display("  csr trap  : %b", csru_raise_trap);
                        $display("  csr vec   : %h", csru_trap_vector);
                    }
                    if memq_rdata.br_taken {
                        $display("  JUMP TO   : %h", memq_rdata.jump_addr);
                    }
                }
                $display("WB ----");
                if wbs_valid {
                    $display("  %h : %h", rob_commit_data.addr, rob_commit_data.bits);
                    if wbs_ctrl.rwb_en {
                        $display("  reg[%d] <= %h", wbs_rd_addr, wbs_wb_data);
                    }
                }

                $display("PERFORMANCE COUNTERS");
                $display("  total cycles             : %0d", perf_cycles);
                $display("  instructions issued      : %0d", perf_issued);
                $display("  instructions committed   : %0d", perf_committed);
                $display("  EX has no instruction    : %0d", perf_ex_empty);
                $display("  control hazard / flush   : %0d", perf_control_hazard);
                $display("  serializing instruction  : %0d", perf_serial_stall);
                $display("  RAW dependency           : %0d", perf_raw_stall);
                $display("  multiply/divide wait     : %0d", perf_muldiv_stall);
                $display("  ROB full                 : %0d", perf_rob_full_stall);
                $display("  EX/MEM queue full        : %0d", perf_memq_full_stall);
                $display("  memory response wait     : %0d", perf_mem_wait);
                $display("  waiting for ROB head     : %0d", perf_head_wait);
            }
        }
    }

    ///////////////////////////////// KONATA /////////////////////////////////

    #[ifdef(LOG_KONATA)]
    {
        var konata_retire_id: u64      ;
        var flush_begin     : logic<64>;
        always_comb {
            if control_hazard {
                // MEMでジャンプ・例外 → MEM命令より後ろを破棄
                flush_begin = mems_trace_id + 1;
            } else if exs_branch_mispredict {
                if exq_rdata.pred_taken {
                    // IDで既に破棄した範囲を除外
                    flush_begin = exq_rdata.pred_trace_id_next;
                } else {
                    flush_begin = exs_trace_id + 1;
                }
            } else {
                // prediction_redirect
                flush_begin = ids_trace_id + 1;
            }
        }
        always_ff {
            if_reset {
                konata_retire_id = 0;

                $display("Kanata\t0004");
                $display("C=\t0");
            } else {
                $display("C\t1");

                // IF / ID stage
                if i_membus.trace_fetch_valid {
                    $display("I\t%0d\t%0d\t0", i_membus.trace_fetch_id, i_membus.trace_fetch_id);
                    $display("S\t%0d\t0\tF", i_membus.trace_fetch_id);
                    $display(
                        "L\t%0d\t0\t%h: %h",
                        i_membus.trace_fetch_id,
                        i_membus.trace_fetch_addr,
                        i_membus.trace_fetch_bits,
                    );
                    $display("S\t%0d\t0\tD", i_membus.trace_fetch_id);
                }

                // EX stage
                if id_ex_fire {
                    $display("L\t%0d\t1\titype: %b", ids_trace_id, ids_ctrl.itype);
                    $display("S\t%0d\t0\tX", ids_trace_id);
                }

                // MEM stage
                if rob_allocate_fire {
                    if exs_needs_mem {
                        $display("S\t%0d\t0\tM", exs_trace_id);
                    } else {
                        $display("S\t%0d\t0\tB", exs_trace_id);
                    }
                }
                if rob_complete_valid {
                    $display("S\t%0d\t0\tB", mems_trace_id);
                }

                // WB stage
                if rob_commit_fire {
                    $display("S\t%0d\t0\tW", wbs_trace_id);
                    $display("R\t%0d\t%0d\t0", wbs_trace_id, konata_retire_id);

                    konata_retire_id += 1;
                }

                // 分岐・ジャンプ・例外による命令の破棄
                if control_hazard || exs_branch_mispredict || prediction_redirect {
                    for trace_id in (flush_begin as u32)..(i_membus.trace_id_next as u32) {
                        $display("R\t%0d\t%0d\t1", trace_id, konata_retire_id);
                    }
                }
            }
        }
    }

    ///////////////////////////////// FIFO /////////////////////////////////

    inst id_ex_fifo: fifo #(
        DATA_TYPE: exq_type,
        WIDTH    : 2       ,
    ) (
        clk                                            ,
        rst                                            ,
        flush : control_hazard || exs_branch_mispredict,
        wready: exq_wready                             ,
        wvalid: exq_wvalid                             ,
        wdata : exq_wdata                              ,
        rready: exq_rready                             ,
        rvalid: exq_rvalid                             ,
        rdata : exq_rdata                              ,
    );

    inst ex_mem_fifo: fifo #(
        DATA_TYPE: memq_type,
        WIDTH    : 2        ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: memq_wready   ,
        wvalid: memq_wvalid   ,
        wdata : memq_wdata    ,
        rready: memq_rready   ,
        rvalid: memq_rvalid   ,
        rdata : memq_rdata    ,
    );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk     ,
        rst     ,
        flush: 0,

        allocate_valid: rob_allocate_valid,
        allocate_ready: rob_allocate_ready,
        allocate_done : rob_allocate_done ,
        allocate_data : rob_allocate_data ,
        allocate_tag  : rob_allocate_tag  ,

        complete_valid: rob_complete_valid,
        complete_tag  : rob_complete_tag  ,
        complete_data : rob_complete_data ,

        commit_valid: rob_commit_valid,
        commit_ready: rob_commit_ready,
        commit_data : rob_commit_data ,

        head_valid: rob_head_valid,
        head_tag  : rob_head_tag  ,

        query1_tag : rob_query1_tag ,
        query1_done: rob_query1_done,
        query1_data: rob_query1_data,

        query2_tag : rob_query2_tag ,
        query2_done: rob_query2_done,
        query2_data: rob_query2_data,
    );
}
