import eei::*;
import corectrl::*;

module core (
    clk     : input   clock               ,
    rst     : input   reset               ,
    i_membus: modport core_inst_if::master,
    d_membus: modport core_data_if::master,
    led     : output  UIntX               ,
    aclint  : modport aclint_if::slave    ,
) {
    inst memu_bus    : core_data_if;
    inst storebuf_bus: core_data_if;

    // (EX, MEM) -> WB の Reorder Buffer
    var rob_allocate_valid: logic         ;
    var rob_allocate_ready: logic         ;
    var rob_allocate_done : logic         ;
    var rob_allocate_data : rob_entry_type;
    var rob_allocate_tag  : RobTag        ;

    var alu_complete_data : rob_entry_type;
    var memu_complete_data: rob_entry_type;
    var mdu_complete_data : rob_entry_type;
    var csru_complete_data: rob_entry_type;

    var rob_commit_valid: logic         ;
    var rob_commit_ready: logic         ;
    var rob_commit_data : rob_entry_type;

    var rob_head_valid    : logic         ;
    var rob_head_tag      : RobTag        ;
    var rob_rollback_valid: logic         ;
    var rob_rollback_ready: logic         ;
    var rob_rollback_data : rob_entry_type;
    var rob_rollback_busy : logic         ;
    var rollback_fire     : logic         ;
    var rollback_reg_fire : logic         ;

    ///////////////////////////////// IF Stage /////////////////////////////////

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;
    var fencei_redirect       : logic;
    var backend_redirect      : logic;
    var alu_redirect          : logic;
    var branch_redirect       : logic;
    var csr_redirect          : logic;

    // Redirectは実行結果のcycleから1cycle遅らせてfrontend/backendへ伝える。
    // ALUの分岐判定からdispatch queueの更新までを同一組合せ経路にしないため。
    var redirect_pending   : logic ;
    var redirect_is_branch : logic ;
    var redirect_is_csr    : logic ;
    var redirect_is_fence_i: logic ;
    var redirect_pc        : Addr  ;
    var redirect_tag       : RobTag;
    var redirect_head_tag  : RobTag;

    var prediction_redirect: logic;
    var ids_imm            : UIntX;
    var ids_pred_target    : Addr ;

    let frontend_redirect: logic = control_hazard || fencei_redirect || prediction_redirect;
    var alu_next_pc      : Addr ;
    always_comb {
        i_membus.is_redirect = frontend_redirect;

        if control_hazard {
            i_membus.next_pc = control_hazard_pc_next;
        } else {
            i_membus.next_pc = ids_pred_target;
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_inst_bits = i_membus.rdata;

    let ids_fire      : logic         = i_membus.rvalid && i_membus.rready;
    var ids_inst_valid: logic        ;
    var ids_ctrl      : InstCtrl     ;
    var ids_expt      : ExceptionInfo;

    var bimodal_pred_taken: logic;
    var bimodal_pred_valid: logic;

    let ids_btfnt_taken      : logic = ids_imm[msb]; // 負のoffsetならbackward
    let ids_branch_pred_taken: logic = if bimodal_pred_valid ? bimodal_pred_taken : ids_btfnt_taken;

    var btb_hit   : logic;
    var btb_target: Addr ;

    let ids_is_jal : logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::J;
    let ids_is_jalr: logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::I;

    let ids_pred_taken: logic = ids_inst_valid
        && (ids_is_jal || (ids_is_jalr && btb_hit) || (inst_is_br(ids_ctrl) && ids_branch_pred_taken));

    let ids_pc: Addr = i_membus.raddr;

    always_comb {
        prediction_redirect = !control_hazard && ids_fire && ids_pred_taken;
        ids_pred_target     = if ids_is_jalr ? btb_target : ids_pc + ids_imm;
    }

    inst decoder: inst_decoder (
        bits  : ids_inst_bits  ,
        is_rvc: i_membus.is_rvc,
        valid : ids_inst_valid ,
        ctrl  : ids_ctrl       ,
        imm   : ids_imm        ,
    );

    var flist_rready: logic  ;
    var flist_rvalid: logic  ;
    var flist_rdata : PhysReg;
    var flist_wready: logic  ;
    var flist_wvalid: logic  ;
    var flist_wdata : PhysReg;

    let ids_uses_rs1: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::I: if ids_ctrl.is_csr ? ids_ctrl.funct3[1:0] != 0 && !ids_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_uses_rs2: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_rd_areg   : ArchReg = ids_inst_bits[11:7];
    let ids_rs1_areg  : ArchReg = ids_inst_bits[19:15];
    let ids_rs2_areg  : ArchReg = ids_inst_bits[24:20];
    let ids_writes_rd : logic   = ids_ctrl.rwb_en && ids_rd_areg != 0;
    let ids_preg_ready: logic   = !ids_writes_rd || flist_rvalid;

    var rat_read1_data : PhysReg;
    var rat_read2_data : PhysReg;
    var rat_read1_addr : ArchReg;
    var rat_read2_addr : ArchReg;
    var rat_write_old  : PhysReg;
    var rat_write_valid: logic  ;
    var rat_write_addr : ArchReg;
    var rat_write_data : PhysReg;

    var rat_flush     : logic ;
    var branch_pending: logic ;
    var branch_rob_tag: RobTag;

    let ids_new_preg: PhysReg = flist_rdata;
    let ids_old_preg: PhysReg = rat_write_old;

    let rename_fire: logic = ids_fire && ids_writes_rd;

    always_comb {
        flist_rready = rename_fire;

        rat_read1_addr = ids_rs1_areg;
        rat_read2_addr = ids_rs2_areg;

        rat_write_valid = rename_fire || rollback_reg_fire;
        rat_write_addr  = if rollback_reg_fire ? rob_rollback_data.rd_areg : ids_rd_areg;
        rat_write_data  = if rollback_reg_fire ? rob_rollback_data.old_preg : ids_new_preg;

        rat_flush = 0;
    }

    var csru_priv_mode: PrivMode;

    var prf_busy: logic [PREG_COUNT];

    var alu_read1_addr : PhysReg;
    var alu_read1_data : UIntX  ;
    var alu_read2_addr : PhysReg;
    var alu_read2_data : UIntX  ;
    var memu_read1_addr: PhysReg;
    var memu_read1_data: UIntX  ;
    var memu_read2_addr: PhysReg;
    var memu_read2_data: UIntX  ;
    var mdu_read1_addr : PhysReg;
    var mdu_read1_data : UIntX  ;
    var mdu_read2_addr : PhysReg;
    var mdu_read2_data : UIntX  ;
    var csru_read_addr : PhysReg;
    var csru_read_data : UIntX  ;

    var alu_write_valid : logic  ;
    var alu_write_addr  : PhysReg;
    var alu_write_data  : UIntX  ;
    var memu_write_valid: logic  ;
    var memu_write_addr : PhysReg;
    var memu_write_data : UIntX  ;
    var mdu_write_valid : logic  ;
    var mdu_write_addr  : PhysReg;
    var mdu_write_data  : UIntX  ;
    var csru_write_valid: logic  ;
    var csru_write_addr : PhysReg;
    var csru_write_data : UIntX  ;

    var alu_wready  : logic   ;
    var alu_wvalid  : logic   ;
    var alu_rready  : logic   ;
    var alu_rvalid  : logic   ;
    var alu_wdata   : euq_type;
    var alu_rdata   : euq_type;
    var alu_grant   : logic   ;
    var alu_complete: logic   ;

    var alu_wrs1ready: logic;
    var alu_wrs2ready: logic;

    var memu_wready  : logic   ;
    var memu_wvalid  : logic   ;
    var memu_rready  : logic   ;
    var memu_rvalid  : logic   ;
    var memu_wdata   : euq_type;
    var memu_rdata   : euq_type;
    var memu_grant   : logic   ;
    var memu_complete: logic   ;

    var memu_start                : logic   ;
    var memu_kill                 : logic   ;
    var memu_drop_done            : logic   ;
    var memu_active_valid         : logic   ;
    var memu_killed               : logic   ;
    var memu_active_entry         : euq_type;
    var memu_exec_entry           : euq_type;
    var memu_wrs1ready            : logic   ;
    var memu_wrs2ready            : logic   ;
    var memu_load_addr            : Addr    ;
    var memu_load_blocked         : logic   ;
    var memu_forward_valid        : logic   ;
    var memu_forward_data         : UIntX   ;
    var storebuf_load_blocked     : logic   ;
    var storebuf_forward_valid    : logic   ;
    var storebuf_forward_data     : UIntX   ;
    var memu_operand_pending      : logic   ;
    var memu_operand_entry        : euq_type;
    var memu_operand_rs1_data     : UIntX   ;
    var memu_operand_rs2_data     : UIntX   ;
    var memu_operand_addr         : Addr    ;
    var memu_operand_blocked      : logic   ;
    var memu_operand_forward_valid: logic   ;
    var memu_operand_forward_data : UIntX   ;
    var memu_operand_capture      : logic   ;
    var memu_operand_kill         : logic   ;
    var memu_exec_rs1_data        : UIntX   ;
    var memu_exec_rs2_data        : UIntX   ;
    var memu_forward_complete     : logic   ;

    let memu_operand_recheck: logic = memu_operand_pending && memu_operand_blocked && !control_hazard;

    var storebuf_wready      : logic ;
    var storebuf_wvalid      : logic ;
    var storebuf_commit_valid: logic ;
    var storebuf_commit_done : logic ;
    var storebuf_commit_busy : logic ;
    var storebuf_head_valid  : logic ;
    var storebuf_head_tag    : RobTag;

    var mdu_wready  : logic   ;
    var mdu_wvalid  : logic   ;
    var mdu_rready  : logic   ;
    var mdu_rvalid  : logic   ;
    var mdu_wdata   : euq_type;
    var mdu_rdata   : euq_type;
    var mdu_grant   : logic   ;
    var mdu_complete: logic   ;

    var mdu_wrs1ready   : logic   ;
    var mdu_wrs2ready   : logic   ;
    var mdu_active_entry: euq_type;

    var csru_wready      : logic   ;
    var csru_wvalid      : logic   ;
    var csru_rready      : logic   ;
    var csru_rvalid      : logic   ;
    var csru_wdata       : euq_type;
    var csru_rdata       : euq_type;
    var csru_grant       : logic   ;
    var csru_complete    : logic   ;
    var csru_issue       : logic   ;
    var csru_active_valid: logic   ;
    var csru_active_entry: euq_type;

    always_ff {
        if_reset {
            for i in 0..PREG_COUNT {
                prf_busy[i] = 0;
            }
        } else {
            // 実行完了を先に反映
            if alu_write_valid {
                prf_busy[alu_write_addr] = 0;
            }
            if memu_write_valid {
                prf_busy[memu_write_addr] = 0;
            }
            if mdu_write_valid {
                prf_busy[mdu_write_addr] = 0;
            }
            if csru_write_valid {
                prf_busy[csru_write_addr] = 0;
            }
            if rollback_reg_fire {
                prf_busy[rob_rollback_data.rd_preg] = 0;
            }

            // 新規割当
            if rename_fire {
                prf_busy[ids_new_preg] = 1;
            }
        }
    }

    // dispatch: 命令種別に応じて該当キューに格納
    let ids_is_alu    : logic = !inst_is_memop(ids_ctrl) && !ids_ctrl.is_muldiv && !ids_ctrl.is_csr;
    let ids_is_load   : logic = ids_ctrl.is_load;
    let ids_is_store  : logic = inst_is_store(ids_ctrl);
    let ids_is_muldiv : logic = ids_ctrl.is_muldiv;
    let ids_is_csr    : logic = ids_ctrl.is_csr;
    let ids_is_fence_i: logic = ids_inst_bits[6:0] == OP_MISC_MEM && ids_inst_bits[14:12] == 3'b001;

    var dispatch_data: euq_type;

    // 未解決の直列化命令がROB/MEM内にある
    var serial_pending: logic;

    let ids_target_ready: logic = switch {
        inst_is_memop(ids_ctrl): memu_wready,
        ids_is_muldiv          : mdu_wready,
        ids_is_csr             : csru_wready,
        ids_is_alu              : alu_wready,
        default                 : 1,
    };
    let ids_is_control: logic = ids_is_jalr || inst_is_br(ids_ctrl) || ids_ctrl.is_csr || ids_is_fence_i;

    always_comb {
        i_membus.rready = !control_hazard && !rob_rollback_busy && !serial_pending
            && !(branch_pending && ids_is_control) && rob_allocate_ready && ids_target_ready && ids_preg_ready;
    }

    always_comb {
        // 該当キューの wvalid / wdata を駆動
        alu_wvalid  = ids_fire && ids_is_alu && alu_wready;
        memu_wvalid = ids_fire && (ids_is_load || ids_is_store) && memu_wready;
        mdu_wvalid  = ids_fire && ids_is_muldiv && mdu_wready;
        csru_wvalid = ids_fire && ids_is_csr && csru_wready;

        // dispatch_data を組み立て
        dispatch_data.addr        = ids_pc;
        dispatch_data.bits        = ids_inst_bits;
        dispatch_data.ctrl        = ids_ctrl;
        dispatch_data.imm         = ids_imm;
        dispatch_data.expt        = ids_expt;
        dispatch_data.rs1_preg    = rat_read1_data;
        dispatch_data.rs2_preg    = rat_read2_data;
        dispatch_data.rd_preg     = ids_new_preg;
        dispatch_data.old_preg    = ids_old_preg;
        dispatch_data.rob_tag     = rob_allocate_tag;
        dispatch_data.pred_taken  = ids_pred_taken;
        dispatch_data.pred_target = ids_pred_target;
        dispatch_data.uses_rs1    = ids_uses_rs1;
        dispatch_data.uses_rs2    = ids_uses_rs2;

        // issue_queue に今回入れる命令の readyを生成
        alu_wrs1ready  = !dispatch_data.uses_rs1 || !prf_busy[dispatch_data.rs1_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs1_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs1_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs1_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs1_preg);
        alu_wrs2ready  = !dispatch_data.uses_rs2 || !prf_busy[dispatch_data.rs2_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs2_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs2_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs2_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs2_preg);
        mdu_wrs1ready  = !dispatch_data.uses_rs1 || !prf_busy[dispatch_data.rs1_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs1_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs1_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs1_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs1_preg);
        mdu_wrs2ready  = !dispatch_data.uses_rs2 || !prf_busy[dispatch_data.rs2_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs2_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs2_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs2_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs2_preg);
        memu_wrs1ready = !dispatch_data.uses_rs1 || !prf_busy[dispatch_data.rs1_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs1_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs1_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs1_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs1_preg);
        memu_wrs2ready = !dispatch_data.uses_rs2 || !prf_busy[dispatch_data.rs2_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs2_preg)
            || (memu_write_valid && memu_write_addr == dispatch_data.rs2_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs2_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs2_preg);

        // dispatch_data を代入
        alu_wdata  = dispatch_data;
        memu_wdata = dispatch_data;
        mdu_wdata  = dispatch_data;
        csru_wdata = dispatch_data;

        // === ROB allocate (dispatch 時) ===
        rob_allocate_valid           = ids_fire;
        rob_allocate_done            = 0;
        rob_allocate_data.addr       = ids_pc;
        rob_allocate_data.bits       = ids_inst_bits;
        rob_allocate_data.ctrl       = ids_ctrl;
        rob_allocate_data.rd_areg    = ids_rd_areg;
        rob_allocate_data.rd_preg    = ids_new_preg;
        rob_allocate_data.old_preg   = ids_old_preg;
        rob_allocate_data.result     = 0; // complete 時に上書き
        rob_allocate_data.expt       = ids_expt;
        rob_allocate_data.raise_trap = 0;

    }

    always_comb {
        // exception
        if !ids_inst_valid {
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            ids_expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            ids_expt.valid      = 1;
            ids_expt.cause      = CsrCause::ENVIRONMENT_CALL_FROM_U_MODE;
            ids_expt.cause[1:0] = csru_priv_mode;
            ids_expt.value      = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::BREAKPOINT;
            ids_expt.value = ids_pc;
        } else {
            ids_expt = 0;
        }
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    always_comb {
        alu_read1_addr  = alu_rdata.rs1_preg;
        alu_read2_addr  = alu_rdata.rs2_preg;
        memu_read1_addr = memu_exec_entry.rs1_preg;
        memu_read2_addr = memu_exec_entry.rs2_preg;
        mdu_read1_addr  = mdu_rdata.rs1_preg;
        mdu_read2_addr  = mdu_rdata.rs2_preg;
        csru_read_addr  = csru_active_entry.rs1_preg;
    }

    // レジスタ
    var regfile: UIntX<AREG_COUNT>;

    // *_grant     実行ユニットへ命令を受理させる
    // *_done      実行ユニットの処理結果が有効
    // *_complete  ROB completeポートを獲得
    // *_rready    キューから命令を取り出す

    ///////////////////////////////// EX Stage (ALU) /////////////////////////////////

    var alu_op1: UIntX;
    var alu_op2: UIntX;

    always_comb {
        case alu_rdata.ctrl.itype {
            InstType::R, InstType::B: {
                // R-type (add, sub, and, ...) / B-type (branch)
                // x0 is permanently mapped to p0, whose PRF value is zero.
                alu_op1 = alu_read1_data;
                alu_op2 = alu_read2_data;
            }
            InstType::I, InstType::S: {
                // I-type (addi, load, store, JALR, CSR) / S-type
                alu_op1 = alu_read1_data;
                alu_op2 = alu_rdata.imm;
            }
            InstType::U, InstType::J: {
                // U-type (LUI, AUIPC) / J-type (JAL)
                // op1 = PC, op2 = immediate
                alu_op1 = alu_rdata.addr;
                alu_op2 = alu_rdata.imm;
            }
            default: {
                alu_op1 = 0;
                alu_op2 = 0;
            }
        }

    }

    let alu_is_fence_i: logic = alu_rdata.bits[6:0] == OP_MISC_MEM && alu_rdata.bits[14:12] == 3'b001;
    let alu_at_head   : logic = rob_head_valid && rob_head_tag == alu_rdata.rob_tag;

    var alu_result: UIntX;
    inst alu_alu: alu (
        ctrl  : alu_rdata.ctrl,
        op1   : alu_op1       ,
        op2   : alu_op2       ,
        result: alu_result    ,
    );

    let alu_is_br  : logic = inst_is_br(alu_rdata.ctrl);
    let alu_is_jalr: logic = alu_rdata.ctrl.is_jump && alu_rdata.ctrl.itype == InstType::I;
    // let alu_is_jal : logic = alu_rdata.ctrl.is_jump && alu_rdata.ctrl.itype == InstType::J;

    let alu_jalr_target: Addr = (alu_read1_data + alu_rdata.imm) & ~1;

    var alu_br_take: logic;
    inst alu_bru: brunit (
        funct3: alu_rdata.ctrl.funct3,
        op1   : alu_op1              ,
        op2   : alu_op2              ,
        take  : alu_br_take          ,
    );

    let alu_recovery_pc: Addr = switch {
        alu_is_jalr: alu_jalr_target,
        alu_br_take: alu_rdata.addr + alu_rdata.imm,
        default    : alu_rdata.addr + (if alu_rdata.ctrl.is_rvc ? 2 : 4),
    };

    let alu_mispredict: logic = alu_rvalid
        && ((alu_is_br && alu_rdata.pred_taken != alu_br_take)
            || (alu_is_jalr && (alu_rdata.pred_taken != 1 || alu_rdata.pred_target != alu_jalr_target)));

    let alu_writes_rd: logic = alu_rvalid && alu_rdata.ctrl.rwb_en && alu_rdata.bits[11:7] != 0;

    let alu_writeback_data: UIntX = switch {
        alu_rdata.ctrl.is_jump: alu_next_pc,
        alu_rdata.ctrl.is_lui : alu_rdata.imm,
        default               : alu_result,
    };

    always_comb {
        alu_next_pc = alu_rdata.addr + (if alu_rdata.ctrl.is_rvc ? 2 : 4);

        alu_write_valid = alu_writes_rd && alu_rready;
        alu_write_addr  = alu_rdata.rd_preg;
        alu_write_data  = alu_writeback_data;
    }

    ///////////////////////////////// EX Stage (MDU) /////////////////////////////////

    var mdu_ready       : logic;
    var mdu_result      : UIntX;
    var mdu_result_valid: logic;
    var mdu_busy        : logic;
    var mdu_kill        : logic;

    inst mdu: muldivunit (
        clk                            ,
        rst                            ,
        valid  : mdu_grant             ,
        ready  : mdu_ready             ,
        funct3 : mdu_rdata.ctrl.funct3 ,
        is_op32: mdu_rdata.ctrl.is_op32,
        op1    : mdu_read1_data        ,
        op2    : mdu_read2_data        ,
        rvalid : mdu_result_valid      ,
        result : mdu_result            ,
    );

    always_ff {
        if_reset {
            mdu_busy         = 0;
            mdu_active_entry = '0;
        } else if mdu_kill {
            mdu_busy         = 0;
            mdu_active_entry = '0;
        } else {
            if mdu_grant {
                mdu_busy         = 1;
                mdu_active_entry = mdu_rdata;
            }

            if mdu_complete {
                mdu_busy = 0;
            }
        }
    }

    ///////////////////////////////// EX Stage (MEMU) /////////////////////////////////

    let mems_pc       : Addr = memu_rdata.addr;
    let mems_inst_bits: Inst = memu_rdata.bits;

    var memu_result: UIntX;
    var memu_stall : logic;

    always_comb {
        memu_exec_entry    = if memu_active_valid ?
            memu_active_entry
        : if memu_operand_pending ?
            memu_operand_entry
        :
            memu_rdata
        ;
        memu_exec_rs1_data = if memu_active_valid || memu_operand_pending ? memu_operand_rs1_data : memu_read1_data;
        memu_exec_rs2_data = if memu_active_valid || memu_operand_pending ? memu_operand_rs2_data : memu_read2_data;
        memu_load_addr     = memu_operand_addr;
    }

    inst memu: memunit (
        clk   : clk                                     ,
        rst   : rst                                     ,
        valid : memu_grant                              ,
        ctrl  : memu_exec_entry.ctrl                    ,
        addr  : memu_exec_rs1_data + memu_exec_entry.imm,
        rs2   : memu_exec_rs2_data                      ,
        rdata : memu_result                             ,
        stall : memu_stall                              ,
        membus: memu_bus                                ,
    );

    always_ff {
        if_reset {
            memu_active_valid = 0;
            memu_killed       = 0;
            memu_active_entry = '0;
        } else {
            if memu_start && !memu_forward_valid {
                memu_active_valid = 1;
                memu_killed       = 0;
                memu_active_entry = memu_operand_entry;
            }
            if memu_kill {
                memu_killed = 1;
            }
            if memu_complete || memu_drop_done {
                memu_active_valid = 0;
                memu_killed       = 0;
            }
        }
    }

    always_ff {
        if_reset {
            memu_operand_pending       = 0;
            memu_operand_entry         = '0;
            memu_operand_rs1_data      = 0;
            memu_operand_rs2_data      = 0;
            memu_operand_addr          = 0;
            memu_operand_blocked       = 0;
            memu_operand_forward_valid = 0;
            memu_operand_forward_data  = 0;
        } else if csr_redirect {
            memu_operand_pending = 0;
        } else {
            if memu_operand_capture {
                memu_operand_pending       = 1;
                memu_operand_entry         = memu_rdata;
                memu_operand_rs1_data      = memu_read1_data;
                memu_operand_rs2_data      = memu_read2_data;
                memu_operand_addr          = memu_read1_data + memu_rdata.imm;
                memu_operand_blocked       = storebuf_load_blocked;
                memu_operand_forward_valid = storebuf_forward_valid;
                memu_operand_forward_data  = storebuf_forward_data;
            } else if memu_operand_recheck {
                memu_operand_blocked       = storebuf_load_blocked;
                memu_operand_forward_valid = storebuf_forward_valid;
                memu_operand_forward_data  = storebuf_forward_data;
            }
            if memu_operand_kill || memu_start || storebuf_wvalid {
                memu_operand_pending = 0;
            }
        }
    }

    // Load用MEMUと、ROB headで実行するStore Bufferを1本のバスへ接続する。
    let storebus_selected: logic = storebuf_commit_busy;
    always_comb {
        if storebus_selected {
            d_membus.valid  = storebuf_bus.valid;
            d_membus.addr   = storebuf_bus.addr;
            d_membus.wen    = storebuf_bus.wen;
            d_membus.wdata  = storebuf_bus.wdata;
            d_membus.wmask  = storebuf_bus.wmask;
            d_membus.is_amo = storebuf_bus.is_amo;
            d_membus.aq     = storebuf_bus.aq;
            d_membus.rl     = storebuf_bus.rl;
            d_membus.amoop  = storebuf_bus.amoop;
            d_membus.funct3 = storebuf_bus.funct3;
        } else {
            d_membus.valid  = memu_bus.valid;
            d_membus.addr   = memu_bus.addr;
            d_membus.wen    = memu_bus.wen;
            d_membus.wdata  = memu_bus.wdata;
            d_membus.wmask  = memu_bus.wmask;
            d_membus.is_amo = memu_bus.is_amo;
            d_membus.aq     = memu_bus.aq;
            d_membus.rl     = memu_bus.rl;
            d_membus.amoop  = memu_bus.amoop;
            d_membus.funct3 = memu_bus.funct3;
        }

        memu_bus.ready      = d_membus.ready && !storebus_selected;
        memu_bus.rvalid     = d_membus.rvalid && !storebus_selected;
        memu_bus.rdata      = d_membus.rdata;
        storebuf_bus.ready  = d_membus.ready && storebus_selected;
        storebuf_bus.rvalid = d_membus.rvalid && storebus_selected;
        storebuf_bus.rdata  = d_membus.rdata;
    }

    var minstret: UInt64;

    ///////////////////////////////// EX Stage (CSRU) /////////////////////////////////

    var csru_result     : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;
    var csru_trap_return: logic;

    let csru_at_head: logic = csru_rvalid && rob_head_valid && rob_head_tag == csru_rdata.rob_tag;

    always_ff {
        if_reset {
            csru_active_valid = 0;
            csru_active_entry = '0;
        } else if backend_redirect {
            csru_active_valid = 0;
            csru_active_entry = '0;
        } else {
            if csru_issue {
                csru_active_valid = 1;
                csru_active_entry = csru_rdata;
            }
            if csru_complete {
                csru_active_valid = 0;
            }
        }
    }

    inst csru: csrunit (
        clk                                       ,
        rst                                       ,
        valid      : csru_grant                   ,
        pc         : csru_active_entry.addr       ,
        inst_bits  : csru_active_entry.bits       ,
        ctrl       : csru_active_entry.ctrl       ,
        expt_info  : csru_active_entry.expt       ,
        rd_areg    : csru_active_entry.bits[11:7] ,
        csr_addr   : csru_active_entry.bits[31:20],
        rs1_areg   : csru_active_entry.bits[19:15],
        rs1_data   : csru_read_data               ,
        can_intr   : 0                            , // 当面は割り込みなし
        rdata      : csru_result                  ,
        mode       : csru_priv_mode               ,
        raise_trap : csru_raise_trap              ,
        trap_vector: csru_trap_vector             ,
        trap_return: csru_trap_return             ,
        minstret                                  ,
        led                                       ,
        aclint                                    ,
    );

    ///////////////////////////////// EX Stage (Issue / Completion) /////////////////////////////////

    let csru_sources_ready: logic = (!csru_rdata.uses_rs1 || !prf_busy[csru_rdata.rs1_preg])
        && (!csru_rdata.uses_rs2 || !prf_busy[csru_rdata.rs2_preg]);

    always_comb {
        memu_load_blocked  = memu_operand_pending && memu_operand_blocked;
        memu_forward_valid = memu_operand_pending && memu_operand_forward_valid;
        memu_forward_data  = memu_operand_forward_data;

        // LoadはStoreより前にある範囲で、最古のready命令を実行する。
        memu_operand_capture = memu_rvalid && memu_rdata.ctrl.is_load && !memu_active_valid && !memu_operand_pending
            && !storebuf_commit_busy && !control_hazard;
        memu_start           = memu_operand_pending && memu_operand_entry.ctrl.is_load && !memu_load_blocked
            && !memu_active_valid && !storebuf_commit_busy && !branch_redirect && !csr_redirect;
        // 完全にStore Bufferから転送できるLoadはmemunitを起動しない。
        memu_grant        = memu_active_valid || (memu_start && !memu_forward_valid);
        memu_kill         = csr_redirect
            || (branch_redirect && memu_active_valid && (memu_active_entry.rob_tag - redirect_head_tag)
                >: (redirect_tag - redirect_head_tag));
        memu_operand_kill = csr_redirect
            || (branch_redirect && memu_operand_pending && (memu_operand_entry.rob_tag - redirect_head_tag)
                >: (redirect_tag - redirect_head_tag));
        memu_drop_done    = memu_active_valid && memu_killed && !memu_stall;
        // MDUはMDUがidleなら実行開始・継続
        // 分岐回復と同じcycleに発行すると、queueから消えたyoung命令が
        // MDUへ入ってしまうため、回復完了後のcycleで再発行する。
        mdu_grant = mdu_rvalid && mdu_ready && !mdu_busy && !branch_redirect && !csr_redirect;
        mdu_kill  = csr_redirect
            || (branch_redirect && mdu_busy && (mdu_active_entry.rob_tag - redirect_head_tag)
                >: (redirect_tag - redirect_head_tag));
        // CSRはROB先頭かつoperand readyなら実行
        csru_issue = csru_at_head && csru_sources_ready && !csru_active_valid && !control_hazard;
        csru_grant = csru_active_valid && !control_hazard;
        // ALUは(fence_iでないまたはROB先頭)かつoperand readyなら実行開始・継続
        alu_grant = alu_rvalid && (!alu_is_fence_i || alu_at_head) && !control_hazard;
    }

    always_comb {
        alu_complete          = alu_grant;
        mdu_complete          = mdu_busy && mdu_result_valid && !mdu_kill;
        memu_forward_complete = memu_start && memu_forward_valid;
        memu_complete         = (memu_active_valid && !memu_killed && !memu_stall) || memu_forward_complete
            || storebuf_wvalid;
        csru_complete         = csru_grant;
    }

    always_comb {
        // MEM -> WB
        alu_rready = alu_grant;
        mdu_rready = mdu_grant;
        // killedなLoadも、応答を受け取ったらmemory queueから取り除く。
        // ただしmemu_completeには含めず、ROB/PRFへは反映しない。
        memu_rready = memu_complete || memu_drop_done;
        csru_rready = csru_issue;

        storebuf_wvalid = memu_rvalid && inst_is_store(memu_rdata.ctrl) && storebuf_wready && !memu_active_valid
            && !memu_operand_pending && !branch_redirect && !csr_redirect;

        memu_write_valid = memu_complete && memu_exec_entry.ctrl.is_load && memu_exec_entry.bits[11:7] != 0;
        memu_write_addr  = memu_exec_entry.rd_preg;
        memu_write_data  = if memu_forward_complete ? memu_forward_data : memu_result;

        csru_write_valid = csru_complete && csru_active_entry.ctrl.rwb_en && csru_active_entry.bits[11:7] != 0;
        csru_write_addr  = csru_active_entry.rd_preg;
        csru_write_data  = csru_result;

        mdu_write_valid = mdu_complete && mdu_active_entry.ctrl.rwb_en && mdu_active_entry.bits[11:7] != 0;
        mdu_write_addr  = mdu_active_entry.rd_preg;
        mdu_write_data  = mdu_result;

        alu_complete_data.addr       = alu_rdata.addr;
        alu_complete_data.bits       = alu_rdata.bits;
        alu_complete_data.ctrl       = alu_rdata.ctrl;
        alu_complete_data.rd_areg    = alu_rdata.bits[11:7];
        alu_complete_data.rd_preg    = alu_rdata.rd_preg;
        alu_complete_data.old_preg   = alu_rdata.old_preg;
        alu_complete_data.result     = alu_writeback_data;
        alu_complete_data.expt       = alu_rdata.expt;
        alu_complete_data.raise_trap = 0;

        memu_complete_data.addr       = memu_exec_entry.addr;
        memu_complete_data.bits       = memu_exec_entry.bits;
        memu_complete_data.ctrl       = memu_exec_entry.ctrl;
        memu_complete_data.rd_areg    = memu_exec_entry.bits[11:7];
        memu_complete_data.rd_preg    = memu_exec_entry.rd_preg;
        memu_complete_data.old_preg   = memu_exec_entry.old_preg;
        memu_complete_data.result     = memu_write_data;
        memu_complete_data.expt       = memu_exec_entry.expt;
        memu_complete_data.raise_trap = 0;

        mdu_complete_data.addr       = mdu_active_entry.addr;
        mdu_complete_data.bits       = mdu_active_entry.bits;
        mdu_complete_data.ctrl       = mdu_active_entry.ctrl;
        mdu_complete_data.rd_areg    = mdu_active_entry.bits[11:7];
        mdu_complete_data.rd_preg    = mdu_active_entry.rd_preg;
        mdu_complete_data.old_preg   = mdu_active_entry.old_preg;
        mdu_complete_data.result     = mdu_result;
        mdu_complete_data.expt       = mdu_active_entry.expt;
        mdu_complete_data.raise_trap = 0;

        csru_complete_data.addr       = csru_active_entry.addr;
        csru_complete_data.bits       = csru_active_entry.bits;
        csru_complete_data.ctrl       = csru_active_entry.ctrl;
        csru_complete_data.rd_areg    = csru_active_entry.bits[11:7];
        csru_complete_data.rd_preg    = csru_active_entry.rd_preg;
        csru_complete_data.old_preg   = csru_active_entry.old_preg;
        csru_complete_data.result     = csru_result;
        csru_complete_data.expt       = csru_active_entry.expt;
        csru_complete_data.raise_trap = csru_raise_trap && !csru_trap_return;
    }

    // 実行結果をラッチし、次cycleにfrontend redirect/backend recoveryを行う。
    // これにより、分岐のALU結果が同じcycleのdispatch queue更新まで伝播しない。
    always_ff {
        if_reset {
            redirect_pending    = 0;
            redirect_is_branch  = 0;
            redirect_is_csr     = 0;
            redirect_is_fence_i = 0;
            redirect_pc         = 0;
            redirect_tag        = 0;
            redirect_head_tag   = 0;
        } else {
            redirect_pending    = 0;
            redirect_is_branch  = 0;
            redirect_is_csr     = 0;
            redirect_is_fence_i = 0;

            if alu_complete && alu_mispredict {
                redirect_pending   = 1;
                redirect_is_branch = alu_is_br;
                redirect_pc        = alu_recovery_pc;
                redirect_tag       = alu_rdata.rob_tag;
                redirect_head_tag  = rob_head_tag;
            } else if csru_complete && csru_raise_trap {
                redirect_pending  = 1;
                redirect_is_csr   = 1;
                redirect_pc       = csru_trap_vector;
                redirect_tag      = rob_head_tag;
                redirect_head_tag = rob_head_tag;
            } else if alu_complete && alu_is_fence_i {
                redirect_pending    = 1;
                redirect_is_fence_i = 1;
                redirect_pc         = alu_next_pc;
                redirect_tag        = alu_rdata.rob_tag;
                redirect_head_tag   = rob_head_tag;
            }
        }
    }

    always_comb {
        // alu_redirectは当cycleの実行結果、他のredirectは次cycleの処理要求。
        alu_redirect    = alu_complete && alu_mispredict;
        branch_redirect = redirect_pending && redirect_is_branch;
        csr_redirect    = redirect_pending && redirect_is_csr;
        fencei_redirect = redirect_pending && redirect_is_fence_i;

        control_hazard         = redirect_pending;
        backend_redirect       = branch_redirect || csr_redirect;
        control_hazard_pc_next = redirect_pc;
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    always_ff {
        if_reset {
            minstret = 0;
        } else {
            if rob_commit_valid && rob_commit_ready && !rob_commit_data.raise_trap {
                minstret += 1;
            }
        }
    }
    always_ff {
        if_reset {
            branch_pending = 0;
            branch_rob_tag = 0;
        } else if alu_complete && alu_is_br {
            branch_pending = 0;
        } else if ids_fire && inst_is_br(ids_ctrl) {
            branch_pending = 1;
            branch_rob_tag = rob_allocate_tag;
        }
    }

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_commit_valid && rob_commit_ready && rob_commit_data.ctrl.rwb_en
        && rob_commit_data.rd_areg != 0 && !rob_commit_data.raise_trap;

    always_ff {
        // ROB先頭が完成済み & コミットが成立 & レジスタ書込み命令 & x0ではない & trapではない
        if rob_commit_fire {
            regfile[rob_commit_data.rd_areg] = rob_commit_data.result;
        }
    }
    // serial_pending := 制御結果がまだ確定していない命令が存在する
    always_ff {
        if_reset {
            serial_pending = 0;
        } else if control_hazard {
            serial_pending = 0;
        } else if alu_complete && (alu_is_jalr || alu_is_fence_i) || csru_complete {
            serial_pending = 0;
        } else if ids_fire && (ids_is_jalr || ids_ctrl.is_csr || ids_is_fence_i) {
            serial_pending = 1;
        }
    }

    always_comb {
        // WB -> END
        rob_commit_ready   = !rob_rollback_busy
            && (!rob_commit_valid || !inst_is_store(rob_commit_data.ctrl) || storebuf_commit_done);
        rob_rollback_ready = !rob_rollback_data.ctrl.rwb_en || rob_rollback_data.rd_areg == 0 || flist_wready;
        rollback_fire      = rob_rollback_valid && rob_rollback_ready;
        rollback_reg_fire  = rollback_fire && rob_rollback_data.ctrl.rwb_en && rob_rollback_data.rd_areg != 0;

        storebuf_commit_valid = rob_commit_valid && inst_is_store(rob_commit_data.ctrl) && storebuf_head_valid
            && storebuf_head_tag == rob_head_tag && !storebuf_commit_busy && !rob_rollback_busy && !memu_grant
            && !branch_redirect && !csr_redirect;

        flist_wvalid = rollback_reg_fire || rob_commit_fire;
        flist_wdata  = if rollback_reg_fire ? rob_rollback_data.rd_preg : rob_commit_data.old_preg;
    }

    ///////////////////////////////// Pipeline trace /////////////////////////////////

    #[ifdef(LOG_PIPELINE)]
    {
        var trace_cycle: u64;
        always_ff {
            if_reset {
                trace_cycle = 0;
                $display("KTRACE\t1");
            } else {
                // Each line records only information available at this point.
                // test/konata.py assigns dynamic instruction IDs and resolves flushes.
                if ids_fire {
                    $display("K\t%0d\tX\t%h\t%h\t%b", trace_cycle, ids_pc, ids_inst_bits, ids_ctrl.itype);
                }
                if rob_allocate_valid && rob_allocate_ready {
                    $display(
                        "K\t%0d\tA\t%0d\t%h\t%h\t%b",
                        trace_cycle,
                        rob_allocate_tag,
                        ids_pc,
                        ids_inst_bits,
                        ids_is_load || ids_is_store,
                    );
                    if ids_writes_rd {
                        $display("N\t%0d\tx%0d<-p%0d old=p%0d", trace_cycle, ids_rd_areg, ids_new_preg, ids_old_preg);
                    }
                }
                if alu_complete {
                    $display("K\t%0d\tC\t%0d", trace_cycle, alu_rdata.rob_tag);
                    if alu_is_br {
                        $display(
                            "B\t%0d\t%h\tp%0d=%h\tp%0d=%h\ttake=%b\tpred=%b",
                            trace_cycle,
                            alu_rdata.addr,
                            alu_rdata.rs1_preg,
                            alu_read1_data,
                            alu_rdata.rs2_preg,
                            alu_read2_data,
                            alu_br_take,
                            alu_rdata.pred_taken,
                        );
                    }
                }
                if memu_complete {
                    $display("K\t%0d\tC\t%0d", trace_cycle, memu_rdata.rob_tag);
                }
                if mdu_complete {
                    $display("K\t%0d\tC\t%0d", trace_cycle, mdu_active_entry.rob_tag);
                }
                if csru_complete {
                    $display("K\t%0d\tC\t%0d", trace_cycle, csru_active_entry.rob_tag);
                }
                if rob_commit_fire {
                    $display(
                        "K\t%0d\tW\t%0d\t%h\t%h",
                        trace_cycle,
                        rob_head_tag,
                        rob_commit_data.addr,
                        rob_commit_data.bits,
                    );
                }
                if control_hazard {
                    $display(
                        "K\t%0d\tR\tMEM\t%h\t%h\t%h",
                        trace_cycle,
                        mems_pc,
                        mems_inst_bits,
                        control_hazard_pc_next,
                    );
                } else if prediction_redirect {
                    $display("K\t%0d\tR\tPRED\t%h\t%h\t%h", trace_cycle, ids_pc, ids_inst_bits, ids_pred_target);
                }
                trace_cycle += 1;
            }
        }
    }

    ///////////////////////////////// Bimodal & BTB/////////////////////////////////

    inst bp: bimodal_predictor (
        clk  ,
        rst  ,

        predict_pc   : ids_pc            ,
        predict_taken: bimodal_pred_taken,
        predict_valid: bimodal_pred_valid,

        update_valid: alu_rvalid && alu_rready && inst_is_br(alu_rdata.ctrl),
        update_pc   : alu_rdata.addr                                        ,
        update_taken: alu_br_take                                           ,
    );

    inst btb: branch_target_buffer (
        clk  ,
        rst  ,

        predict_pc    : ids_pc    ,
        predict_hit   : btb_hit   ,
        predict_target: btb_target,

        update_valid : alu_rvalid && alu_rready && alu_is_jalr,
        update_pc    : alu_rdata.addr                         ,
        update_target: alu_jalr_target                        ,
    );

    ///////////////////////////////// FIFO /////////////////////////////////

    inst aluq: issue_queue (
        clk                ,
        rst                ,
        flush: csr_redirect,

        squash     : branch_redirect  ,
        squash_head: redirect_head_tag,
        squash_tag : redirect_tag     ,

        wvalid   : alu_wvalid   ,
        wready   : alu_wready   ,
        wdata    : alu_wdata    ,
        wrs1ready: alu_wrs1ready,
        wrs2ready: alu_wrs2ready,

        wakeup0_valid: alu_write_valid ,
        wakeup0_preg : alu_write_addr  ,
        wakeup1_valid: memu_write_valid,
        wakeup1_preg : memu_write_addr ,
        wakeup2_valid: mdu_write_valid ,
        wakeup2_preg : mdu_write_addr  ,
        wakeup3_valid: csru_write_valid,
        wakeup3_preg : csru_write_addr ,

        rvalid: alu_rvalid,
        rready: alu_rready,
        rdata : alu_rdata ,
    );

    inst memq: memory_queue (
        clk                ,
        rst                ,
        flush: csr_redirect,

        squash     : branch_redirect  ,
        squash_head: redirect_head_tag,
        squash_tag : redirect_tag     ,

        wready: memu_wready,
        wvalid: memu_wvalid,
        wdata : memu_wdata ,

        wrs1ready: memu_wrs1ready,
        wrs2ready: memu_wrs2ready,

        wakeup0_valid: alu_write_valid ,
        wakeup0_preg : alu_write_addr  ,
        wakeup1_valid: memu_write_valid,
        wakeup1_preg : memu_write_addr ,
        wakeup2_valid: mdu_write_valid ,
        wakeup2_preg : mdu_write_addr  ,
        wakeup3_valid: csru_write_valid,
        wakeup3_preg : csru_write_addr ,

        lock_valid: memu_active_valid        ,
        lock_tag  : memu_active_entry.rob_tag,

        rready: memu_rready,
        rvalid: memu_rvalid,
        rdata : memu_rdata ,
    );

    inst storebuf: store_buffer (
        clk                ,
        rst                ,
        flush: csr_redirect,

        squash     : branch_redirect  ,
        squash_head: redirect_head_tag,
        squash_tag : redirect_tag     ,

        wvalid  : storebuf_wvalid,
        wready  : storebuf_wready,
        wdata   : memu_rdata     ,
        rs1_data: memu_read1_data,
        rs2_data: memu_read2_data,

        load_check_valid  : memu_operand_capture || memu_operand_recheck,
        load_addr         : if memu_operand_recheck ? memu_load_addr : memu_read1_data + memu_rdata.imm,
        load_funct3       : if memu_operand_recheck ? memu_operand_entry.ctrl.funct3 : memu_rdata.ctrl.funct3,
        load_blocked      : storebuf_load_blocked                                                            ,
        load_forward_valid: storebuf_forward_valid                                                           ,
        load_forward_data : storebuf_forward_data                                                            ,

        commit_valid: storebuf_commit_valid,
        commit_allow: !rob_rollback_busy   ,
        commit_done : storebuf_commit_done ,
        commit_busy : storebuf_commit_busy ,
        head_valid  : storebuf_head_valid  ,
        head_tag    : storebuf_head_tag    ,

        membus: storebuf_bus,
    );

    inst muldivq: issue_queue (
        clk                ,
        rst                ,
        flush: csr_redirect,

        squash     : branch_redirect  ,
        squash_head: redirect_head_tag,
        squash_tag : redirect_tag     ,

        wvalid   : mdu_wvalid   ,
        wready   : mdu_wready   ,
        wdata    : mdu_wdata    ,
        wrs1ready: mdu_wrs1ready,
        wrs2ready: mdu_wrs2ready,

        wakeup0_valid: alu_write_valid ,
        wakeup0_preg : alu_write_addr  ,
        wakeup1_valid: memu_write_valid,
        wakeup1_preg : memu_write_addr ,
        wakeup2_valid: mdu_write_valid ,
        wakeup2_preg : mdu_write_addr  ,
        wakeup3_valid: csru_write_valid,
        wakeup3_preg : csru_write_addr ,

        rvalid: mdu_rvalid,
        rready: mdu_rready,
        rdata : mdu_rdata ,
    );

    inst csrq: fifo #(
        DATA_TYPE    : euq_type,
        WIDTH        : 3       ,
        ALLOW_REPLACE: 0       ,
    ) (
        clk                     ,
        rst                     ,
        flush : backend_redirect,
        wready: csru_wready     ,
        wvalid: csru_wvalid     ,
        wdata : csru_wdata      ,
        rready: csru_rready     ,
        rvalid: csru_rvalid     ,
        rdata : csru_rdata      ,
    );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk  ,
        rst  ,
        // トラップはROB先頭でのみ受理するため、ここで全破棄できる
        flush: csr_redirect,

        rollback_start: branch_redirect   ,
        rollback_tag  : redirect_tag      ,
        rollback_valid: rob_rollback_valid,
        rollback_ready: rob_rollback_ready,
        rollback_data : rob_rollback_data ,
        rollback_busy : rob_rollback_busy ,

        allocate_valid: rob_allocate_valid,
        allocate_ready: rob_allocate_ready,
        allocate_done : rob_allocate_done ,
        allocate_data : rob_allocate_data ,
        allocate_tag  : rob_allocate_tag  ,

        complete0_valid: alu_complete     ,
        complete0_tag  : alu_rdata.rob_tag,
        complete0_data : alu_complete_data,

        complete1_valid: memu_complete          ,
        complete1_tag  : memu_exec_entry.rob_tag,
        complete1_data : memu_complete_data     ,

        complete2_valid: mdu_complete            ,
        complete2_tag  : mdu_active_entry.rob_tag,
        complete2_data : mdu_complete_data       ,

        complete3_valid: csru_complete            ,
        complete3_tag  : csru_active_entry.rob_tag,
        complete3_data : csru_complete_data       ,

        commit_valid: rob_commit_valid,
        commit_ready: rob_commit_ready,
        commit_data : rob_commit_data ,

        head_valid: rob_head_valid,
        head_tag  : rob_head_tag  ,
    );

    inst flist: free_list (
        clk                     ,
        rst                     ,
        checkpoint: 0           ,
        restore   : 0           ,
        rready    : flist_rready,
        rvalid    : flist_rvalid,
        rdata     : flist_rdata ,
        wready    : flist_wready,
        wvalid    : flist_wvalid,
        wdata     : flist_wdata ,
    );

    inst rat: register_alias_table (
        clk                         ,
        rst                         ,
        flush      : rat_flush      ,
        checkpoint : 0              ,
        restore    : 0              ,
        read1_addr : rat_read1_addr ,
        read1_data : rat_read1_data ,
        read2_addr : rat_read2_addr ,
        read2_data : rat_read2_data ,
        write_valid: rat_write_valid,
        write_addr : rat_write_addr ,
        write_data : rat_write_data ,
        write_old  : rat_write_old  ,
    );

    inst prf: physical_register_file (
        clk                           ,
        rst                           ,
        read1_addr  : alu_read1_addr  ,
        read1_data  : alu_read1_data  ,
        read2_addr  : alu_read2_addr  ,
        read2_data  : alu_read2_data  ,
        read3_addr  : memu_read1_addr ,
        read3_data  : memu_read1_data ,
        read4_addr  : memu_read2_addr ,
        read4_data  : memu_read2_data ,
        read5_addr  : mdu_read1_addr  ,
        read5_data  : mdu_read1_data  ,
        read6_addr  : mdu_read2_addr  ,
        read6_data  : mdu_read2_data  ,
        read7_addr  : csru_read_addr  ,
        read7_data  : csru_read_data  ,
        write1_valid: csru_write_valid,
        write1_addr : csru_write_addr ,
        write1_data : csru_write_data ,
        write2_valid: memu_write_valid,
        write2_addr : memu_write_addr ,
        write2_data : memu_write_data ,
        write3_valid: mdu_write_valid ,
        write3_addr : mdu_write_addr  ,
        write3_data : mdu_write_data  ,
        write4_valid: alu_write_valid ,
        write4_addr : alu_write_addr  ,
        write4_data : alu_write_data  ,
    );
}
