import eei::*;
import corectrl::*;

module core (
    clk     : input   clock               ,
    rst     : input   reset               ,
    i_membus: modport core_inst_if::master,
    d_membus: modport core_data_if::master,
    led     : output  UIntX               ,
    aclint  : modport aclint_if::slave    ,
) {
    struct exq_type {
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        pred_taken : logic        ,
        pred_target: Addr         ,
        rs1_preg   : PhysReg      ,
        rs2_preg   : PhysReg      ,
        rd_preg    : PhysReg      ,
        rd_old_preg: PhysReg      ,
    }

    struct euq_type {
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        pred_taken : logic        ,
        pred_target: Addr         ,
        rs1_preg   : PhysReg      ,
        rs2_preg   : PhysReg      ,
        rd_preg    : PhysReg      ,
        old_preg   : PhysReg      ,
        rob_tag    : RobTag       ,
        uses_rs1   : logic        ,
        uses_rs2   : logic        ,
    }

    struct memq_type {
        rob_tag    : RobTag       ,
        addr       : Addr         ,
        bits       : Inst         ,
        ctrl       : InstCtrl     ,
        imm        : UIntX        ,
        expt       : ExceptionInfo,
        alu_result : UIntX        ,
        rs1_areg   : ArchReg      ,
        rs1_data   : UIntX        ,
        rs2_data   : UIntX        ,
        br_taken   : logic        ,
        jump_addr  : Addr         ,
        pred_taken : logic        ,
        pred_target: Addr         ,
    }

    struct rob_entry_type {
        addr      : Addr         ,
        bits      : Inst         ,
        ctrl      : InstCtrl     ,
        rd_areg   : ArchReg      ,
        old_preg  : PhysReg      ,
        result    : UIntX        ,
        expt      : ExceptionInfo,
        raise_trap: logic        ,
    }

    // (EX, MEM) -> WB の Reorder Buffer
    var rob_allocate_valid: logic         ;
    var rob_allocate_ready: logic         ;
    var rob_allocate_done : logic         ;
    var rob_allocate_data : rob_entry_type;
    var rob_allocate_tag  : RobTag        ;

    var rob_complete_valid: logic         ;
    var rob_complete_tag  : RobTag        ;
    var rob_complete_data : rob_entry_type;

    var rob_commit_valid: logic         ;
    var rob_commit_ready: logic         ;
    var rob_commit_data : rob_entry_type;

    var rob_head_valid: logic ;
    var rob_head_tag  : RobTag;

    ///////////////////////////////// IF Stage /////////////////////////////////

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;
    var fencei_redirect       : logic;

    var prediction_redirect: logic;
    var ids_imm            : UIntX;
    var ids_pred_target    : Addr ;

    let frontend_redirect: logic = control_hazard || fencei_redirect || prediction_redirect;
    var aluq_next_pc     : Addr ;
    always_comb {
        i_membus.is_redirect = frontend_redirect;

        if control_hazard {
            i_membus.next_pc = control_hazard_pc_next;
        } else if fencei_redirect {
            i_membus.next_pc = aluq_next_pc;
        } else {
            i_membus.next_pc = ids_pred_target;
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_valid     = i_membus.rvalid;
    let ids_inst_bits = i_membus.rdata;

    let ids_fire      : logic         = !control_hazard && i_membus.rvalid && i_membus.rready;
    var ids_inst_valid: logic        ;
    var ids_ctrl      : InstCtrl     ;
    var ids_expt      : ExceptionInfo;

    var bimodal_pred_taken: logic;
    var bimodal_pred_valid: logic;

    let ids_btfnt_taken      : logic = ids_imm[msb]; // 負のoffsetならbackward
    let ids_branch_pred_taken: logic = if bimodal_pred_valid ? bimodal_pred_taken : ids_btfnt_taken;

    var btb_hit   : logic;
    var btb_target: Addr ;

    let ids_is_jal : logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::J;
    let ids_is_jalr: logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::I;

    let ids_pred_taken: logic = ids_inst_valid
        && (ids_is_jal || (ids_is_jalr && btb_hit) || (inst_is_br(ids_ctrl) && ids_branch_pred_taken));

    let ids_pc: Addr = i_membus.raddr;

    always_comb {
        prediction_redirect = !control_hazard && ids_fire && ids_pred_taken;
        ids_pred_target     = if ids_is_jalr ? btb_target : ids_pc + ids_imm;
    }

    inst decoder: inst_decoder (
        bits  : ids_inst_bits  ,
        is_rvc: i_membus.is_rvc,
        valid : ids_inst_valid ,
        ctrl  : ids_ctrl       ,
        imm   : ids_imm        ,
    );

    var flist_rready: logic  ;
    var flist_rvalid: logic  ;
    var flist_rdata : PhysReg;
    var flist_wready: logic  ;
    var flist_wvalid: logic  ;
    var flist_wdata : PhysReg;

    let ids_uses_rs1: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::I: if ids_ctrl.is_csr ? ids_ctrl.funct3[1:0] != 0 && !ids_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_uses_rs2: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_rd_areg   : ArchReg = ids_inst_bits[11:7];
    let ids_rs1_areg  : ArchReg = ids_inst_bits[19:15];
    let ids_rs2_areg  : ArchReg = ids_inst_bits[24:20];
    let ids_writes_rd : logic   = ids_ctrl.rwb_en && ids_rd_areg != 0;
    let ids_preg_ready: logic   = !ids_writes_rd || flist_rvalid;

    var rat_read1_data : PhysReg;
    var rat_read2_data : PhysReg;
    var rat_read1_addr : ArchReg;
    var rat_read2_addr : ArchReg;
    var rat_write_old  : PhysReg;
    var rat_write_valid: logic  ;
    var rat_write_addr : ArchReg;
    var rat_write_data : PhysReg;

    var rat_flush: logic;

    let ids_new_preg: PhysReg = flist_rdata;
    let ids_old_preg: PhysReg = rat_write_old;

    let rename_fire: logic = ids_fire && ids_writes_rd;

    always_comb {
        flist_rready = rename_fire;

        rat_read1_addr = ids_rs1_areg;
        rat_read2_addr = ids_rs2_areg;

        rat_write_valid = rename_fire;
        rat_write_addr  = ids_rd_areg;
        rat_write_data  = ids_new_preg;

        rat_flush = control_hazard;
    }

    var csru_priv_mode: PrivMode;

    var prf_busy: logic [PREG_COUNT];

    var alu_read1_addr : PhysReg;
    var alu_read1_data : UIntX  ;
    var alu_read2_addr : PhysReg;
    var alu_read2_data : UIntX  ;
    var memu_read1_addr: PhysReg;
    var memu_read1_data: UIntX  ;
    var memu_read2_addr: PhysReg;
    var memu_read2_data: UIntX  ;
    var mdu_read1_addr : PhysReg;
    var mdu_read1_data : UIntX  ;
    var mdu_read2_addr : PhysReg;
    var mdu_read2_data : UIntX  ;
    var csru_read_addr : PhysReg;
    var csru_read_data : UIntX  ;

    var alu_write_valid : logic  ;
    var alu_write_addr  : PhysReg;
    var alu_write_data  : UIntX  ;
    var memu_write_valid: logic  ;
    var memu_write_addr : PhysReg;
    var memu_write_data : UIntX  ;
    var mdu_write_valid : logic  ;
    var mdu_write_addr  : PhysReg;
    var mdu_write_data  : UIntX  ;
    var csru_write_valid: logic  ;
    var csru_write_addr : PhysReg;
    var csru_write_data : UIntX  ;

    var aluq_wready  : logic   ;
    var aluq_wvalid  : logic   ;
    var aluq_rready  : logic   ;
    var aluq_rvalid  : logic   ;
    var aluq_wdata   : euq_type;
    var aluq_rdata   : euq_type;
    var aluq_grant   : logic   ;
    var aluq_done    : logic   ;
    var aluq_complete: logic   ;

    var memq_wready  : logic   ;
    var memq_wvalid  : logic   ;
    var memq_rready  : logic   ;
    var memq_rvalid  : logic   ;
    var memq_wdata   : euq_type;
    var memq_rdata   : euq_type;
    var memq_grant   : logic   ;
    var memq_done    : logic   ;
    var memq_complete: logic   ;

    var mduq_wready  : logic   ;
    var mduq_wvalid  : logic   ;
    var mduq_rready  : logic   ;
    var mduq_rvalid  : logic   ;
    var mduq_wdata   : euq_type;
    var mduq_rdata   : euq_type;
    var mduq_grant   : logic   ;
    var mduq_done    : logic   ;
    var mduq_complete: logic   ;

    var csrq_wready  : logic   ;
    var csrq_wvalid  : logic   ;
    var csrq_rready  : logic   ;
    var csrq_rvalid  : logic   ;
    var csrq_wdata   : euq_type;
    var csrq_rdata   : euq_type;
    var csrq_grant   : logic   ;
    var csrq_done    : logic   ;
    var csrq_complete: logic   ;

    always_ff {
        if_reset {
            for i in 0..PREG_COUNT {
                prf_busy[i] = 0;
            }
        } else {
            // 実行完了を先に反映
            if alu_write_valid {
                prf_busy[alu_write_addr] = 0;
            }
            if memu_write_valid {
                prf_busy[memu_write_addr] = 0;
            }
            if mdu_write_valid {
                prf_busy[mdu_write_addr] = 0;
            }
            if csru_write_valid {
                prf_busy[csru_write_addr] = 0;
            }

            // 新規割当
            if rename_fire {
                prf_busy[ids_new_preg] = 1;
            }
        }
    }

    // dispatch: 命令種別に応じて該当キューに格納
    let ids_is_alu    : logic = !inst_is_memop(ids_ctrl) && !ids_ctrl.is_muldiv && !ids_ctrl.is_csr;
    let ids_is_load   : logic = ids_ctrl.is_load;
    let ids_is_store  : logic = inst_is_store(ids_ctrl);
    let ids_is_muldiv : logic = ids_ctrl.is_muldiv;
    let ids_is_csr    : logic = ids_ctrl.is_csr;
    let ids_is_fence_i: logic = ids_inst_bits[6:0] == OP_MISC_MEM && ids_inst_bits[14:12] == 3'b001;

    var dispatch_data: euq_type;

    // 未解決の直列化命令がROB/MEM内にある
    var serial_pending: logic;

    always_comb {
        // ID rready: 該当キューが空き + ROB 空き
        let ids_target_ready: logic = switch {
            ids_is_alu   : aluq_wready,
            ids_is_load  : memq_wready,
            ids_is_store : memq_wready,
            ids_is_muldiv: mduq_wready,
            ids_is_csr   : csrq_wready,
            default      : 1,
        };
        i_membus.rready = !serial_pending && rob_allocate_ready && ids_target_ready && ids_preg_ready;

        // 該当キューの wvalid / wdata を駆動
        aluq_wvalid = ids_fire && ids_is_alu && aluq_wready;
        memq_wvalid = ids_fire && (ids_is_load || ids_is_store) && memq_wready;
        mduq_wvalid = ids_fire && ids_is_muldiv && mduq_wready;
        csrq_wvalid = ids_fire && ids_is_csr && csrq_wready;

        // dispatch_data を組み立て
        dispatch_data.addr        = ids_pc;
        dispatch_data.bits        = ids_inst_bits;
        dispatch_data.ctrl        = ids_ctrl;
        dispatch_data.imm         = ids_imm;
        dispatch_data.expt        = ids_expt;
        dispatch_data.rs1_preg    = rat_read1_data;
        dispatch_data.rs2_preg    = rat_read2_data;
        dispatch_data.rd_preg     = ids_new_preg;
        dispatch_data.old_preg    = ids_old_preg;
        dispatch_data.rob_tag     = rob_allocate_tag;
        dispatch_data.pred_taken  = ids_pred_taken;
        dispatch_data.pred_target = ids_pred_target;
        dispatch_data.uses_rs1    = ids_uses_rs1;
        dispatch_data.uses_rs2    = ids_uses_rs2;

        // dispatch_data を代入
        aluq_wdata = dispatch_data;
        memq_wdata = dispatch_data;
        mduq_wdata = dispatch_data;
        csrq_wdata = dispatch_data;

        // === ROB allocate (dispatch 時) ===
        rob_allocate_valid           = ids_fire;
        rob_allocate_done            = 0;
        rob_allocate_data.addr       = ids_pc;
        rob_allocate_data.bits       = ids_inst_bits;
        rob_allocate_data.ctrl       = ids_ctrl;
        rob_allocate_data.rd_areg    = ids_rd_areg;
        rob_allocate_data.old_preg   = ids_old_preg;
        rob_allocate_data.result     = 0; // complete 時に上書き
        rob_allocate_data.expt       = ids_expt;
        rob_allocate_data.raise_trap = 0;
    }

    always_comb {
        // exception
        if !ids_inst_valid {
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            ids_expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            ids_expt.valid      = 1;
            ids_expt.cause      = CsrCause::ENVIRONMENT_CALL_FROM_U_MODE;
            ids_expt.cause[1:0] = csru_priv_mode;
            ids_expt.value      = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::BREAKPOINT;
            ids_expt.value = ids_pc;
        } else {
            ids_expt = 0;
        }
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    always_comb {
        alu_read1_addr  = aluq_rdata.rs1_preg;
        alu_read2_addr  = aluq_rdata.rs2_preg;
        memu_read1_addr = memq_rdata.rs1_preg;
        memu_read2_addr = memq_rdata.rs2_preg;
        mdu_read1_addr  = mduq_rdata.rs1_preg;
        mdu_read2_addr  = mduq_rdata.rs2_preg;
        csru_read_addr  = csrq_rdata.rs1_preg;
    }

    // レジスタ
    var regfile: UIntX<AREG_COUNT>;

    // *_grant     実行ユニットへ命令を受理させる
    // *_done      実行ユニットの処理結果が有効
    // *_complete  ROB completeポートを獲得
    // *_rready    キューから命令を取り出す

    ///////////////////////////////// EX Stage (ALU) /////////////////////////////////

    var aluq_op1: UIntX;
    var aluq_op2: UIntX;

    always_comb {
        let rs1_areg: ArchReg = aluq_rdata.bits[19:15];
        let rs2_areg: ArchReg = aluq_rdata.bits[24:20];

        case aluq_rdata.ctrl.itype {
            InstType::R, InstType::B: {
                // R-type (add, sub, and, ...) / B-type (branch)
                aluq_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                aluq_op2 = if rs2_areg == 0 ? 0 : alu_read2_data;
            }
            InstType::I, InstType::S: {
                // I-type (addi, load, store, JALR, CSR) / S-type
                aluq_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                aluq_op2 = aluq_rdata.imm;
            }
            InstType::U, InstType::J: {
                // U-type (LUI, AUIPC) / J-type (JAL)
                // op1 = PC, op2 = immediate
                aluq_op1 = aluq_rdata.addr;
                aluq_op2 = aluq_rdata.imm;
            }
            default: {
                aluq_op1 = 0;
                aluq_op2 = 0;
            }
        }

    }

    let aluq_is_fence_i: logic = aluq_rdata.bits[6:0] == OP_MISC_MEM && aluq_rdata.bits[14:12] == 3'b001;
    let aluq_at_head   : logic = rob_head_valid && rob_head_tag == aluq_rdata.rob_tag;
    assign fencei_redirect = aluq_complete && aluq_is_fence_i;

    var aluq_result: UIntX;
    inst aluq_alu: alu (
        ctrl  : aluq_rdata.ctrl,
        op1   : aluq_op1       ,
        op2   : aluq_op2       ,
        result: aluq_result    ,
    );

    let aluq_is_br  : logic = inst_is_br(aluq_rdata.ctrl);
    let aluq_is_jalr: logic = aluq_rdata.ctrl.is_jump && aluq_rdata.ctrl.itype == InstType::I;
    // let aluq_is_jal : logic = aluq_rdata.ctrl.is_jump && aluq_rdata.ctrl.itype == InstType::J;

    var aluq_br_take: logic;
    inst aluq_bru: brunit (
        funct3: aluq_rdata.ctrl.funct3,
        op1   : aluq_op1              ,
        op2   : aluq_op2              ,
        take  : aluq_br_take          ,
    );

    let aluq_mispredict: logic = aluq_rvalid
        && ((aluq_is_br && aluq_rdata.pred_taken != aluq_br_take)
            || (aluq_is_jalr && (aluq_rdata.pred_taken != 1 || aluq_rdata.pred_target != (aluq_result & ~1))));

    let aluq_writes_rd: logic = aluq_rvalid && aluq_rdata.ctrl.rwb_en && aluq_rdata.bits[11:7] != 0;

    let aluq_writeback_data: UIntX = switch {
        aluq_rdata.ctrl.is_jump: aluq_next_pc,
        aluq_rdata.ctrl.is_lui : aluq_rdata.imm,
        default                : aluq_result,
    };

    always_comb {
        aluq_next_pc = aluq_rdata.addr + (if aluq_rdata.ctrl.is_rvc ? 2 : 4);

        alu_write_valid = aluq_writes_rd && aluq_rready;
        alu_write_addr  = aluq_rdata.rd_preg;
        alu_write_data  = aluq_writeback_data;
    }

    ///////////////////////////////// EX Stage (MDU) /////////////////////////////////

    var mdu_ready : logic;
    var mdu_rvalid: logic;
    var mdu_result: UIntX;
    var mdu_busy  : logic;

    inst mdu: muldivunit (
        clk                             ,
        rst                             ,
        valid  : mduq_grant             ,
        ready  : mdu_ready              ,
        funct3 : mduq_rdata.ctrl.funct3 ,
        is_op32: mduq_rdata.ctrl.is_op32,
        op1    : mdu_read1_data         ,
        op2    : mdu_read2_data         ,
        rvalid : mdu_rvalid             ,
        result : mdu_result             ,
    );

    always_ff {
        if_reset {
            mdu_busy = 0;
        } else if control_hazard {
            mdu_busy = 0;
        } else {
            if mduq_grant {
                mdu_busy = 1;
            }
            if mduq_complete {
                mdu_busy = 0;
            }
        }
    }

    var csru_rdata      : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;
    var csru_trap_return: logic;

    ///////////////////////////////// EX Stage (MEMU) /////////////////////////////////

    let mems_valid    : logic = memq_rvalid;
    let mems_pc       : Addr  = memq_rdata.addr;
    let mems_inst_bits: Inst  = memq_rdata.bits;

    let mems_at_rob_head: logic = rob_head_valid && rob_head_tag == memq_rdata.rob_tag;

    var memu_rdata: UIntX;
    var memu_stall: logic;

    var minstret: UInt64;

    // ROB先頭命令の最初のサイクルでだけ受け付ける
    var mems_intr_checked: logic;

    always_ff {
        if_reset {
            mems_intr_checked = 0;
        } else if !mems_valid || memq_rready {
            // 空または現在の命令をMEMから取り出した
            mems_intr_checked = 0;
        } else if mems_at_rob_head {
            mems_intr_checked = 1;
        }
    }

    let memq_at_head: logic = memq_rvalid && rob_head_valid && rob_head_tag == memq_rdata.rob_tag;

    ///////////////////////////////// EX Stage (CSRU) /////////////////////////////////

    let csrq_at_head: logic = csrq_rvalid && rob_head_valid && rob_head_tag == csrq_rdata.rob_tag;
    let csrq_result : UIntX = csru_rdata;

    inst memu: memunit (
        clk   : clk                             ,
        rst   : rst                             ,
        valid : memq_grant                      ,
        ctrl  : memq_rdata.ctrl                 ,
        addr  : memu_read1_data + memq_rdata.imm,
        rs2   : memu_read2_data                 ,
        rdata : memu_rdata                      ,
        stall : memu_stall                      ,
        membus: d_membus                        ,
    );

    inst csru: csrunit (
        clk                                ,
        rst                                ,
        valid      : csrq_grant            ,
        pc         : csrq_rdata.addr       ,
        inst_bits  : csrq_rdata.bits       ,
        ctrl       : csrq_rdata.ctrl       ,
        expt_info  : csrq_rdata.expt       ,
        rd_areg    : csrq_rdata.bits[11:7] ,
        csr_addr   : csrq_rdata.bits[31:20],
        rs1_areg   : csrq_rdata.bits[19:15],
        rs1_data   : csru_read_data        ,
        can_intr   : 0                     , // 当面は割り込みなし
        rdata      : csru_rdata            ,
        mode       : csru_priv_mode        ,
        raise_trap : csru_raise_trap       ,
        trap_vector: csru_trap_vector      ,
        trap_return: csru_trap_return      ,
        minstret                           ,
        led                                ,
        aclint                             ,
    );

    ///////////////////////////////// EX Stage (Issue / Completion) /////////////////////////////////

    let aluq_sources_ready: logic = (!aluq_rdata.uses_rs1 || !prf_busy[aluq_rdata.rs1_preg])
        && (!aluq_rdata.uses_rs2 || !prf_busy[aluq_rdata.rs2_preg]);
    let csrq_sources_ready: logic = (!csrq_rdata.uses_rs1 || !prf_busy[csrq_rdata.rs1_preg])
        && (!csrq_rdata.uses_rs2 || !prf_busy[csrq_rdata.rs2_preg]);
    let memq_sources_ready: logic = (!memq_rdata.uses_rs1 || !prf_busy[memq_rdata.rs1_preg])
        && (!memq_rdata.uses_rs2 || !prf_busy[memq_rdata.rs2_preg]);
    let mduq_sources_ready: logic = (!mduq_rdata.uses_rs1 || !prf_busy[mduq_rdata.rs1_preg])
        && (!mduq_rdata.uses_rs2 || !prf_busy[mduq_rdata.rs2_preg]);

    always_comb {
        // Completion arbitration: MEM > MDU > CSR > ALU
        // MEMはROB先頭かつoperand readyなら実行開始・継続
        memq_grant = memq_at_head && memq_sources_ready;
        // MDUはMDUがidleなら実行開始・継続
        mduq_grant = mduq_rvalid && mduq_sources_ready && mdu_ready && !mdu_busy && !memq_grant;
        // CSRはROB先頭かつoperand readyなら実行
        csrq_grant = csrq_at_head && csrq_sources_ready && !mduq_grant;
        // ALUは(fence_iでないまたはROB先頭)かつoperand readyなら実行開始・継続
        aluq_grant = aluq_rvalid && aluq_sources_ready && (!aluq_is_fence_i || aluq_at_head) && !csrq_grant;
    }

    always_comb {
        // 優先順位: MEM > MDU > CSR > ALU
        memq_complete = memq_done;
        mduq_complete = mduq_done && !memq_complete;
        csrq_complete = csrq_done && !memq_complete && !mduq_complete;
        aluq_complete = aluq_done && !memq_complete && !mduq_complete && !csrq_complete;
    }

    always_comb {
        aluq_done = aluq_grant;
        csrq_done = csrq_grant;
        mduq_done = mdu_busy && mdu_rvalid;
        memq_done = memq_grant && !memu_stall;
    }

    always_comb {
        // MEM -> WB
        aluq_rready = aluq_complete;
        memq_rready = memq_complete;
        mduq_rready = mduq_complete;
        csrq_rready = csrq_complete;

        rob_complete_valid = aluq_complete || memq_complete || mduq_complete || csrq_complete;
        rob_complete_tag   = switch {
            aluq_complete: aluq_rdata.rob_tag,
            memq_complete: memq_rdata.rob_tag,
            mduq_complete: mduq_rdata.rob_tag,
            csrq_complete: csrq_rdata.rob_tag,
            default      : 0,
        };
        rob_complete_data.addr = switch {
            aluq_complete: aluq_rdata.addr,
            memq_complete: memq_rdata.addr,
            mduq_complete: mduq_rdata.addr,
            csrq_complete: csrq_rdata.addr,
            default      : 0
        };
        rob_complete_data.bits = switch {
            aluq_complete: aluq_rdata.bits,
            memq_complete: memq_rdata.bits,
            mduq_complete: mduq_rdata.bits,
            csrq_complete: csrq_rdata.bits,
            default      : 0
        };
        rob_complete_data.ctrl = switch {
            aluq_complete: aluq_rdata.ctrl,
            memq_complete: memq_rdata.ctrl,
            mduq_complete: mduq_rdata.ctrl,
            csrq_complete: csrq_rdata.ctrl,
            default      : 0
        };
        rob_complete_data.rd_areg = switch {
            aluq_complete: aluq_rdata.bits[11:7],
            memq_complete: memq_rdata.bits[11:7],
            mduq_complete: mduq_rdata.bits[11:7],
            csrq_complete: csrq_rdata.bits[11:7],
            default      : 0
        };
        rob_complete_data.old_preg = switch {
            aluq_complete: aluq_rdata.old_preg,
            memq_complete: memq_rdata.old_preg,
            mduq_complete: mduq_rdata.old_preg,
            csrq_complete: csrq_rdata.old_preg,
            default      : 0
        };
        rob_complete_data.result = switch {
            aluq_complete: aluq_writeback_data,
            memq_complete: memu_rdata,
            mduq_complete: mdu_result,
            csrq_complete: csrq_result,
            default      : 0,
        };
        rob_complete_data.expt = switch {
            aluq_complete: aluq_rdata.expt,
            memq_complete: memq_rdata.expt,
            mduq_complete: mduq_rdata.expt,
            csrq_complete: csrq_rdata.expt,
            default      : 0,
        };
        rob_complete_data.raise_trap = csrq_complete && csru_raise_trap && !csru_trap_return;

        memu_write_valid = memq_complete && memq_rdata.ctrl.is_load;
        memu_write_addr  = memq_rdata.rd_preg;
        memu_write_data  = memu_rdata;

        csru_write_valid = csrq_complete && csrq_rdata.ctrl.rwb_en && csrq_rdata.rd_preg != 0;
        csru_write_addr  = csrq_rdata.rd_preg;
        csru_write_data  = csrq_result;

        mdu_write_valid = mduq_complete && mduq_rdata.ctrl.rwb_en && mduq_rdata.rd_preg != 0;
        mdu_write_addr  = mduq_rdata.rd_preg;
        mdu_write_data  = mdu_result;
    }

    always_comb {
        let csr_control_hazard: logic = csrq_complete && csru_raise_trap;
        control_hazard     = (aluq_complete && aluq_mispredict) || csr_control_hazard;
        let aluq_recovery_pc  : Addr = switch {
            aluq_is_jalr: (aluq_result & ~1),
            aluq_br_take: (aluq_rdata.addr + aluq_rdata.imm),
            default     : (aluq_rdata.addr + (if aluq_rdata.ctrl.is_rvc ? 2 : 4))
        };
        control_hazard_pc_next = if csr_control_hazard ? csru_trap_vector : aluq_recovery_pc;
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    // let wbs_valid  : logic    = rob_commit_valid;
    // let wbs_ctrl   : InstCtrl = rob_commit_data.ctrl;
    // let wbs_rd_areg: ArchReg  = rob_commit_data.rd_areg;
    // let wbs_wb_data: UIntX    = rob_commit_data.result;

    always_ff {
        if_reset {
            minstret = 0;
        } else {
            if rob_commit_valid && rob_commit_ready && !rob_commit_data.raise_trap {
                minstret += 1;
            }
        }
    }

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_commit_valid && rob_commit_ready && rob_commit_data.ctrl.rwb_en
        && rob_commit_data.rd_areg != 0 && !rob_commit_data.raise_trap;

    always_ff {
        // ROB先頭が完成済み & コミットが成立 & レジスタ書込み命令 & x0ではない & trapではない
        if rob_commit_fire {
            regfile[rob_commit_data.rd_areg] = rob_commit_data.result;
        }
    }
    // serial_pending := 制御結果がまだ確定していない命令が存在する
    always_ff {
        if_reset {
            serial_pending = 0;
        } else if control_hazard {
            serial_pending = 0;
        } else if aluq_complete && (aluq_rdata.ctrl.is_jump || inst_is_br(aluq_rdata.ctrl) || aluq_is_fence_i)
            || csrq_complete {
            serial_pending = 0;
        } else if ids_fire && (ids_ctrl.is_jump || inst_is_br(ids_ctrl) || ids_ctrl.is_csr || ids_is_fence_i) {
            serial_pending = 1;
        }
    }

    always_comb {
        // WB -> END
        rob_commit_ready = 1;

        flist_wvalid = rob_commit_fire;
        flist_wdata  = rob_commit_data.old_preg;
    }

    ///////////////////////////////// Pipeline trace /////////////////////////////////

    #[ifdef(LOG_PIPELINE)]
    {
        var trace_cycle: u64;
        always_ff {
            if_reset {
                trace_cycle = 0;
                $display("KTRACE\t1");
            } else {
                // Each line records only information available at this point.
                // test/konata.py assigns dynamic instruction IDs and resolves flushes.
                if ids_fire {
                    $display("K\t%0d\tX\t%h\t%h\t%b", trace_cycle, ids_pc, ids_inst_bits, ids_ctrl.itype);
                }
                // if rob_allocate_fire {
                //     $display(
                //         "K\t%0d\tA\t%0d\t%h\t%h\t%b",
                //         trace_cycle,
                //         rob_allocate_tag,
                //         exs_pc,
                //         exs_inst_bits,
                //         exs_needs_mem,
                //     );
                // }
                if rob_complete_valid {
                    $display("K\t%0d\tC\t%0d", trace_cycle, rob_complete_tag);
                }
                if rob_commit_fire {
                    $display(
                        "K\t%0d\tW\t%0d\t%h\t%h",
                        trace_cycle,
                        rob_head_tag,
                        rob_commit_data.addr,
                        rob_commit_data.bits,
                    );
                }
                if control_hazard {
                    $display(
                        "K\t%0d\tR\tMEM\t%h\t%h\t%h",
                        trace_cycle,
                        mems_pc,
                        mems_inst_bits,
                        control_hazard_pc_next,
                    );
                } else if prediction_redirect {
                    $display("K\t%0d\tR\tPRED\t%h\t%h\t%h", trace_cycle, ids_pc, ids_inst_bits, ids_pred_target);
                }
                trace_cycle += 1;
            }
        }
    }

    ///////////////////////////////// Bimodal & BTB/////////////////////////////////

    inst bp: bimodal_predictor (
        clk  ,
        rst  ,

        predict_pc   : ids_pc            ,
        predict_taken: bimodal_pred_taken,
        predict_valid: bimodal_pred_valid,

        update_valid: aluq_rvalid && aluq_rready && inst_is_br(aluq_rdata.ctrl),
        update_pc   : aluq_rdata.addr                                          ,
        update_taken: aluq_br_take                                             ,
    );

    inst btb: branch_target_buffer (
        clk  ,
        rst  ,

        predict_pc    : ids_pc    ,
        predict_hit   : btb_hit   ,
        predict_target: btb_target,

        update_valid : aluq_rvalid && aluq_rready && aluq_is_jalr,
        update_pc    : aluq_rdata.addr                           ,
        update_target: aluq_result & ~1,
    );

    ///////////////////////////////// FIFO /////////////////////////////////

    inst aluq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: aluq_wready   ,
        wvalid: aluq_wvalid   ,
        wdata : aluq_wdata    ,
        rready: aluq_rready   ,
        rvalid: aluq_rvalid   ,
        rdata : aluq_rdata    ,
    );

    inst memq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: memq_wready   ,
        wvalid: memq_wvalid   ,
        wdata : memq_wdata    ,
        rready: memq_rready   ,
        rvalid: memq_rvalid   ,
        rdata : memq_rdata    ,
    );

    inst muldivq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: mduq_wready   ,
        wvalid: mduq_wvalid   ,
        wdata : mduq_wdata    ,
        rready: mduq_rready   ,
        rvalid: mduq_rvalid   ,
        rdata : mduq_rdata    ,
    );

    inst csrq: fifo #(
        DATA_TYPE: euq_type,
        WIDTH    : 3       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: csrq_wready   ,
        wvalid: csrq_wvalid   ,
        wdata : csrq_wdata    ,
        rready: csrq_rready   ,
        rvalid: csrq_rvalid   ,
        rdata : csrq_rdata    ,
    );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk  ,
        rst  ,
        // トラップはROB先頭でのみ受理するため、ここで全破棄できる
        flush: control_hazard,

        allocate_valid: rob_allocate_valid,
        allocate_ready: rob_allocate_ready,
        allocate_done : rob_allocate_done ,
        allocate_data : rob_allocate_data ,
        allocate_tag  : rob_allocate_tag  ,

        complete_valid: rob_complete_valid,
        complete_tag  : rob_complete_tag  ,
        complete_data : rob_complete_data ,

        commit_valid: rob_commit_valid,
        commit_ready: rob_commit_ready,
        commit_data : rob_commit_data ,

        head_valid: rob_head_valid,
        head_tag  : rob_head_tag  ,
    );

    inst flist: free_list (
        clk                 ,
        rst                 ,
        rready: flist_rready,
        rvalid: flist_rvalid,
        rdata : flist_rdata ,
        wready: flist_wready,
        wvalid: flist_wvalid,
        wdata : flist_wdata ,
    );

    inst rat: register_alias_table (
        clk                         ,
        rst                         ,
        flush      : rat_flush      ,
        read1_addr : rat_read1_addr ,
        read1_data : rat_read1_data ,
        read2_addr : rat_read2_addr ,
        read2_data : rat_read2_data ,
        write_valid: rat_write_valid,
        write_addr : rat_write_addr ,
        write_data : rat_write_data ,
        write_old  : rat_write_old  ,
    );

    inst prf: physical_register_file (
        clk                           ,
        rst                           ,
        read1_addr  : alu_read1_addr  ,
        read1_data  : alu_read1_data  ,
        read2_addr  : alu_read2_addr  ,
        read2_data  : alu_read2_data  ,
        read3_addr  : memu_read1_addr ,
        read3_data  : memu_read1_data ,
        read4_addr  : memu_read2_addr ,
        read4_data  : memu_read2_data ,
        read5_addr  : mdu_read1_addr  ,
        read5_data  : mdu_read1_data  ,
        read6_addr  : mdu_read2_addr  ,
        read6_data  : mdu_read2_data  ,
        read7_addr  : csru_read_addr  ,
        read7_data  : csru_read_data  ,
        write1_valid: alu_write_valid ,
        write1_addr : alu_write_addr  ,
        write1_data : alu_write_data  ,
        write2_valid: memu_write_valid,
        write2_addr : memu_write_addr ,
        write2_data : memu_write_data ,
        write3_valid: mdu_write_valid ,
        write3_addr : mdu_write_addr  ,
        write3_data : mdu_write_data  ,
        write4_valid: csru_write_valid,
        write4_addr : csru_write_addr ,
        write4_data : csru_write_data ,
    );
}
