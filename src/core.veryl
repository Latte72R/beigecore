import eei::*;
import corectrl::*;

module core (
    clk     : input   clock                          ,
    rst     : input   reset                          ,
    i_membus: modport membus_if::<ILEN, XLEN>::master,
    d_membus: modport Membus::master                 ,
    led     : output  UIntX                          ,
) {
    // ifのFIFOのデータ型
    struct if_fifo_type {
        addr: Addr,
        bits: Inst,
    }

    struct exq_type {
        addr: Addr         ,
        bits: Inst         ,
        ctrl: InstCtrl     ,
        imm : UIntX        ,
        expt: ExceptionInfo,
    }

    struct memq_type {
        rob_tag   : RobTag          ,
        addr      : Addr            ,
        bits      : Inst            ,
        ctrl      : InstCtrl        ,
        imm       : UIntX           ,
        expt      : ExceptionInfo   ,
        alu_result: UIntX           ,
        rs1_addr  : logic        <5>,
        rs1_data  : UIntX           ,
        rs2_data  : UIntX           ,
        br_taken  : logic           ,
        jump_addr : Addr            ,
    }

    struct wbq_type {
        addr      : Addr    ,
        bits      : Inst    ,
        ctrl      : InstCtrl,
        imm       : UIntX   ,
        alu_result: UIntX   ,
        mem_rdata : UIntX   ,
        csr_rdata : UIntX   ,
        raise_trap: logic   ,
    }

    struct rob_entry_type {
        addr      : Addr            ,
        bits      : Inst            ,
        ctrl      : InstCtrl        ,
        rd_addr   : logic        <5>,
        result    : UIntX           ,
        expt      : ExceptionInfo   ,
        raise_trap: logic           ,
    }

    // FIFOの制御用レジスタ
    var if_fifo_wready    : logic       ;
    var if_fifo_wready_two: logic       ;
    var if_fifo_wvalid    : logic       ;
    var if_fifo_wdata     : if_fifo_type;
    var if_fifo_rready    : logic       ;
    var if_fifo_rvalid    : logic       ;
    var if_fifo_rdata     : if_fifo_type;

    // ID -> EXのFIFO
    var exq_wready: logic   ;
    var exq_wvalid: logic   ;
    var exq_wdata : exq_type;
    var exq_rready: logic   ;
    var exq_rvalid: logic   ;
    var exq_rdata : exq_type;

    // EX -> MEMのFIFO
    var memq_wready: logic    ;
    var memq_wvalid: logic    ;
    var memq_wdata : memq_type;
    var memq_rready: logic    ;
    var memq_rvalid: logic    ;
    var memq_rdata : memq_type;

    // (EX, MEM) -> WB の Reorder Buffer
    var rob_avalid: logic         ;
    var rob_aready: logic         ;
    var rob_adone : logic         ;
    var rob_adata : rob_entry_type;
    var rob_atag  : RobTag        ;

    var rob_cvalid: logic         ;
    var rob_ctag  : RobTag        ;
    var rob_cdata : rob_entry_type;

    var rob_rvalid: logic         ;
    var rob_rready: logic         ;
    var rob_rdata : rob_entry_type;

    var rob_hvalid: logic ;
    var rob_htag  : RobTag;

    ///////////////////////////////// IF Stage /////////////////////////////////

    var if_pc          : Addr ;
    var if_is_requested: logic; // フェッチ中かどうか
    var if_pc_requested: Addr ; // 要求したアドレス
    let if_pc_next     : Addr  = if_pc + 4;

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;

    // フェッチした命令を格納するFIFO
    inst if_fifo: fifo #(
        DATA_TYPE: if_fifo_type,
        WIDTH    : 3           ,
    ) (
        clk                           ,
        rst                           ,
        flush     : control_hazard    ,
        wready    : if_fifo_wready    ,
        wready_two: if_fifo_wready_two,
        wvalid    : if_fifo_wvalid    ,
        wdata     : if_fifo_wdata     ,
        rready    : if_fifo_rready    ,
        rvalid    : if_fifo_rvalid    ,
        rdata     : if_fifo_rdata     ,
    );

    // 命令フェッチ処理
    always_comb {
        // FIFOに2個以上空きがあるとき、命令をフェッチする
        i_membus.valid = if_fifo_wready_two;
        i_membus.addr  = if_pc;
        i_membus.wen   = 0;
        i_membus.wdata = 'x; // wdataは使用しない
        i_membus.wmask = 'x; // wmaskは使用しない
    }

    always_ff {
        if_reset {
            if_pc           = INITIAL_PC;
            if_is_requested = 0;
            if_pc_requested = 0;
            if_fifo_wvalid  = 0;
            if_fifo_wdata   = 0;
        } else {
            if control_hazard {
                if_pc           = control_hazard_pc_next;
                if_is_requested = 0;
                if_fifo_wvalid  = 0;
            } else {
                if if_is_requested {
                    if i_membus.rvalid {
                        if_is_requested = i_membus.ready && i_membus.valid;
                        if i_membus.ready && i_membus.valid {
                            if_pc           = if_pc_next;
                            if_pc_requested = if_pc;
                        }
                    }
                } else {
                    if i_membus.ready && i_membus.valid {
                        if_is_requested = 1;
                        if_pc           = if_pc_next;
                        if_pc_requested = if_pc;
                    }
                }
                // IFのFIFOの制御
                if if_is_requested && i_membus.rvalid {
                    if_fifo_wvalid     = 1;
                    if_fifo_wdata.addr = if_pc_requested;
                    if_fifo_wdata.bits = i_membus.rdata;
                } else {
                    if if_fifo_wvalid && if_fifo_wready {
                        if_fifo_wvalid = 0;
                    }
                }
            }
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_valid     : logic    = if_fifo_rvalid;
    let ids_pc        : Addr     = if_fifo_rdata.addr;
    let ids_inst_bits : Inst     = if_fifo_rdata.bits;
    var ids_inst_valid: logic   ;
    var ids_ctrl      : InstCtrl;
    var ids_imm       : UIntX   ;

    inst decoder: inst_decoder (
        bits : ids_inst_bits ,
        valid: ids_inst_valid,
        ctrl : ids_ctrl      ,
        imm  : ids_imm       ,
    );

    always_comb {
        // ID -> EX
        if_fifo_rready = exq_wready;
        exq_wvalid     = if_fifo_rvalid;
        exq_wdata.addr = if_fifo_rdata.addr;
        exq_wdata.bits = if_fifo_rdata.bits;
        exq_wdata.ctrl = ids_ctrl;
        exq_wdata.imm  = ids_imm;
        // exception
        exq_wdata.expt = 0;
        if !ids_inst_valid {
            // illegal instruction
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            exq_wdata.expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::ENVIRONMENT_CALL_FROM_M_MODE;
            exq_wdata.expt.value = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            exq_wdata.expt.valid = 1;
            exq_wdata.expt.cause = CsrCause::BREAKPOINT;
            exq_wdata.expt.value = ids_pc;
        }
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    let exs_valid    : logic    = exq_rvalid;
    let exs_pc       : Addr     = exq_rdata.addr;
    let exs_inst_bits: Inst     = exq_rdata.bits;
    let exs_ctrl     : InstCtrl = exq_rdata.ctrl;
    let exs_imm      : UIntX    = exq_rdata.imm;

    // レジスタ
    var regfile: UIntX<32>;

    // ROB内に存在する未コミットの書込み命令数
    var pending_writes: logic<ROB_WIDTH> [32];

    // レジスタ番号
    let exs_rs1_addr: logic<5> = exs_inst_bits[19:15];
    let exs_rs2_addr: logic<5> = exs_inst_bits[24:20];
    // ソースレジスタのデータ
    let exs_rs1_data: UIntX = if exs_rs1_addr == 0 ? 0 : regfile[exs_rs1_addr];
    let exs_rs2_data: UIntX = if exs_rs2_addr == 0 ? 0 : regfile[exs_rs2_addr];

    // データハザード
    let exs_uses_rs1: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::I: if exs_ctrl.is_csr ? exs_ctrl.funct3[1:0] != 0 && !exs_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_uses_rs2: logic = case exs_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };
    let exs_rs1_data_hazard: logic = exs_valid && exs_uses_rs1 && exs_rs1_addr != 0 && pending_writes[exs_rs1_addr]
        != 0;
    let exs_rs2_data_hazard: logic = exs_valid && exs_uses_rs2 && exs_rs2_addr != 0 && pending_writes[exs_rs2_addr]
        != 0;
    let exs_data_hazard    : logic = exs_rs1_data_hazard || exs_rs2_data_hazard;

    // ALU
    var exs_op1       : UIntX;
    var exs_op2       : UIntX;
    var exs_alu_result: UIntX;

    always_comb {
        case exs_ctrl.itype {
            InstType::R, InstType::B: {
                exs_op1 = exs_rs1_data;
                exs_op2 = exs_rs2_data;
            }
            InstType::I, InstType::S: {
                exs_op1 = exs_rs1_data;
                exs_op2 = exs_imm;
            }
            InstType::U, InstType::J: {
                exs_op1 = exs_pc;
                exs_op2 = exs_imm;
            }
            default: {
                exs_op1 = 'x;
                exs_op2 = 'x;
            }
        }
    }

    inst alum: alu (
        ctrl  : exs_ctrl      ,
        op1   : exs_op1       ,
        op2   : exs_op2       ,
        result: exs_alu_result,
    );

    var exs_muldiv_is_requested: logic;
    let exs_muldiv_valid       : logic = exs_valid && exs_ctrl.is_muldiv && !exs_data_hazard
        && !exs_muldiv_is_requested;
    var exs_muldiv_ready       : logic;
    var exs_muldiv_rvalid      : logic;
    var exs_muldiv_result      : UIntX;

    inst mdu: muldivunit (
        clk                       ,
        rst                       ,
        valid  : exs_muldiv_valid ,
        ready  : exs_muldiv_ready ,
        funct3 : exs_ctrl.funct3  ,
        is_op32: exs_ctrl.is_op32 ,
        op1    : exs_op1          ,
        op2    : exs_op2          ,
        rvalid : exs_muldiv_rvalid,
        result : exs_muldiv_result,
    );

    always_ff {
        if_reset {
            exs_muldiv_is_requested = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_is_requested = 0;
            } else {
                // muldivunitにリクエストしたか判定する
                if exs_muldiv_valid && exs_muldiv_ready {
                    exs_muldiv_is_requested = 1;
                }
            }
        }
    }

    var exs_muldiv_rvalided: logic;
    let exs_muldiv_stall   : logic = exs_ctrl.is_muldiv && !(exs_muldiv_rvalid && exs_muldiv_is_requested)
        && !exs_muldiv_rvalided;

    always_ff {
        if_reset {
            exs_muldiv_rvalided = 0;
        } else {
            // 次のステージに遷移
            if exq_rvalid && exq_rready {
                exs_muldiv_rvalided = 0;
            } else if exs_muldiv_is_requested {
                // muldivunitの処理が完了していたら1にする
                exs_muldiv_rvalided |= exs_muldiv_rvalid;
            }
        }
    }

    var exs_brunit_take: logic;
    inst bru: brunit (
        funct3: exs_ctrl.funct3,
        op1   : exs_op1        ,
        op2   : exs_op2        ,
        take  : exs_brunit_take,
    );

    let exs_stall    : logic = exs_data_hazard || exs_muldiv_stall;
    let exs_needs_mem: logic = inst_is_memop(exs_ctrl) || exs_ctrl.is_csr || exs_ctrl.is_jump || inst_is_br(exs_ctrl)
        || exq_rdata.expt.valid;

    always_comb {
        rob_adone         = !exs_needs_mem;
        rob_adata.addr    = exq_rdata.addr;
        rob_adata.bits    = exq_rdata.bits;
        rob_adata.ctrl    = exq_rdata.ctrl;
        rob_adata.rd_addr = exq_rdata.bits[11:7];
        rob_adata.result  = switch {
            exs_ctrl.is_lui   : exq_rdata.imm,
            exs_ctrl.is_muldiv: exs_muldiv_result,
            default           : exs_alu_result,
        };
        rob_adata.expt       = memq_wdata.expt;
        rob_adata.raise_trap = 0;
    }

    // 未解決の直列化命令がROB/MEM内にある
    var serial_pending: logic;

    // 命令が進む経路に空きがあるか
    let exs_route_ready: logic = !exs_needs_mem || memq_wready;
    // EX段の命令がROBへ実際に登録された
    let rob_alloc_fire: logic = rob_avalid && rob_aready;
    // ROBに登録された命令が直列化命令（後続命令を確定できない命令）かどうか
    let exs_redirect      : logic = exs_ctrl.is_jump || (inst_is_br(exs_ctrl) && exs_brunit_take);
    let exs_is_serializing: logic = exs_redirect || exs_ctrl.is_csr || memq_wdata.expt.valid;
    // ROBに登録された命令が直列化命令の場合，次の命令のROB登録を待つ
    let serial_alloc: logic = rob_alloc_fire && exs_is_serializing;

    always_comb {
        // EX -> MEM
        // ROBだけallocationされたり MEM FIFOだけ書き込まれたりするのを防ぐ
        rob_avalid  = exq_rvalid && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
        exq_rready  = rob_aready && exs_route_ready && !exs_stall && !serial_pending && !control_hazard;
        memq_wvalid = rob_alloc_fire && exs_needs_mem;

        memq_wdata.addr       = exq_rdata.addr;
        memq_wdata.bits       = exq_rdata.bits;
        memq_wdata.ctrl       = exq_rdata.ctrl;
        memq_wdata.imm        = exq_rdata.imm;
        memq_wdata.rs1_addr   = exs_rs1_addr;
        memq_wdata.rs1_data   = exs_rs1_data;
        memq_wdata.rs2_data   = exs_rs2_data;
        memq_wdata.alu_result = if exs_ctrl.is_muldiv ? exs_muldiv_result : exs_alu_result;
        memq_wdata.br_taken   = exs_ctrl.is_jump || inst_is_br(exs_ctrl) && exs_brunit_take;
        memq_wdata.jump_addr  = if inst_is_br(exs_ctrl) ? exs_pc + exs_imm : exs_alu_result & ~1;
        memq_wdata.rob_tag    = rob_atag;

        // exception
        let instruction_address_misaligned: logic = memq_wdata.br_taken && memq_wdata.jump_addr[1:0] != 2'b00;
        let loadstore_address_misaligned  : logic = inst_is_memop(exs_ctrl)
            && case exs_ctrl.funct3[1:0] {
                2'b00  : 1'b0, // B
                2'b01  : exs_alu_result[0] != 1'b0, // H
                2'b10  : exs_alu_result[1:0] != 2'b0, // W
                2'b11  : exs_alu_result[2:0] != 3'b0, // D
                default: 1'b0,
            };
        memq_wdata.expt = exq_rdata.expt;
        if !memq_wdata.expt.valid {
            if instruction_address_misaligned {
                memq_wdata.expt.valid = 1;
                memq_wdata.expt.cause = CsrCause::INSTRUCTION_ADDRESS_MISALIGNED;
                memq_wdata.expt.value = memq_wdata.jump_addr;
            } else if loadstore_address_misaligned {
                memq_wdata.expt.valid = 1;
                memq_wdata.expt.cause = if exs_ctrl.is_load ?
                    CsrCause::LOAD_ADDRESS_MISALIGNED
                :
                    CsrCause::STORE_AMO_ADDRESS_MISALIGNED
                ;
                memq_wdata.expt.value = exs_alu_result;
            }
        }
    }

    ///////////////////////////////// MEM Stage /////////////////////////////////

    let mems_valid    : logic            = memq_rvalid;
    let mems_pc       : Addr             = memq_rdata.addr;
    let mems_inst_bits: Inst             = memq_rdata.bits;
    let mems_ctrl     : InstCtrl         = memq_rdata.ctrl;
    let mems_expt     : ExceptionInfo    = memq_rdata.expt;
    let mems_rd_addr  : logic        <5> = mems_inst_bits[11:7];

    let mems_is_store   : logic = inst_is_store(mems_ctrl);
    let mems_at_rob_head: logic = rob_hvalid && rob_htag == memq_rdata.rob_tag;

    // 命令が直列化命令（後続命令を確定できない命令）かどうか
    let mems_is_serializing: logic = memq_rdata.br_taken || mems_ctrl.is_csr || mems_expt.valid;

    // Storeまたは直列化命令ならROB先頭の場合だけ実行してよい
    let mems_requires_head: logic = mems_is_store || mems_ctrl.is_csr || mems_expt.valid;
    let mems_can_execute  : logic = !mems_requires_head || mems_at_rob_head;

    let serial_complete: logic = rob_cvalid && mems_is_serializing;

    always_ff {
        if_reset {
            serial_pending = 0;
        } else {
            if serial_complete {
                serial_pending = 0;
            } else if serial_alloc {
                serial_pending = 1;
            }
        }
    }

    var memu_rdata: UIntX;
    var memu_stall: logic;

    inst memu: memunit (
        clk                                                       ,
        rst                                                       ,
        valid : mems_valid && mems_can_execute && !mems_expt.valid,
        ctrl  : mems_ctrl                                         ,
        addr  : memq_rdata.alu_result                             ,
        rs2   : memq_rdata.rs2_data                               ,
        rdata : memu_rdata                                        ,
        stall : memu_stall                                        ,
        membus: d_membus                                          ,
    );

    var csru_rdata      : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;

    inst csru: csrunit (
        clk                                        ,
        rst                                        ,
        valid      : mems_valid && mems_can_execute,
        pc         : mems_pc                       ,
        inst_bits  : mems_inst_bits                ,
        ctrl       : mems_ctrl                     ,
        expt_info  : mems_expt                     ,
        rd_addr    : mems_rd_addr                  ,
        csr_addr   : mems_inst_bits[31:20]         ,
        rs1_addr   : memq_rdata.rs1_addr           ,
        rs1_data   : memq_rdata.rs1_data           ,
        rdata      : csru_rdata                    ,
        raise_trap : csru_raise_trap               ,
        trap_vector: csru_trap_vector              ,
        led                                        ,
    );

    always_comb {
        // MEM -> WB
        memq_rready = mems_can_execute && !memu_stall;
        rob_cvalid  = memq_rvalid && mems_can_execute && !memu_stall;
        rob_ctag    = memq_rdata.rob_tag;

        rob_cdata.addr    = memq_rdata.addr;
        rob_cdata.bits    = memq_rdata.bits;
        rob_cdata.ctrl    = memq_rdata.ctrl;
        rob_cdata.rd_addr = memq_rdata.bits[11:7];

        rob_cdata.result = switch {
            mems_ctrl.is_lui : memq_rdata.imm,
            mems_ctrl.is_jump: memq_rdata.addr + 4,
            mems_ctrl.is_load: memu_rdata,
            mems_ctrl.is_csr : csru_rdata,
            default          : memq_rdata.alu_result
        };

        rob_cdata.expt       = memq_rdata.expt;
        rob_cdata.raise_trap = csru_raise_trap;
    }

    always_comb {
        control_hazard         = mems_valid && mems_can_execute
            && (csru_raise_trap || mems_ctrl.is_jump || memq_rdata.br_taken);
        control_hazard_pc_next = if csru_raise_trap ? csru_trap_vector : memq_rdata.jump_addr;
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    let wbs_valid  : logic       = rob_rvalid;
    let wbs_ctrl   : InstCtrl    = rob_rdata.ctrl;
    let wbs_rd_addr: logic   <5> = rob_rdata.rd_addr;
    let wbs_wb_data: UIntX       = rob_rdata.result;

    always_ff {
        // ROB先頭が完成済み & コミットが成立 & レジスタ書込み命令 & x0ではない & trapではない
        if rob_rvalid && rob_rready && rob_rdata.ctrl.rwb_en && rob_rdata.rd_addr != 0 && !rob_rdata.raise_trap {
            regfile[rob_rdata.rd_addr] = rob_rdata.result;
        }
    }

    always_comb {
        // WB -> END
        rob_rready = 1;
    }

    ///////////////////////////////// Pending Writes /////////////////////////////////

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_rvalid && rob_rready;

    // allocationされた命令がレジスタへ書く場合pendingを増やす
    let pending_alloc: logic = rob_alloc_fire && rob_adata.ctrl.rwb_en && rob_adata.rd_addr != 0;
    // コミットされた命令が書込み予約を持っている場合pendingを減らす
    let pending_commit: logic = rob_commit_fire && rob_rdata.ctrl.rwb_en && rob_rdata.rd_addr != 0;

    always_ff {
        if_reset {
            for i in 0..32 {
                pending_writes[i] = 0;
            }
        } else {
            if pending_alloc && pending_commit && rob_adata.rd_addr == rob_rdata.rd_addr {
                // 同じレジスタへの +1 と -1 が同時に発生するので変更なし
            } else {
                if pending_alloc {
                    pending_writes[rob_adata.rd_addr] += 1;
                }

                if pending_commit {
                    pending_writes[rob_rdata.rd_addr] -= 1;
                }
            }
        }
    }

    ///////////////////////////////// DEBUG /////////////////////////////////

    #[ifdef(PRINT_DEBUG)]
    {
        var clock_count: u64;

        var perf_cycles         : u64;
        var perf_issued         : u64;
        var perf_committed      : u64;
        var perf_ex_empty       : u64;
        var perf_serial_stall   : u64;
        var perf_raw_stall      : u64;
        var perf_muldiv_stall   : u64;
        var perf_rob_full_stall : u64;
        var perf_memq_full_stall: u64;
        var perf_mem_wait       : u64;
        var perf_head_wait      : u64;
        var perf_control_hazard : u64;

        always_ff {
            if_reset {
                clock_count = 1;

                perf_cycles          = 0;
                perf_issued          = 0;
                perf_committed       = 0;
                perf_ex_empty        = 0;
                perf_serial_stall    = 0;
                perf_raw_stall       = 0;
                perf_muldiv_stall    = 0;
                perf_rob_full_stall  = 0;
                perf_memq_full_stall = 0;
                perf_mem_wait        = 0;
                perf_head_wait       = 0;
                perf_control_hazard  = 0;
            } else {
                clock_count += 1;

                perf_cycles += 1;

                if rob_alloc_fire {
                    perf_issued += 1;
                }

                if rob_commit_fire {
                    perf_committed += 1;
                }

                // EX段の停止理由を排他的に数える
                if !exq_rvalid {
                    perf_ex_empty += 1;
                } else if control_hazard {
                    perf_control_hazard += 1;
                } else if serial_pending {
                    perf_serial_stall += 1;
                } else if exs_data_hazard {
                    perf_raw_stall += 1;
                } else if exs_muldiv_stall {
                    perf_muldiv_stall += 1;
                } else if !rob_aready {
                    perf_rob_full_stall += 1;
                } else if !exs_route_ready {
                    perf_memq_full_stall += 1;
                }

                // MEM側はEX停止理由と重複してもよい独立カウンタ
                if memq_rvalid && memu_stall {
                    perf_mem_wait += 1;
                }

                if memq_rvalid && !mems_can_execute {
                    perf_head_wait += 1;
                }

                $display("");
                $display("# %d", clock_count);

                $display("IF ------");
                $display("     pc : %h", if_pc);
                $display(" is req : %b", if_is_requested);
                $display(" pc req : %h", if_pc_requested);
                $display("ID ------");
                if ids_valid {
                    $display("  %h : %h", ids_pc, if_fifo_rdata.bits);
                    $display("  itype : %b", ids_ctrl.itype);
                    $display("  imm   : %h", ids_imm);
                }
                $display("EX -----");
                if exs_valid {
                    $display("  %h : %h", exq_rdata.addr, exq_rdata.bits);
                    $display("  op1     : %h", exs_op1);
                    $display("  op2     : %h", exs_op2);
                    $display("  alu     : %h", exs_alu_result);
                    $display("  dhazard : %b", exs_data_hazard);
                    if inst_is_br(exs_ctrl) {
                        $display("  br take : %b", exs_brunit_take);
                    }
                }
                $display("MEM -----");
                if mems_valid {
                    $display("  %h : %h", memq_rdata.addr, memq_rdata.bits);
                    $display("  mem stall : %b", memu_stall);
                    $display("  mem rdata : %h", memu_rdata);
                    if mems_ctrl.is_csr {
                        $display("  csr rdata : %h", csru_rdata);
                        $display("  csr trap  : %b", csru_raise_trap);
                        $display("  csr vec   : %h", csru_trap_vector);
                    }
                    if memq_rdata.br_taken {
                        $display("  JUMP TO   : %h", memq_rdata.jump_addr);
                    }
                }
                $display("WB ----");
                if wbs_valid {
                    $display("  %h : %h", rob_rdata.addr, rob_rdata.bits);
                    if wbs_ctrl.rwb_en {
                        $display("  reg[%d] <= %h", wbs_rd_addr, wbs_wb_data);
                    }
                }

                $display("PERFORMANCE COUNTERS");
                $display("  total cycles             : %0d", perf_cycles);
                $display("  instructions issued      : %0d", perf_issued);
                $display("  instructions committed   : %0d", perf_committed);
                $display("  EX has no instruction    : %0d", perf_ex_empty);
                $display("  control hazard / flush   : %0d", perf_control_hazard);
                $display("  serializing instruction  : %0d", perf_serial_stall);
                $display("  RAW dependency           : %0d", perf_raw_stall);
                $display("  multiply/divide wait     : %0d", perf_muldiv_stall);
                $display("  ROB full                 : %0d", perf_rob_full_stall);
                $display("  EX/MEM queue full        : %0d", perf_memq_full_stall);
                $display("  memory response wait     : %0d", perf_mem_wait);
                $display("  waiting for ROB head     : %0d", perf_head_wait);
            }
        }
    }

    ///////////////////////////////// FIFO /////////////////////////////////

    inst id_ex_fifo: fifo #(
        DATA_TYPE: exq_type,
        WIDTH    : 2       ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: exq_wready    ,
        wvalid: exq_wvalid    ,
        wdata : exq_wdata     ,
        rready: exq_rready    ,
        rvalid: exq_rvalid    ,
        rdata : exq_rdata     ,
    );

    inst ex_mem_fifo: fifo #(
        DATA_TYPE: memq_type,
        WIDTH    : 2        ,
    ) (
        clk                   ,
        rst                   ,
        flush : control_hazard,
        wready: memq_wready   ,
        wvalid: memq_wvalid   ,
        wdata : memq_wdata    ,
        rready: memq_rready   ,
        rvalid: memq_rvalid   ,
        rdata : memq_rdata    ,
    );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk     ,
        rst     ,
        flush: 0,

        avalid: rob_avalid,
        aready: rob_aready,
        adone : rob_adone ,
        adata : rob_adata ,
        atag  : rob_atag  ,

        cvalid: rob_cvalid,
        ctag  : rob_ctag  ,
        cdata : rob_cdata ,

        rvalid: rob_rvalid,
        rready: rob_rready,
        rdata : rob_rdata ,

        hvalid: rob_hvalid,
        htag  : rob_htag  ,
    );
}
