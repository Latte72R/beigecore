import eei::*;
import corectrl::*;

module core (
    clk     : input   clock               ,
    rst     : input   reset               ,
    i_membus: modport core_inst_if::master,
    d_membus: modport core_data_if::master,
    led     : output  UIntX               ,
    aclint  : modport aclint_if::slave    ,
) {
    // (EX, MEM) -> WB の Reorder Buffer
    var rob_allocate_valid: logic         ;
    var rob_allocate_ready: logic         ;
    var rob_allocate_done : logic         ;
    var rob_allocate_data : rob_entry_type;
    var rob_allocate_tag  : RobTag        ;

    var rob_commit_valid: logic         ;
    var rob_commit_ready: logic         ;
    var rob_commit_data : rob_entry_type;

    var rob_head_valid: logic ;
    var rob_head_tag  : RobTag;

    var rob_rollback_start: logic         ;
    var rob_rollback_tag  : RobTag        ;
    var rob_rollback_valid: logic         ;
    var rob_rollback_ready: logic         ;
    var rob_rollback_data : rob_entry_type;
    var rob_rollback_busy : logic         ;

    var rob_rollback_request     : logic ;
    var rob_rollback_request_tag : RobTag;
    var rob_rollback_request_head: RobTag;
    var rob_rollback_request_pc  : Addr  ;

    let rob_rollback_fire       : logic = rob_rollback_valid && rob_rollback_ready;
    let rob_rollback_restores_rd: logic = rob_rollback_fire && rob_rollback_data.ctrl.rwb_en
        && (rob_rollback_data.rd_areg != 0);


    ///////////////////////////////// IF Stage /////////////////////////////////

    var control_hazard        : logic;
    var control_hazard_pc_next: Addr ;
    var fencei_redirect       : logic;
    var backend_redirect      : logic;
    var alu_redirect          : logic;
    var csr_redirect          : logic;

    var prediction_redirect: logic;
    var ids_imm            : UIntX;
    var ids_pred_target    : Addr ;

    let frontend_redirect: logic = control_hazard || fencei_redirect || prediction_redirect;
    var alu_next_pc      : Addr ;
    always_comb {
        i_membus.is_redirect = frontend_redirect;

        if control_hazard {
            i_membus.next_pc = control_hazard_pc_next;
        } else if fencei_redirect {
            i_membus.next_pc = alu_next_pc;
        } else {
            i_membus.next_pc = ids_pred_target;
        }
    }

    ///////////////////////////////// ID Stage /////////////////////////////////

    let ids_inst_bits = i_membus.rdata;

    let ids_fire      : logic         = i_membus.rvalid && i_membus.rready;
    var ids_inst_valid: logic        ;
    var ids_ctrl      : InstCtrl     ;
    var ids_expt      : ExceptionInfo;

    var bimodal_pred_taken: logic;
    var bimodal_pred_valid: logic;

    let ids_btfnt_taken      : logic = ids_imm[msb]; // 負のoffsetならbackward
    let ids_branch_pred_taken: logic = if bimodal_pred_valid ? bimodal_pred_taken : ids_btfnt_taken;

    var btb_hit   : logic;
    var btb_target: Addr ;

    let ids_is_jal : logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::J;
    let ids_is_jalr: logic = ids_ctrl.is_jump && ids_ctrl.itype == InstType::I;

    let ids_pred_taken: logic = ids_inst_valid
        && (ids_is_jal || (ids_is_jalr && btb_hit) || (inst_is_br(ids_ctrl) && ids_branch_pred_taken));

    let ids_pc: Addr = i_membus.raddr;

    always_comb {
        prediction_redirect = !control_hazard && ids_fire && ids_pred_taken;
        ids_pred_target     = if ids_is_jalr ? btb_target : ids_pc + ids_imm;
    }

    inst decoder: inst_decoder (
        bits  : ids_inst_bits  ,
        is_rvc: i_membus.is_rvc,
        valid : ids_inst_valid ,
        ctrl  : ids_ctrl       ,
        imm   : ids_imm        ,
    );

    var flist_rready: logic  ;
    var flist_rvalid: logic  ;
    var flist_rdata : PhysReg;
    var flist_wready: logic  ;
    var flist_wvalid: logic  ;
    var flist_wdata : PhysReg;

    let ids_uses_rs1: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::I: if ids_ctrl.is_csr ? ids_ctrl.funct3[1:0] != 0 && !ids_ctrl.funct3[2] : 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_uses_rs2: logic = case ids_ctrl.itype {
        InstType::R: 1,
        InstType::S: 1,
        InstType::B: 1,
        default    : 0,
    };

    let ids_rd_areg   : ArchReg = ids_inst_bits[11:7];
    let ids_rs1_areg  : ArchReg = ids_inst_bits[19:15];
    let ids_rs2_areg  : ArchReg = ids_inst_bits[24:20];
    let ids_writes_rd : logic   = ids_ctrl.rwb_en && ids_rd_areg != 0;
    let ids_preg_ready: logic   = !ids_writes_rd || flist_rvalid;

    var rat_read1_data : PhysReg;
    var rat_read2_data : PhysReg;
    var rat_read1_addr : ArchReg;
    var rat_read2_addr : ArchReg;
    var rat_write_old  : PhysReg;
    var rat_write_valid: logic  ;
    var rat_write_addr : ArchReg;
    var rat_write_data : PhysReg;

    var rat_flush: logic;

    let ids_new_preg: PhysReg = flist_rdata;
    let ids_old_preg: PhysReg = rat_write_old;

    let rename_fire: logic = ids_fire && ids_writes_rd;

    always_comb {
        flist_rready = rename_fire;

        rat_read1_addr = ids_rs1_areg;
        rat_read2_addr = ids_rs2_areg;

        // RAT writeはrollback優先
        rat_write_valid = rob_rollback_restores_rd || rename_fire;
        if rob_rollback_restores_rd {
            rat_write_addr = rob_rollback_data.rd_areg;
            rat_write_data = rob_rollback_data.old_preg;
        } else {
            rat_write_addr = ids_rd_areg;
            rat_write_data = ids_new_preg;
        }

        rat_flush = backend_redirect;
    }

    var csru_priv_mode: PrivMode;

    var prf_busy: logic [PREG_COUNT];

    var alu_read1_addr   : PhysReg;
    var alu_read1_data   : UIntX  ;
    var alu_read2_addr   : PhysReg;
    var alu_read2_data   : UIntX  ;
    var loadu_read_addr  : PhysReg;
    var loadu_read_data  : UIntX  ;
    var storeu_read1_addr: PhysReg;
    var storeu_read1_data: UIntX  ;
    var storeu_read2_addr: PhysReg;
    var storeu_read2_data: UIntX  ;
    var mdu_read1_addr   : PhysReg;
    var mdu_read1_data   : UIntX  ;
    var mdu_read2_addr   : PhysReg;
    var mdu_read2_data   : UIntX  ;
    var csru_read_addr   : PhysReg;
    var csru_read_data   : UIntX  ;

    var alu_write_valid  : logic  ;
    var alu_write_addr   : PhysReg;
    var alu_write_data   : UIntX  ;
    var loadu_write_valid: logic  ;
    var loadu_write_addr : PhysReg;
    var loadu_write_data : UIntX  ;
    var mdu_write_valid  : logic  ;
    var mdu_write_addr   : PhysReg;
    var mdu_write_data   : UIntX  ;
    var csru_write_valid : logic  ;
    var csru_write_addr  : PhysReg;
    var csru_write_data  : UIntX  ;

    var alu_oldest_valid   : logic   ;
    var alu_oldest_data    : euq_type;
    var loadu_oldest_valid : logic   ;
    var loadu_oldest_data  : euq_type;
    var storeu_oldest_valid: logic   ;
    var storeu_oldest_data : euq_type;
    var mdu_oldest_valid   : logic   ;
    var mdu_oldest_data    : euq_type;
    var csru_oldest_valid  : logic   ;
    var csru_oldest_data   : euq_type;

    var alu_wready  : logic   ;
    var alu_wvalid  : logic   ;
    var alu_rready  : logic   ;
    var alu_rvalid  : logic   ;
    var alu_wdata   : euq_type;
    var alu_rdata   : euq_type;
    var alu_grant   : logic   ;
    var alu_complete: logic   ;

    var loadu_wready  : logic   ;
    var loadu_wvalid  : logic   ;
    var loadu_rready  : logic   ;
    var loadu_rvalid  : logic   ;
    var loadu_wdata   : euq_type;
    var loadu_rdata   : euq_type;
    var loadu_grant   : logic   ;
    var loadu_complete: logic   ;

    var storeu_wready  : logic   ;
    var storeu_wvalid  : logic   ;
    var storeu_rready  : logic   ;
    var storeu_rvalid  : logic   ;
    var storeu_wdata   : euq_type;
    var storeu_rdata   : euq_type;
    var storeu_grant   : logic   ;
    var storeu_complete: logic   ;

    var memu_active        : logic   ;
    var memu_active_is_load: logic   ;
    var memu_active_entry  : euq_type;
    var memu_active_addr   : Addr    ;
    var memu_active_rs2    : UIntX   ;

    var memu_input_ctrl   : InstCtrl;
    var memu_input_addr   : Addr    ;
    var memu_input_rs2    : UIntX   ;
    var memu_result       : UIntX   ;
    var memu_stall        : logic   ;
    var memu_complete     : logic   ;
    var memu_done         : logic   ;
    var memu_response_done: logic   ;
    var memu_killed       : logic   ;

    var mdu_wready       : logic   ;
    var mdu_wvalid       : logic   ;
    var mdu_rready       : logic   ;
    var mdu_rvalid       : logic   ;
    var mdu_wdata        : euq_type;
    var mdu_rdata        : euq_type;
    var mdu_grant        : logic   ;
    var mdu_complete     : logic   ;
    var mdu_active_entry : euq_type;
    var mdu_response_done: logic   ;
    var mdu_killed       : logic   ;

    var csru_wready  : logic   ;
    var csru_wvalid  : logic   ;
    var csru_rready  : logic   ;
    var csru_rvalid  : logic   ;
    var csru_wdata   : euq_type;
    var csru_rdata   : euq_type;
    var csru_grant   : logic   ;
    var csru_complete: logic   ;

    var csru_active         : logic   ;
    var csru_active_entry   : euq_type;
    var csru_active_rs1_data: UIntX   ;

    var dispatch_wrs1ready: logic;
    var dispatch_wrs2ready: logic;

    always_ff {
        if_reset {
            for i in 0..PREG_COUNT {
                prf_busy[i] = 0;
            }
        } else {
            // 実行完了を先に反映
            if alu_write_valid {
                prf_busy[alu_write_addr] = 0;
            }
            if loadu_write_valid {
                prf_busy[loadu_write_addr] = 0;
            }
            if mdu_write_valid {
                prf_busy[mdu_write_addr] = 0;
            }
            if csru_write_valid {
                prf_busy[csru_write_addr] = 0;
            }
            if rob_rollback_restores_rd {
                prf_busy[rob_rollback_data.rd_preg] = 0;
            }

            // 新規割当
            if rename_fire {
                prf_busy[ids_new_preg] = 1;
            }
        }
    }

    let ids_opcode       : logic<7> = ids_inst_bits[6:0];
    let ids_pre_is_load  : logic    = ids_opcode == OP_LOAD;
    let ids_pre_is_store : logic    = ids_opcode == OP_STORE || ids_opcode == OP_AMO;
    let ids_pre_is_muldiv: logic    = (ids_opcode == OP_OP || ids_opcode == OP_OP_32) && ids_inst_bits[31:25]
        == 7'b0000001;
    let ids_pre_is_csr   : logic    = ids_opcode == OP_SYSTEM;

    // dispatch: 命令種別に応じて該当キューに格納
    let ids_is_csr    : logic = ids_ctrl.is_csr || ids_expt.valid;
    let ids_is_alu    : logic = !inst_is_memop(ids_ctrl) && !ids_ctrl.is_muldiv && !ids_is_csr;
    let ids_is_load   : logic = ids_ctrl.is_load;
    let ids_is_store  : logic = inst_is_store(ids_ctrl);
    let ids_is_muldiv : logic = ids_ctrl.is_muldiv;
    let ids_is_fence_i: logic = ids_inst_bits[6:0] == OP_MISC_MEM && ids_inst_bits[14:12] == 3'b001;

    var dispatch_data: euq_type;

    // 未解決の(csr or fence.i)命令がROB内にある
    var serial_pending: logic;
    // 未解決のbranch命令がROB内にある
    var branch_pending: logic;

    let ids_is_serial     : logic = ids_is_csr || ids_is_fence_i;
    let ids_is_spec_branch: logic = inst_is_br(ids_ctrl) || ids_is_jalr;

    always_comb {
        // ID rready: 該当キューが空き + ROB 空き
        let ids_target_ready: logic = switch {
            ids_pre_is_load  : loadu_wready,
            ids_pre_is_store : storeu_wready,
            ids_pre_is_muldiv: mdu_wready,
            ids_pre_is_csr   : csru_wready,
            default          : alu_wready,
        };
        i_membus.rready = !rob_rollback_busy && !rob_rollback_start && !serial_pending && rob_allocate_ready
            && ids_target_ready && ids_preg_ready && (!branch_pending || !ids_is_spec_branch) && !csr_redirect;

        // 該当キューの wvalid / wdata を駆動
        alu_wvalid    = ids_fire && ids_is_alu;
        loadu_wvalid  = ids_fire && ids_is_load;
        storeu_wvalid = ids_fire && ids_is_store;
        mdu_wvalid    = ids_fire && ids_is_muldiv;
        csru_wvalid   = ids_fire && ids_is_csr;

        // dispatch_data を組み立て
        dispatch_data.addr        = ids_pc;
        dispatch_data.bits        = ids_inst_bits;
        dispatch_data.ctrl        = ids_ctrl;
        dispatch_data.imm         = ids_imm;
        dispatch_data.expt        = ids_expt;
        dispatch_data.rs1_preg    = rat_read1_data;
        dispatch_data.rs2_preg    = rat_read2_data;
        dispatch_data.rd_preg     = ids_new_preg;
        dispatch_data.old_preg    = ids_old_preg;
        dispatch_data.rob_tag     = rob_allocate_tag;
        dispatch_data.pred_taken  = ids_pred_taken;
        dispatch_data.pred_target = ids_pred_target;
        dispatch_data.uses_rs1    = ids_uses_rs1;
        dispatch_data.uses_rs2    = ids_uses_rs2;

        // issue_queue に今回入れる命令の readyを生成
        dispatch_wrs1ready = !dispatch_data.uses_rs1 || !prf_busy[dispatch_data.rs1_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs1_preg)
            || (loadu_write_valid && loadu_write_addr == dispatch_data.rs1_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs1_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs1_preg);
        dispatch_wrs2ready = !dispatch_data.uses_rs2 || !prf_busy[dispatch_data.rs2_preg]
            || (alu_write_valid && alu_write_addr == dispatch_data.rs2_preg)
            || (loadu_write_valid && loadu_write_addr == dispatch_data.rs2_preg)
            || (mdu_write_valid && mdu_write_addr == dispatch_data.rs2_preg)
            || (csru_write_valid && csru_write_addr == dispatch_data.rs2_preg);

        // dispatch_data を代入
        alu_wdata    = dispatch_data;
        loadu_wdata  = dispatch_data;
        storeu_wdata = dispatch_data;
        mdu_wdata    = dispatch_data;
        csru_wdata   = dispatch_data;

        // === ROB allocate (dispatch 時) ===
        rob_allocate_valid           = ids_fire;
        rob_allocate_done            = 0;
        rob_allocate_data.addr       = ids_pc;
        rob_allocate_data.bits       = ids_inst_bits;
        rob_allocate_data.ctrl       = ids_ctrl;
        rob_allocate_data.rd_areg    = ids_rd_areg;
        rob_allocate_data.rd_preg    = ids_new_preg;
        rob_allocate_data.old_preg   = ids_old_preg;
        rob_allocate_data.expt       = ids_expt;
        rob_allocate_data.raise_trap = 0;
    }

    always_comb {
        // exception
        if !ids_inst_valid {
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::ILLEGAL_INSTRUCTION;
            ids_expt.value = {1'b0 repeat XLEN - ILEN, ids_inst_bits};
        } else if ids_inst_bits == 32'h00000073 {
            // ECALL
            ids_expt.valid      = 1;
            ids_expt.cause      = CsrCause::ENVIRONMENT_CALL_FROM_U_MODE;
            ids_expt.cause[1:0] = csru_priv_mode;
            ids_expt.value      = 0;
        } else if ids_inst_bits == 32'h00100073 {
            // EBREAK
            ids_expt.valid = 1;
            ids_expt.cause = CsrCause::BREAKPOINT;
            ids_expt.value = ids_pc;
        } else {
            ids_expt = 0;
        }
    }

    ///////////////////////////////// EX Stage /////////////////////////////////

    always_comb {
        alu_read1_addr    = alu_rdata.rs1_preg;
        alu_read2_addr    = alu_rdata.rs2_preg;
        loadu_read_addr   = loadu_rdata.rs1_preg;
        storeu_read1_addr = storeu_rdata.rs1_preg;
        storeu_read2_addr = storeu_rdata.rs2_preg;
        mdu_read1_addr    = mdu_rdata.rs1_preg;
        mdu_read2_addr    = mdu_rdata.rs2_preg;
        csru_read_addr    = csru_rdata.rs1_preg;
    }

    // *_grant     実行ユニットへ命令を受理させる
    // *_done      実行ユニットの処理結果が有効
    // *_complete  ROB completeポートを獲得
    // *_rready    キューから命令を取り出す

    ///////////////////////////////// EX Stage (ALU) /////////////////////////////////

    var alu_op1: UIntX;
    var alu_op2: UIntX;

    always_comb {
        let rs1_areg: ArchReg = alu_rdata.bits[19:15];
        let rs2_areg: ArchReg = alu_rdata.bits[24:20];

        case alu_rdata.ctrl.itype {
            InstType::R, InstType::B: {
                // R-type (add, sub, and, ...) / B-type (branch)
                alu_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                alu_op2 = if rs2_areg == 0 ? 0 : alu_read2_data;
            }
            InstType::I, InstType::S: {
                // I-type (addi, load, store, JALR, CSR) / S-type
                alu_op1 = if rs1_areg == 0 ? 0 : alu_read1_data;
                alu_op2 = alu_rdata.imm;
            }
            InstType::U, InstType::J: {
                // U-type (LUI, AUIPC) / J-type (JAL)
                // op1 = PC, op2 = immediate
                alu_op1 = alu_rdata.addr;
                alu_op2 = alu_rdata.imm;
            }
            default: {
                alu_op1 = 0;
                alu_op2 = 0;
            }
        }

    }

    let alu_is_fence_i: logic = alu_rdata.bits[6:0] == OP_MISC_MEM && alu_rdata.bits[14:12] == 3'b001;
    let alu_at_head   : logic = rob_head_valid && rob_head_tag == alu_rdata.rob_tag;
    assign fencei_redirect = alu_complete && alu_is_fence_i;

    var alu_result: UIntX;
    inst alu_alu: alu (
        ctrl  : alu_rdata.ctrl,
        op1   : alu_op1       ,
        op2   : alu_op2       ,
        result: alu_result    ,
    );

    let alu_is_br  : logic = inst_is_br(alu_rdata.ctrl);
    let alu_is_jalr: logic = alu_rdata.ctrl.is_jump && alu_rdata.ctrl.itype == InstType::I;
    // let alu_is_jal : logic = alu_rdata.ctrl.is_jump && alu_rdata.ctrl.itype == InstType::J;

    let alu_jalr_target: Addr = (alu_read1_data + alu_rdata.imm) & ~1;

    var alu_br_take: logic;
    inst alu_bru: brunit (
        funct3: alu_rdata.ctrl.funct3,
        op1   : alu_op1              ,
        op2   : alu_op2              ,
        take  : alu_br_take          ,
    );

    let alu_mispredict: logic = alu_rvalid
        && ((alu_is_br && alu_rdata.pred_taken != alu_br_take)
            || (alu_is_jalr && (alu_rdata.pred_taken != 1 || alu_rdata.pred_target != alu_jalr_target)));

    let alu_writes_rd: logic = alu_rvalid && alu_rdata.ctrl.rwb_en && alu_rdata.bits[11:7] != 0;

    let alu_writeback_data: UIntX = switch {
        alu_rdata.ctrl.is_jump: alu_next_pc,
        alu_rdata.ctrl.is_lui : alu_rdata.imm,
        default               : alu_result,
    };

    always_comb {
        alu_next_pc = alu_rdata.addr + (if alu_rdata.ctrl.is_rvc ? 2 : 4);

        alu_write_valid = alu_writes_rd && alu_rready;
        alu_write_addr  = alu_rdata.rd_preg;
        alu_write_data  = alu_writeback_data;
    }

    ///////////////////////////////// EX Stage (MDU) /////////////////////////////////

    var mdu_ready       : logic;
    var mdu_result      : UIntX;
    var mdu_result_valid: logic;
    var mdu_busy        : logic;

    inst mdu: muldivunit (
        clk                            ,
        rst                            ,
        valid  : mdu_grant             ,
        ready  : mdu_ready             ,
        funct3 : mdu_rdata.ctrl.funct3 ,
        is_op32: mdu_rdata.ctrl.is_op32,
        op1    : mdu_read1_data        ,
        op2    : mdu_read2_data        ,
        rvalid : mdu_result_valid      ,
        result : mdu_result            ,
    );

    always_ff {
        if_reset {
            mdu_busy         = 0;
            mdu_active_entry = '0;
            mdu_killed       = 0;
        } else if backend_redirect {
            mdu_busy         = 0;
            mdu_active_entry = '0;
            mdu_killed       = 0;
        } else if mdu_response_done {
            // killされた命令でもMDU自体は完了させて解放する
            mdu_busy   = 0;
            mdu_killed = 0;
        } else if mdu_grant {
            // Issue Queueから取り出した命令をMDU内で保持する
            mdu_busy         = 1;
            mdu_active_entry = mdu_rdata;
            mdu_killed       = 0;
        } else if rob_rollback_request && mdu_busy && (mdu_active_entry.rob_tag - rob_rollback_request_head)
            >: (rob_rollback_request_tag - rob_rollback_request_head) {
            // branchより若い実行中MDU命令をsquashする
            // 演算は止めず結果だけを破棄する
            mdu_killed = 1;
        }
    }

    ///////////////////////////////// EX Stage (MEMU) /////////////////////////////////

    always_comb {
        memu_input_ctrl = '0;
        memu_input_addr = 0;
        memu_input_rs2  = 0;

        if memu_active {
            memu_input_ctrl = memu_active_entry.ctrl;
            memu_input_addr = memu_active_addr;
            memu_input_rs2  = memu_active_rs2;
        } else if loadu_grant {
            memu_input_ctrl = loadu_rdata.ctrl;
            memu_input_addr = loadu_read_data + loadu_rdata.imm;
            memu_input_rs2  = 0;
        } else if storeu_grant {
            memu_input_ctrl = storeu_rdata.ctrl;
            memu_input_addr = storeu_read1_data + storeu_rdata.imm;
            memu_input_rs2  = storeu_read2_data;
        }
    }

    inst memu: memunit (
        clk   : clk                                       ,
        rst   : rst                                       ,
        valid : memu_active || loadu_grant || storeu_grant,
        ctrl  : memu_input_ctrl                           ,
        addr  : memu_input_addr                           ,
        rs2   : memu_input_rs2                            ,
        rdata : memu_result                               ,
        stall : memu_stall                                ,
        done  : memu_done                                 ,
        membus: d_membus                                  ,
    );

    var minstret: UInt64;

    always_ff {
        if_reset {
            memu_active         = 0;
            memu_active_is_load = 0;
            memu_active_entry   = '0;
            memu_active_addr    = 0;
            memu_active_rs2     = 0;
            memu_killed         = 0;
        } else if backend_redirect {
            memu_active         = 0;
            memu_active_is_load = 0;
            memu_active_entry   = '0;
            memu_active_addr    = 0;
            memu_active_rs2     = 0;
            memu_killed         = 0;
        } else if memu_response_done {
            // killされた命令でもMEMU自体は完了させて解放する
            memu_active = 0;
            memu_killed = 0;
        } else if loadu_grant {
            // Issue Queueから取り出した命令をMEMU内で保持する
            memu_active         = 1;
            memu_active_is_load = 1;
            memu_active_entry   = loadu_rdata;
            memu_active_addr    = loadu_read_data + loadu_rdata.imm;
            memu_active_rs2     = 0;
            memu_killed         = 0;
        } else if storeu_grant {
            // Issue Queueから取り出した命令をMEMU内で保持する
            memu_active         = 1;
            memu_active_is_load = 0;
            memu_active_entry   = storeu_rdata;
            memu_active_addr    = storeu_read1_data + storeu_rdata.imm;
            memu_active_rs2     = storeu_read2_data;
            memu_killed         = 0;
        } else if rob_rollback_request && memu_active && (memu_active_entry.rob_tag - rob_rollback_request_head)
            >: (rob_rollback_request_tag - rob_rollback_request_head) {
            // branchより若い実行中MEMU命令をsquashする
            // 演算は止めず結果だけを破棄する
            memu_killed = 1;
        }
    }

    let storeu_at_head: logic = storeu_rvalid && rob_head_valid && rob_head_tag == storeu_rdata.rob_tag;

    ///////////////////////////////// EX Stage (CSRU) /////////////////////////////////

    var csru_result     : UIntX;
    var csru_raise_trap : logic;
    var csru_trap_vector: Addr ;
    var csru_trap_return: logic;

    let csru_at_head: logic = csru_rvalid && rob_head_valid && rob_head_tag == csru_rdata.rob_tag;

    inst csru: csrunit (
        clk                                       ,
        rst                                       ,
        valid      : csru_active                  ,
        pc         : csru_active_entry.addr       ,
        inst_bits  : csru_active_entry.bits       ,
        ctrl       : csru_active_entry.ctrl       ,
        expt_info  : csru_active_entry.expt       ,
        rd_areg    : csru_active_entry.bits[11:7] ,
        csr_addr   : csru_active_entry.bits[31:20],
        rs1_areg   : csru_active_entry.bits[19:15],
        rs1_data   : csru_active_rs1_data         ,
        can_intr   : 0                            , // 当面は割り込みなし
        rdata      : csru_result                  ,
        mode       : csru_priv_mode               ,
        raise_trap : csru_raise_trap              ,
        trap_vector: csru_trap_vector             ,
        trap_return: csru_trap_return             ,
        minstret                                  ,
        led                                       ,
        aclint                                    ,
    );

    always_ff {
        if_reset {
            csru_active          = 0;
            csru_active_entry    = '0;
            csru_active_rs1_data = 0;
        } else if backend_redirect {
            csru_active          = 0;
            csru_active_entry    = '0;
            csru_active_rs1_data = 0;
        } else if csru_complete {
            csru_active = 0;
        } else if csru_grant {
            csru_active          = 1;
            csru_active_entry    = csru_rdata;
            csru_active_rs1_data = csru_read_data;
        }
    }

    ///////////////////////////////// EX Stage (Issue / Completion) /////////////////////////////////

    let load_has_older_store: logic = storeu_oldest_valid && (storeu_oldest_data.rob_tag - rob_head_tag)
        <: (loadu_rdata.rob_tag - rob_head_tag);

    // issue_queueのrvalidは内部のでソースレジスタがreadyなentryだけを選んでいる
    let load_candidate : logic = loadu_rvalid && !load_has_older_store;
    let store_candidate: logic = storeu_rvalid && storeu_at_head;

    always_comb {
        // Storeはprecise state維持のためROB先頭のみ
        storeu_grant = !memu_active && store_candidate;
        // older Storeが存在しないLoadはROB先頭より前でも実行可能
        loadu_grant = !memu_active && !storeu_grant && load_candidate;
        // MDUがidleなら実行開始・継続
        mdu_grant = mdu_rvalid && mdu_ready && !mdu_busy;
        // CSRはROB先頭かつoperand readyなら実行
        csru_grant = !csru_active && csru_rvalid && csru_at_head;
        // ALUは(fence_iでないまたはROB先頭)かつoperand readyなら実行開始・継続
        alu_grant = alu_rvalid && (!alu_is_fence_i || alu_at_head);
    }

    always_comb {
        alu_complete = alu_grant;

        // 内部の演算が完了したか
        mdu_response_done  = mdu_busy && mdu_result_valid;
        memu_response_done = memu_done;

        // 既にkill済みまたはこのcycleにrollback対象になった場合は演算結果をPRF/ROBへ送らない
        let mdu_killed_now : logic = mdu_killed
            || (rob_rollback_request && mdu_busy && (mdu_active_entry.rob_tag - rob_rollback_request_head)
                >: (rob_rollback_request_tag - rob_rollback_request_head));
        let memu_killed_now: logic = memu_killed
            || (rob_rollback_request && memu_active && (memu_active_entry.rob_tag - rob_rollback_request_head)
                >: (rob_rollback_request_tag - rob_rollback_request_head));

        // killされた命令は完了扱いにしない
        mdu_complete  = mdu_response_done && !mdu_killed_now;
        memu_complete = memu_response_done && !memu_killed_now;

        loadu_complete  = memu_complete && memu_active_is_load;
        storeu_complete = memu_complete && !memu_active_is_load;
        csru_complete   = csru_active;
    }

    always_comb {
        // MEM -> WB
        alu_rready    = alu_grant;
        mdu_rready    = mdu_grant;
        loadu_rready  = loadu_grant;
        storeu_rready = storeu_grant;
        csru_rready   = csru_grant;

        loadu_write_valid = loadu_complete && memu_active_entry.ctrl.is_load && memu_active_entry.bits[11:7] != 0;
        loadu_write_addr  = if memu_active_is_load ? memu_active_entry.rd_preg : 0;
        loadu_write_data  = if memu_active_is_load ? memu_result : 0;

        csru_write_valid = csru_complete && csru_active_entry.ctrl.rwb_en && csru_active_entry.bits[11:7] != 0;
        csru_write_addr  = csru_active_entry.rd_preg;
        csru_write_data  = csru_result;

        mdu_write_valid = mdu_complete && mdu_active_entry.ctrl.rwb_en && mdu_active_entry.bits[11:7] != 0;
        mdu_write_addr  = mdu_active_entry.rd_preg;
        mdu_write_data  = mdu_result;
    }

    let alu_recovery_pc: Addr = switch {
        alu_is_jalr: alu_jalr_target,
        alu_br_take: (alu_rdata.addr + alu_rdata.imm),
        default    : (alu_rdata.addr + (if alu_rdata.ctrl.is_rvc ? 2 : 4))
    };

    always_comb {
        alu_redirect = alu_complete && alu_mispredict;
        csr_redirect = csru_complete && csru_raise_trap;

        control_hazard   = alu_redirect || csr_redirect;
        backend_redirect = csr_redirect;

        rob_rollback_start = rob_rollback_request;
        rob_rollback_tag   = rob_rollback_request_tag;

        control_hazard_pc_next = if csr_redirect ? csru_trap_vector : alu_recovery_pc;
    }

    always_ff {
        if_reset {
            rob_rollback_request      = 0;
            rob_rollback_request_tag  = 0;
            rob_rollback_request_head = 0;
            rob_rollback_request_pc   = 0;
        } else {
            rob_rollback_request = alu_redirect;

            if alu_redirect {
                rob_rollback_request_tag  = alu_rdata.rob_tag;
                rob_rollback_request_head = rob_head_tag;
                rob_rollback_request_pc   = alu_recovery_pc;
            }
        }
    }

    ///////////////////////////////// WB Stage /////////////////////////////////

    always_ff {
        if_reset {
            minstret = 0;
        } else {
            if rob_commit_valid && rob_commit_ready && !rob_commit_data.raise_trap {
                minstret += 1;
            }
        }
    }

    // ROB先頭命令が実際にコミットされた
    let rob_commit_fire: logic = rob_commit_valid && rob_commit_ready && rob_commit_data.ctrl.rwb_en
        && rob_commit_data.rd_areg != 0 && !rob_commit_data.raise_trap;

    // serial_pending := 制御結果がまだ確定していない命令が存在する
    always_ff {
        if_reset {
            serial_pending = 0;
        } else if control_hazard {
            serial_pending = 0;
        } else if (alu_complete && alu_is_fence_i) || csru_complete {
            serial_pending = 0;
        } else if ids_fire && ids_is_serial {
            serial_pending = 1;
        }
    }
    // branch_pending := 分岐結果がまだ確定していない命令が存在する
    always_ff {
        if_reset {
            branch_pending = 0;
        } else if control_hazard {
            branch_pending = 0;
        } else if alu_complete && (alu_rdata.ctrl.is_jump || inst_is_br(alu_rdata.ctrl)) {
            branch_pending = 0;
        } else if ids_fire && ids_is_spec_branch {
            branch_pending = 1;
        }
    }

    always_comb {
        // WB -> END
        rob_commit_ready = !rob_rollback_busy && !rob_rollback_start;

        // Free Listはrollback優先
        flist_wvalid = rob_rollback_restores_rd || rob_commit_fire;
        if rob_rollback_restores_rd {
            flist_wdata = rob_rollback_data.rd_preg;
        } else {
            flist_wdata = rob_commit_data.old_preg;
        }

        rob_rollback_ready = 1;
    }

    ///////////////////////////////// Pipeline trace /////////////////////////////////

    #[ifdef(LOG_PIPELINE)]
    {
        var trace_cycle: u64;
        always_ff {
            if_reset {
                trace_cycle = 0;
                $display("KTRACE\t1");
            } else {
                // Each line records only information available at this point.
                // test/konata.py assigns dynamic instruction IDs and resolves flushes.
                if ids_fire {
                    $display("K\t%0d\tX\t%h\t%h\t%b", trace_cycle, ids_pc, ids_inst_bits, ids_ctrl.itype);
                }
                if rob_allocate_valid && rob_allocate_ready {
                    $display(
                        "K\t%0d\tA\t%0d\t%h\t%h\t%b",
                        trace_cycle,
                        rob_allocate_tag,
                        ids_pc,
                        ids_inst_bits,
                        ids_is_load || ids_is_store,
                    );
                }
                if alu_complete {
                    $display("K\t%0d\tC\t%0d\t%h\t%h", trace_cycle, alu_rdata.rob_tag, alu_rdata.addr, alu_rdata.bits);
                }
                if loadu_complete || storeu_complete {
                    $display(
                        "K\t%0d\tC\t%0d\t%h\t%h",
                        trace_cycle,
                        memu_active_entry.rob_tag,
                        memu_active_entry.addr,
                        memu_active_entry.bits,
                    );
                }
                if mdu_complete {
                    $display(
                        "K\t%0d\tC\t%0d\t%h\t%h",
                        trace_cycle,
                        mdu_active_entry.rob_tag,
                        mdu_active_entry.addr,
                        mdu_active_entry.bits,
                    );
                }
                if csru_complete {
                    $display(
                        "K\t%0d\tC\t%0d\t%h\t%h",
                        trace_cycle,
                        csru_active_entry.rob_tag,
                        csru_active_entry.addr,
                        csru_active_entry.bits,
                    );
                }
                // Register writeの有無にかかわらず、すべてのROB commitを記録する
                if rob_commit_valid && rob_commit_ready {
                    $display(
                        "K\t%0d\tW\t%0d\t%h\t%h",
                        trace_cycle,
                        rob_head_tag,
                        rob_commit_data.addr,
                        rob_commit_data.bits,
                    );
                }
                if backend_redirect {
                    $display(
                        "K\t%0d\tR\tBACKEND\t%h\t%h\t%h",
                        trace_cycle,
                        csru_rdata.addr,
                        csru_rdata.bits,
                        control_hazard_pc_next,
                    );
                } else if control_hazard {
                    $display(
                        "K\t%0d\tR\tCTRL\t%h\t%h\t%h\t%0d\t%0d",
                        trace_cycle,
                        alu_rdata.addr,
                        alu_rdata.bits,
                        control_hazard_pc_next,
                        alu_rdata.rob_tag,
                        rob_head_tag,
                    );
                } else if prediction_redirect {
                    $display("K\t%0d\tR\tPRED\t%h\t%h\t%h", trace_cycle, ids_pc, ids_inst_bits, ids_pred_target);
                }
                trace_cycle += 1;
            }
        }
    }

    ///////////////////////////////// Bimodal & BTB/////////////////////////////////

    inst bp: bimodal_predictor (
        clk  ,
        rst  ,

        predict_pc   : ids_pc            ,
        predict_taken: bimodal_pred_taken,
        predict_valid: bimodal_pred_valid,

        update_valid: alu_rvalid && alu_rready && inst_is_br(alu_rdata.ctrl),
        update_pc   : alu_rdata.addr                                        ,
        update_taken: alu_br_take                                           ,
    );

    inst btb: branch_target_buffer (
        clk  ,
        rst  ,

        predict_pc    : ids_pc    ,
        predict_hit   : btb_hit   ,
        predict_target: btb_target,

        update_valid : alu_rvalid && alu_rready && alu_is_jalr,
        update_pc    : alu_rdata.addr                         ,
        update_target: alu_jalr_target                        ,
    );

    ///////////////////////////////// FIFO /////////////////////////////////

    inst aluq: issue_queue #(
        ENTRY_COUNT: 8,
        INDEX_WIDTH: 3,
    ) (
        clk                    ,
        rst                    ,
        flush: backend_redirect,

        squash     : rob_rollback_request     ,
        squash_head: rob_rollback_request_head,
        squash_tag : rob_rollback_request_tag ,

        wvalid   : alu_wvalid        ,
        wready   : alu_wready        ,
        wdata    : alu_wdata         ,
        wrs1ready: dispatch_wrs1ready,
        wrs2ready: dispatch_wrs2ready,

        wakeup0_valid: alu_write_valid  ,
        wakeup0_preg : alu_write_addr   ,
        wakeup1_valid: loadu_write_valid,
        wakeup1_preg : loadu_write_addr ,
        wakeup2_valid: mdu_write_valid  ,
        wakeup2_preg : mdu_write_addr   ,
        wakeup3_valid: csru_write_valid ,
        wakeup3_preg : csru_write_addr  ,

        rvalid: alu_rvalid,
        rready: alu_rready,
        rdata : alu_rdata ,

        oldest_valid: alu_oldest_valid,
        oldest_data : alu_oldest_data ,
    );

    inst loadq: issue_queue (
        clk                    ,
        rst                    ,
        flush: backend_redirect,

        squash     : rob_rollback_request     ,
        squash_head: rob_rollback_request_head,
        squash_tag : rob_rollback_request_tag ,

        wvalid   : loadu_wvalid      ,
        wready   : loadu_wready      ,
        wdata    : loadu_wdata       ,
        wrs1ready: dispatch_wrs1ready,
        wrs2ready: dispatch_wrs2ready,

        wakeup0_valid: alu_write_valid  ,
        wakeup0_preg : alu_write_addr   ,
        wakeup1_valid: loadu_write_valid,
        wakeup1_preg : loadu_write_addr ,
        wakeup2_valid: mdu_write_valid  ,
        wakeup2_preg : mdu_write_addr   ,
        wakeup3_valid: csru_write_valid ,
        wakeup3_preg : csru_write_addr  ,

        rvalid: loadu_rvalid,
        rready: loadu_rready,
        rdata : loadu_rdata ,

        oldest_valid: loadu_oldest_valid,
        oldest_data : loadu_oldest_data ,
    );

    inst storeq: issue_queue (
        clk                    ,
        rst                    ,
        flush: backend_redirect,

        squash     : rob_rollback_request     ,
        squash_head: rob_rollback_request_head,
        squash_tag : rob_rollback_request_tag ,

        wvalid   : storeu_wvalid     ,
        wready   : storeu_wready     ,
        wdata    : storeu_wdata      ,
        wrs1ready: dispatch_wrs1ready,
        wrs2ready: dispatch_wrs2ready,

        wakeup0_valid: alu_write_valid  ,
        wakeup0_preg : alu_write_addr   ,
        wakeup1_valid: loadu_write_valid,
        wakeup1_preg : loadu_write_addr ,
        wakeup2_valid: mdu_write_valid  ,
        wakeup2_preg : mdu_write_addr   ,
        wakeup3_valid: csru_write_valid ,
        wakeup3_preg : csru_write_addr  ,

        rvalid: storeu_rvalid,
        rready: storeu_rready,
        rdata : storeu_rdata ,

        oldest_valid: storeu_oldest_valid,
        oldest_data : storeu_oldest_data ,
    );

    inst muldivq: issue_queue #(
        ENTRY_COUNT: 8,
        INDEX_WIDTH: 3,
    ) (
        clk                    ,
        rst                    ,
        flush: backend_redirect,

        squash     : rob_rollback_request     ,
        squash_head: rob_rollback_request_head,
        squash_tag : rob_rollback_request_tag ,

        wvalid   : mdu_wvalid        ,
        wready   : mdu_wready        ,
        wdata    : mdu_wdata         ,
        wrs1ready: dispatch_wrs1ready,
        wrs2ready: dispatch_wrs2ready,

        wakeup0_valid: alu_write_valid  ,
        wakeup0_preg : alu_write_addr   ,
        wakeup1_valid: loadu_write_valid,
        wakeup1_preg : loadu_write_addr ,
        wakeup2_valid: mdu_write_valid  ,
        wakeup2_preg : mdu_write_addr   ,
        wakeup3_valid: csru_write_valid ,
        wakeup3_preg : csru_write_addr  ,

        rvalid: mdu_rvalid,
        rready: mdu_rready,
        rdata : mdu_rdata ,

        oldest_valid: mdu_oldest_valid,
        oldest_data : mdu_oldest_data ,
    );

    inst csrq: issue_queue (
        clk                    ,
        rst                    ,
        flush: backend_redirect,

        squash     : rob_rollback_request     ,
        squash_head: rob_rollback_request_head,
        squash_tag : rob_rollback_request_tag ,

        wvalid   : csru_wvalid       ,
        wready   : csru_wready       ,
        wdata    : csru_wdata        ,
        wrs1ready: dispatch_wrs1ready,
        wrs2ready: dispatch_wrs2ready,

        wakeup0_valid: alu_write_valid  ,
        wakeup0_preg : alu_write_addr   ,
        wakeup1_valid: loadu_write_valid,
        wakeup1_preg : loadu_write_addr ,
        wakeup2_valid: mdu_write_valid  ,
        wakeup2_preg : mdu_write_addr   ,
        wakeup3_valid: csru_write_valid ,
        wakeup3_preg : csru_write_addr  ,

        rready: csru_rready,
        rvalid: csru_rvalid,
        rdata : csru_rdata ,

        oldest_valid: csru_oldest_valid,
        oldest_data : csru_oldest_data ,
    );

    inst rob: reorder_buffer #(
        DATA_TYPE: rob_entry_type,
        WIDTH    : ROB_WIDTH     ,
    ) (
        clk  ,
        rst  ,
        // トラップはROB先頭でのみ受理するため、ここで全破棄できる
        flush: backend_redirect,

        allocate_valid: rob_allocate_valid,
        allocate_ready: rob_allocate_ready,
        allocate_done : rob_allocate_done ,
        allocate_data : rob_allocate_data ,
        allocate_tag  : rob_allocate_tag  ,

        complete0_valid: alu_complete     ,
        complete0_tag  : alu_rdata.rob_tag,

        complete1_valid: loadu_complete || storeu_complete,
        complete1_tag  : memu_active_entry.rob_tag        ,

        complete2_valid: mdu_complete            ,
        complete2_tag  : mdu_active_entry.rob_tag,

        complete3_valid: csru_complete            ,
        complete3_tag  : csru_active_entry.rob_tag,

        commit_valid: rob_commit_valid,
        commit_ready: rob_commit_ready,
        commit_data : rob_commit_data ,

        head_valid: rob_head_valid,
        head_tag  : rob_head_tag  ,

        rollback_start: rob_rollback_start,
        rollback_tag  : rob_rollback_tag  ,
        rollback_valid: rob_rollback_valid,
        rollback_ready: rob_rollback_ready,
        rollback_data : rob_rollback_data ,
        rollback_busy : rob_rollback_busy ,
    );

    inst flist: free_list (
        clk                 ,
        rst                 ,
        rready: flist_rready,
        rvalid: flist_rvalid,
        rdata : flist_rdata ,
        wready: flist_wready,
        wvalid: flist_wvalid,
        wdata : flist_wdata ,
    );

    inst rat: register_alias_table (
        clk                         ,
        rst                         ,
        flush      : rat_flush      ,
        read1_addr : rat_read1_addr ,
        read1_data : rat_read1_data ,
        read2_addr : rat_read2_addr ,
        read2_data : rat_read2_data ,
        write_valid: rat_write_valid,
        write_addr : rat_write_addr ,
        write_data : rat_write_data ,
        write_old  : rat_write_old  ,
    );

    inst prf: physical_register_file (
        clk                            ,
        rst                            ,
        read1_addr  : alu_read1_addr   ,
        read1_data  : alu_read1_data   ,
        read2_addr  : alu_read2_addr   ,
        read2_data  : alu_read2_data   ,
        read3_addr  : loadu_read_addr  ,
        read3_data  : loadu_read_data  ,
        read4_addr  : storeu_read1_addr,
        read4_data  : storeu_read1_data,
        read5_addr  : storeu_read2_addr,
        read5_data  : storeu_read2_data,
        read6_addr  : mdu_read1_addr   ,
        read6_data  : mdu_read1_data   ,
        read7_addr  : mdu_read2_addr   ,
        read7_data  : mdu_read2_data   ,
        read8_addr  : csru_read_addr   ,
        read8_data  : csru_read_data   ,
        write1_valid: csru_write_valid ,
        write1_addr : csru_write_addr  ,
        write1_data : csru_write_data  ,
        write2_valid: loadu_write_valid,
        write2_addr : loadu_write_addr ,
        write2_data : loadu_write_data ,
        write3_valid: mdu_write_valid  ,
        write3_addr : mdu_write_addr   ,
        write3_data : mdu_write_data   ,
        write4_valid: alu_write_valid  ,
        write4_addr : alu_write_addr   ,
        write4_data : alu_write_data   ,
    );
}
