module fifo #(
    param DATA_TYPE    : type  = logic,
    param WIDTH        : u32   = 2    ,
    param ALLOW_REPLACE: logic = true ,
) (
    clk       : input  clock        ,
    rst       : input  reset        ,
    flush     : input  logic        ,
    wready    : output logic        ,
    wready_two: output logic     = _,
    wvalid    : input  logic        ,
    wdata     : input  DATA_TYPE    ,
    rready    : input  logic        ,
    rvalid    : output logic        ,
    rdata     : output DATA_TYPE    ,
) {
    if WIDTH == 1 :width_one {
        always_comb {
            wready     = !rvalid || (ALLOW_REPLACE && rready);
            wready_two = 0;
        }
        always_ff {
            if_reset {
                rdata  = 0;
                rvalid = 0;
            } else {
                if flush {
                    rvalid = 0;
                } else {
                    if wready && wvalid {
                        rdata  = wdata;
                        rvalid = 1;
                    } else if rready {
                        rvalid = 0;
                    }
                }
            }
        }
    } else {
        type Ptr        = logic<WIDTH>;
        var head      : Ptr         ;
        var tail      : Ptr         ;
        let tail_plus1: Ptr          = tail + 1 as Ptr;
        let tail_plus2: Ptr          = tail + 2 as Ptr;
        let full      : logic        = tail_plus1 == head;
        let pop       : logic        = rready && rvalid;

        #[sv("syn_ramstyle=\"registers\"")]
        var mem: DATA_TYPE [2 ** WIDTH];

        always_comb {
            rvalid     = head != tail;
            rdata      = mem[head];
            wready     = !full || (ALLOW_REPLACE && pop); // 1要素を書き込める
            wready_two = !full && (tail_plus2 != head || pop); // 2要素を書き込める
        }

        #[allow(missing_reset_statement)]
        always_ff {
            if_reset {
                head = 0;
                tail = 0;
            } else {
                if flush {
                    head = 0;
                    tail = 0;
                } else {
                    if wready && wvalid {
                        mem[tail] = wdata;
                        tail      = tail + 1;
                    }
                    if rready && rvalid {
                        head = head + 1;
                    }
                }
            }
        }
    }
}
