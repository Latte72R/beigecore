module reorder_buffer #(
    param DATA_TYPE: type = logic,
    param WIDTH    : u32  = 2    ,
) (
    clk  : input clock,
    rst  : input reset,
    flush: input logic,

    // EXから新しい命令を登録する (allocate)
    allocate_valid: input  logic           ,
    allocate_ready: output logic           ,
    allocate_done : input  logic           ,
    allocate_data : input  DATA_TYPE       ,
    allocate_tag  : output logic    <WIDTH>,

    // 実行結果を埋める (complete)
    // ALU
    complete0_valid: input logic           ,
    complete0_tag  : input logic    <WIDTH>,
    complete0_data : input DATA_TYPE       ,

    // MEMU
    complete1_valid: input logic           ,
    complete1_tag  : input logic    <WIDTH>,
    complete1_data : input DATA_TYPE       ,

    // MDU
    complete2_valid: input logic           ,
    complete2_tag  : input logic    <WIDTH>,
    complete2_data : input DATA_TYPE       ,

    // CSRU
    complete3_valid: input logic           ,
    complete3_tag  : input logic    <WIDTH>,
    complete3_data : input DATA_TYPE       ,

    // 先頭の完成済み命令を読みだす (commit)
    commit_valid: output logic    ,
    commit_ready: input  logic    ,
    commit_data : output DATA_TYPE,

    // head の情報（Storeの先頭判定につかう）
    head_valid: output logic       ,
    head_tag  : output logic<WIDTH>,
) {
    if WIDTH <= 1 :invalid_width {
        initial {
            $fatal(1, "reorder_buffer requires WIDTH > 1");
        }
    } else {
        type Ptr        = logic<WIDTH>;
        var head      : Ptr         ;
        var tail      : Ptr         ;
        let tail_plus1: Ptr          = tail + 1 as Ptr;
        let full      : logic        = tail_plus1 == head;

        // 実際に成立（発火）したか
        let commit_fire  : logic = commit_valid && commit_ready;
        let allocate_fire: logic = allocate_valid && allocate_ready;

        var mem      : DATA_TYPE [2 ** WIDTH];
        var completed: logic     [2 ** WIDTH];

        always_comb {
            // ROB head
            head_valid = head != tail;
            head_tag   = head;

            // commit
            commit_valid = head_valid && completed[head];
            commit_data  = mem[head];

            // allocate
            allocate_ready = !full || commit_fire;
            allocate_tag   = tail;
        }

        #[allow(missing_reset_statement)]
        always_ff {
            if_reset {
                head = 0;
                tail = 0;
            } else {
                if flush {
                    head = 0;
                    tail = 0;
                } else {
                    if allocate_fire {
                        mem[tail]       = allocate_data;
                        completed[tail] = allocate_done;
                        tail            = tail + 1;
                    }
                    if complete0_valid {
                        mem[complete0_tag]       = complete0_data;
                        completed[complete0_tag] = 1;
                    }
                    if complete1_valid {
                        mem[complete1_tag]       = complete1_data;
                        completed[complete1_tag] = 1;
                    }
                    if complete2_valid {
                        mem[complete2_tag]       = complete2_data;
                        completed[complete2_tag] = 1;
                    }
                    if complete3_valid {
                        mem[complete3_tag]       = complete3_data;
                        completed[complete3_tag] = 1;
                    }
                    if commit_fire {
                        completed[head] = 0;
                        head            = head + 1;
                    }
                }
            }
        }
    }
}
