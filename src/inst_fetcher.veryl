import eei::*;

module inst_fetcher (
    clk    : input   clock              ,
    rst    : input   reset              ,
    core_if: modport core_inst_if::slave,
    mem_if : modport Membus::master     ,
) {
    struct fetch_fifo_type {
        addr: Addr                    ,
        bits: logic<MEMBUS_DATA_WIDTH>,
    }

    var fetch_fifo_flush : logic          ;
    var fetch_fifo_wvalid: logic          ;
    var fetch_fifo_wready: logic          ;
    var fetch_fifo_wdata : fetch_fifo_type;
    var fetch_fifo_rdata : fetch_fifo_type;
    var fetch_fifo_rready: logic          ;
    var fetch_fifo_rvalid: logic          ;

    inst fetch_fifo: fifo #(
        DATA_TYPE   : fetch_fifo_type,
        WIDTH       : 2              ,
        FALL_THROUGH: true           ,
    ) (
        clk                          ,
        rst                          ,
        flush     : fetch_fifo_flush ,
        wready    : _                ,
        wready_two: fetch_fifo_wready,
        wvalid    : fetch_fifo_wvalid,
        wdata     : fetch_fifo_wdata ,
        rready    : fetch_fifo_rready,
        rvalid    : fetch_fifo_rvalid,
        rdata     : fetch_fifo_rdata ,
    );

    struct issue_fifo_type {
        addr       : Addr ,
        bits       : Inst ,
        is_rvc     : logic,
        pred_taken : logic,
        pred_target: Addr ,
    }

    var issue_fifo_flush : logic          ;
    var issue_fifo_wvalid: logic          ;
    var issue_fifo_wready: logic          ;
    var issue_fifo_wdata : issue_fifo_type;
    var issue_fifo_rdata : issue_fifo_type;
    var issue_fifo_rready: logic          ;
    var issue_fifo_rvalid: logic          ;

    inst issue_fifo: fifo #(
        DATA_TYPE    : issue_fifo_type,
        WIDTH        : 2              ,
        ALLOW_REPLACE: false          ,
        FALL_THROUGH : true           ,
    ) (
        clk                      ,
        rst                      ,
        flush : issue_fifo_flush ,
        wready: issue_fifo_wready,
        wvalid: issue_fifo_wvalid,
        wdata : issue_fifo_wdata ,
        rready: issue_fifo_rready,
        rvalid: issue_fifo_rvalid,
        rdata : issue_fifo_rdata ,
    );

    let issue_fire: logic = issue_fifo_wvalid && issue_fifo_wready;

    /*--------- issue logic ----------*/
    var issue_pc_offset: logic<3>;

    var issue_is_rdata_saved: logic    ;
    var issue_saved_addr    : Addr     ;
    var issue_saved_bits    : logic<16>; // rdata[63:48]

    // instruction converter
    var rvcc_is_rvc: logic;
    var rvcc_inst32: Inst ;

    inst rvcc: rvc_converter (
        inst16: case issue_pc_offset {
            0      : fetch_fifo_rdata.bits[15:0],
            2      : fetch_fifo_rdata.bits[31:16],
            4      : fetch_fifo_rdata.bits[47:32],
            6      : fetch_fifo_rdata.bits[63:48],
            default: 0,
        },
        is_rvc: rvcc_is_rvc,
        inst32: rvcc_inst32,
    );

    let prediction_bits: Inst = if issue_pc_offset == 6 && issue_is_rdata_saved ?
        {fetch_fifo_rdata.bits[15:0], issue_saved_bits}
    : if rvcc_is_rvc ?
        rvcc_inst32
    :
        case issue_pc_offset {
            0      : fetch_fifo_rdata.bits[31:0],
            2      : fetch_fifo_rdata.bits[47:16],
            4      : fetch_fifo_rdata.bits[63:32],
            default: 0,
        }
    ;
    let prediction_pc          : Addr      = if issue_pc_offset == 6 && issue_is_rdata_saved ?
        {issue_saved_addr[msb:3], issue_pc_offset}
    :
        {fetch_fifo_rdata.addr[msb:3], issue_pc_offset}
    ;
    let prediction_op          : logic<7>  = prediction_bits[6:0];
    let prediction_imm_b_g     : logic<12> = {
        prediction_bits[31], prediction_bits[7], prediction_bits[30:25], prediction_bits[11:8]
    };
    let prediction_imm_j_g     : logic<20> = {
        prediction_bits[31], prediction_bits[19:12], prediction_bits[20], prediction_bits[30:21]
    };
    let prediction_imm_b       : UIntX     = {
        prediction_bits[31] repeat XLEN - $bits(prediction_imm_b_g) - 1, prediction_imm_b_g, 1'b0
    };
    let prediction_imm_j       : UIntX     = {
        prediction_bits[31] repeat XLEN - $bits(prediction_imm_j_g) - 1, prediction_imm_j_g, 1'b0
    };
    let prediction_is_jal      : logic     = prediction_op == OP_JAL;
    let prediction_is_jalr     : logic     = prediction_op == OP_JALR;
    let prediction_is_branch   : logic     = prediction_op == OP_BRANCH;
    let prediction_branch_taken: logic     = if core_if.prediction_bimodal_valid ?
        core_if.prediction_bimodal_taken
    :
        prediction_bits[31]
    ;
    let predicted_taken        : logic     = prediction_is_jal || (prediction_is_jalr && core_if.prediction_btb_hit)
        || (prediction_is_branch && prediction_branch_taken);
    let predicted_target       : Addr      = if prediction_is_jalr ?
        core_if.prediction_btb_target
    : if prediction_is_jal ?
        prediction_pc + prediction_imm_j
    :
        prediction_pc + prediction_imm_b
    ;

    always_ff {
        if_reset {
            issue_pc_offset      = 0;
            issue_is_rdata_saved = 0;
            issue_saved_addr     = 0;
            issue_saved_bits     = 0;
        } else {
            if core_if.is_redirect || core_if.prediction_redirect {
                issue_pc_offset      = if core_if.is_redirect ? core_if.next_pc[2:0] : predicted_target[2:0];
                issue_is_rdata_saved = 0;
            } else {
                // offsetが6な32ビット命令の場合、
                // アドレスと上位16ビットを保存してFIFOを読み進める
                if issue_pc_offset == 6 && !rvcc_is_rvc && !issue_is_rdata_saved {
                    if fetch_fifo_rvalid {
                        issue_is_rdata_saved = 1;
                        issue_saved_addr     = fetch_fifo_rdata.addr;
                        issue_saved_bits     = fetch_fifo_rdata.bits[63:48];
                    }
                } else {
                    if issue_fifo_wready {
                        if issue_fifo_wvalid {
                            issue_pc_offset      += if issue_is_rdata_saved || !rvcc_is_rvc ? 4 : 2;
                            issue_is_rdata_saved =  0;
                        }
                    }
                }
            }
        }
    }

    // fetch_fifo <-> issue_fifo
    always_comb {
        let raddr : Addr                     = fetch_fifo_rdata.addr;
        let rdata : logic<MEMBUS_DATA_WIDTH> = fetch_fifo_rdata.bits;
        let offset: logic<3>                 = issue_pc_offset;

        fetch_fifo_rready = 0;
        issue_fifo_wvalid = 0;
        issue_fifo_wdata  = 0;

        if fetch_fifo_rvalid {
            if offset == 6 {
                // offsetが6な32ビット命令の場合、
                // 命令は{rdata_next[15:0], rdata[63:48}になる
                if issue_is_rdata_saved {
                    issue_fifo_wvalid       = 1;
                    issue_fifo_wdata.addr   = {issue_saved_addr[msb:3], offset};
                    issue_fifo_wdata.bits   = {rdata[15:0], issue_saved_bits};
                    issue_fifo_wdata.is_rvc = 0;
                } else {
                    if rvcc_is_rvc {
                        fetch_fifo_rready       = issue_fifo_wready;
                        issue_fifo_wvalid       = 1;
                        issue_fifo_wdata.addr   = {raddr[msb:3], offset};
                        issue_fifo_wdata.is_rvc = 1;
                        issue_fifo_wdata.bits   = rvcc_inst32;
                    } else {
                        // save inst[15:0]
                        fetch_fifo_rready = 1; // Read next 8 bytes
                    }
                }
            } else {
                fetch_fifo_rready       = issue_fifo_wready && !rvcc_is_rvc && offset == 4;
                issue_fifo_wvalid       = 1;
                issue_fifo_wdata.addr   = {raddr[msb:3], offset};
                issue_fifo_wdata.is_rvc = rvcc_is_rvc;
                if rvcc_is_rvc {
                    issue_fifo_wdata.bits = rvcc_inst32;
                } else {
                    issue_fifo_wdata.bits = case offset {
                        0      : rdata[31:0],
                        2      : rdata[47:16],
                        4      : rdata[63:32],
                        default: 0,
                    };
                }
            }
        }
        issue_fifo_wdata.pred_taken  = predicted_taken;
        issue_fifo_wdata.pred_target = predicted_target;
    }

    // issue_fifo <-> core
    let local_prediction_redirect: logic = !core_if.is_redirect && issue_fire && predicted_taken;

    always_comb {
        issue_fifo_flush            = core_if.is_redirect;
        issue_fifo_rready           = core_if.rready;
        core_if.rvalid              = issue_fifo_rvalid;
        core_if.raddr               = issue_fifo_rdata.addr;
        core_if.rdata               = issue_fifo_rdata.bits;
        core_if.is_rvc              = issue_fifo_rdata.is_rvc;
        core_if.prediction_query_pc = prediction_pc;
        core_if.prediction_taken    = issue_fifo_rdata.pred_taken;
        core_if.prediction_target   = issue_fifo_rdata.pred_target;
        core_if.prediction_redirect = local_prediction_redirect;

    }

    /*--------- fetch logic ----------*/
    var fetch_pc          : Addr ;
    var fetch_requested   : logic;
    var fetch_pc_requested: Addr ;

    let redirect_addr  : Addr = {core_if.next_pc[XLEN - 1:3], 3'b0};
    let prediction_addr: Addr = {predicted_target[XLEN - 1:3], 3'b0};

    always_comb {
        mem_if.valid = 0;
        mem_if.addr  = 0;
        mem_if.wen   = 0;
        mem_if.wdata = 0;
        mem_if.wmask = 0;

        if local_prediction_redirect {
            // Decode段の予測redirectだけは同じサイクルにtargetを要求する
            // 既存要求がある場合はその応答を受け取るサイクルに切り替える
            mem_if.valid = !fetch_requested || mem_if.rvalid;
            mem_if.addr  = prediction_addr;
        } else {
            mem_if.valid = fetch_fifo_wready;
            if fetch_requested {
                mem_if.valid = mem_if.valid && mem_if.rvalid;
            }
            mem_if.addr = fetch_pc;
        }
    }

    // memory -> fetch_fifo
    always_comb {
        fetch_fifo_flush      = core_if.is_redirect || local_prediction_redirect;
        fetch_fifo_wvalid     = fetch_requested && mem_if.rvalid;
        fetch_fifo_wdata.addr = fetch_pc_requested;
        fetch_fifo_wdata.bits = mem_if.rdata;
    }

    always_ff {
        if_reset {
            fetch_pc           = INITIAL_PC;
            fetch_requested    = 0;
            fetch_pc_requested = 0;
        } else {
            if core_if.is_redirect || local_prediction_redirect {
                if local_prediction_redirect && mem_if.valid && mem_if.ready {
                    fetch_pc           = prediction_addr + 8;
                    fetch_requested    = 1;
                    fetch_pc_requested = prediction_addr;
                } else {
                    fetch_pc           = if local_prediction_redirect ? prediction_addr : redirect_addr;
                    fetch_requested    = 0;
                    fetch_pc_requested = 0;
                }
            } else {
                if fetch_requested {
                    if mem_if.rvalid {
                        fetch_requested = mem_if.ready && mem_if.valid;
                        if mem_if.ready && mem_if.valid {
                            fetch_pc_requested =  fetch_pc;
                            fetch_pc           += 8;
                        }
                    }
                } else {
                    if mem_if.ready && mem_if.valid {
                        fetch_requested    =  1;
                        fetch_pc_requested =  fetch_pc;
                        fetch_pc           += 8;
                    }
                }
            }
        }
    }

    #[ifdef(LOG_PIPELINE)]
    {
        var trace_cycle: u64;
        always_ff {
            if_reset {
                trace_cycle = 0;
            } else {
                if mem_if.valid && mem_if.ready {
                    $display("K\t%0d\tQ\t%h", trace_cycle, mem_if.addr);
                }
                if fetch_fifo_wvalid {
                    $display("K\t%0d\tP\t%h\t%h", trace_cycle, fetch_fifo_wdata.addr, fetch_fifo_wdata.bits);
                }
                if issue_fire {
                    $display("K\t%0d\tF\t%h\t%h", trace_cycle, issue_fifo_wdata.addr, issue_fifo_wdata.bits);
                }
                if local_prediction_redirect {
                    $display(
                        "K\t%0d\tR\tPRED\t%h\t%h\t%h",
                        trace_cycle,
                        issue_fifo_wdata.addr,
                        issue_fifo_wdata.bits,
                        predicted_target,
                    );
                }
                trace_cycle += 1;
            }
        }
    }
}
