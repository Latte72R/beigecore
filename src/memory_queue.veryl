import eei::*;
import corectrl::*;

// In-order memory queue with selective removal of a mispredicted branch's
// younger entries.  ROB order and queue insertion order are identical.
module memory_queue (
    clk  : input clock,
    rst  : input reset,
    flush: input logic,

    squash     : input logic ,
    squash_head: input RobTag,
    squash_tag : input RobTag,

    wready   : output logic   ,
    wvalid   : input  logic   ,
    wdata    : input  euq_type,
    wrs1ready: input  logic   ,
    wrs2ready: input  logic   ,

    wakeup0_valid: input logic  ,
    wakeup0_preg : input PhysReg,
    wakeup1_valid: input logic  ,
    wakeup1_preg : input PhysReg,
    wakeup2_valid: input logic  ,
    wakeup2_preg : input PhysReg,
    wakeup3_valid: input logic  ,
    wakeup3_preg : input PhysReg,

    // MEMUが処理中のLoadを、ready entryの変化から保護する。
    lock_valid: input logic ,
    lock_tag  : input RobTag,

    rready: input  logic   ,
    rvalid: output logic   ,
    rdata : output euq_type,
) {
    // 8-slot ring FIFO. 1 slot is left unused so count can distinguish
    // empty and full without adding another count bit.
    struct memory_entry_type {
        data     : euq_type,
        rs1_ready: logic   ,
        rs2_ready: logic   ,
    }

    var entries           : memory_entry_type    [8];
    var entries_next      : memory_entry_type    [8];
    var valid             : logic                [8];
    var valid_next        : logic                [8];
    var count             : logic            <3>    ;
    var count_next        : logic            <3>    ;
    var head_ptr          : logic            <3>    ;
    var head_next         : logic            <3>    ;
    var tail_ptr          : logic            <3>    ;
    var tail_next         : logic            <3>    ;
    var keep_count        : logic            <3>    ;
    var head_entry        : memory_entry_type       ;
    var next_head_entry   : memory_entry_type       ;
    var head_pending_entry: memory_entry_type       ;
    var head_pending_valid: logic                   ;
    var squash_keep       : logic                [8];
    var squash_sum1       : logic            <2> [4];
    var squash_sum2       : logic            <3> [2];
    var squash_sum3       : logic            <4>    ;

    // この段階ではMemory Queue内の順序をFIFOで保つ。
    // ROB head制約は外すが、Load/Storeのメモリ順序は後でdisambiguationを
    // 追加するまで崩さない。
    let head_ready       : logic = count != 0 && !head_pending_valid && head_entry.rs1_ready && head_entry.rs2_ready;
    let lock_matches_head: logic = !lock_valid || (count != 0 && head_entry.data.rob_tag == lock_tag);

    always_comb {
        // MEMUが処理中ならready状態に関係なく同じheadを保持する。
        rvalid = count != 0 && !head_pending_valid && lock_matches_head && (lock_valid || head_ready);
        rdata  = head_entry.data;
        wready = count != 7;
    }

    always_comb {
        entries_next = entries;
        count_next   = count;
        head_next    = head_ptr;
        tail_next    = tail_ptr;
        keep_count   = 0;
        for i in 0..8 {
            valid_next[i] = valid[i];
        }
        for i in 0..8 {
            squash_keep[i] = 0;
        }
        for i in 0..4 {
            squash_sum1[i] = 0;
        }
        for i in 0..2 {
            squash_sum2[i] = 0;
        }
        squash_sum3     = 0;
        next_head_entry = entries[head_ptr + 1];

        // pop後の次entryに同cycleのwakeupを反映する。
        if (wakeup0_valid && next_head_entry.data.rs1_preg == wakeup0_preg)
            || (wakeup1_valid && next_head_entry.data.rs1_preg == wakeup1_preg)
            || (wakeup2_valid && next_head_entry.data.rs1_preg == wakeup2_preg)
            || (wakeup3_valid && next_head_entry.data.rs1_preg == wakeup3_preg) {
            next_head_entry.rs1_ready = 1;
        }
        if (wakeup0_valid && next_head_entry.data.rs2_preg == wakeup0_preg)
            || (wakeup1_valid && next_head_entry.data.rs2_preg == wakeup1_preg)
            || (wakeup2_valid && next_head_entry.data.rs2_preg == wakeup2_preg)
            || (wakeup3_valid && next_head_entry.data.rs2_preg == wakeup3_preg) {
            next_head_entry.rs2_ready = 1;
        }

        // Wakeupは各entryのready bitだけを更新する。通常のpopでは
        // エントリを移動しないので、410-bitデータの前詰めが発生しない。
        for i in 0..8 {
            if i <: count
                && ((wakeup0_valid && entries[head_ptr + i as 3].data.rs1_preg == wakeup0_preg)
                    || (wakeup1_valid && entries[head_ptr + i as 3].data.rs1_preg == wakeup1_preg)
                    || (wakeup2_valid && entries[head_ptr + i as 3].data.rs1_preg == wakeup2_preg)
                    || (wakeup3_valid && entries[head_ptr + i as 3].data.rs1_preg == wakeup3_preg)) {
                entries_next[head_ptr + i as 3].rs1_ready = 1;
            }
            if i <: count
                && ((wakeup0_valid && entries[head_ptr + i as 3].data.rs2_preg == wakeup0_preg)
                    || (wakeup1_valid && entries[head_ptr + i as 3].data.rs2_preg == wakeup1_preg)
                    || (wakeup2_valid && entries[head_ptr + i as 3].data.rs2_preg == wakeup2_preg)
                    || (wakeup3_valid && entries[head_ptr + i as 3].data.rs2_preg == wakeup3_preg)) {
                entries_next[head_ptr + i as 3].rs2_ready = 1;
            }
        }

        if rvalid && rready {
            head_next            += 1;
            count_next           -= 1;
            valid_next[head_ptr] =  0;
        }

        if wvalid && wready {
            tail_next            += 1;
            count_next           += 1;
            valid_next[tail_ptr] =  1;
        }

        // Younger entries are a suffix because insertion is in program order.
        // Ring FIFOでは、保持するprefixの長さからtailだけを再設定する。
        if squash {
            for i in 0..8 {
                if valid_next[i] {
                    if wvalid && wready && tail_ptr == i as 3 {
                        squash_keep[i] = !((wdata.rob_tag - squash_head) >: (squash_tag - squash_head));
                    } else {
                        squash_keep[i] = !((entries[i].data.rob_tag - squash_head) >: (squash_tag - squash_head));
                    }
                }
            }
            squash_sum1[0] = {1'b0, squash_keep[0]} + {1'b0, squash_keep[1]};
            squash_sum1[1] = {1'b0, squash_keep[2]} + {1'b0, squash_keep[3]};
            squash_sum1[2] = {1'b0, squash_keep[4]} + {1'b0, squash_keep[5]};
            squash_sum1[3] = {1'b0, squash_keep[6]} + {1'b0, squash_keep[7]};
            squash_sum2[0] = {1'b0, squash_sum1[0]} + {1'b0, squash_sum1[1]};
            squash_sum2[1] = {1'b0, squash_sum1[2]} + {1'b0, squash_sum1[3]};
            squash_sum3    = {1'b0, squash_sum2[0]} + {1'b0, squash_sum2[1]};
            keep_count     = squash_sum3[2:0];
            tail_next      = head_next + keep_count;
            count_next     = keep_count;
            for i in 0..8 {
                if !squash_keep[i] {
                    valid_next[i] = 0;
                }
            }
        }
    }

    #[allow(missing_reset_statement)]
    always_ff {
        if_reset {
            count              = 0;
            head_ptr           = 0;
            tail_ptr           = 0;
            head_entry         = '0;
            head_pending_entry = '0;
            head_pending_valid = 0;
            for i in 0..8 {
                entries[i] = '0;
                valid[i]   = 0;
            }
        } else if flush {
            count              = 0;
            head_ptr           = 0;
            tail_ptr           = 0;
            head_entry         = '0;
            head_pending_entry = '0;
            head_pending_valid = 0;
            for i in 0..8 {
                entries[i] = '0;
                valid[i]   = 0;
            }
        } else {
            entries = entries_next;
            if wvalid && wready {
                entries[tail_ptr].data      = wdata;
                entries[tail_ptr].rs1_ready = wrs1ready;
                entries[tail_ptr].rs2_ready = wrs2ready;
            }

            // dispatch入力をheadへ直送せず、1段のpendingレジスタで受ける。
            // これによりfrontendからhead_entry Dまでの経路を分割する。
            if head_pending_valid {
                head_entry = head_pending_entry;
                if (wakeup0_valid && head_pending_entry.data.rs1_preg == wakeup0_preg)
                    || (wakeup1_valid && head_pending_entry.data.rs1_preg == wakeup1_preg)
                    || (wakeup2_valid && head_pending_entry.data.rs1_preg == wakeup2_preg)
                    || (wakeup3_valid && head_pending_entry.data.rs1_preg == wakeup3_preg) {
                    head_entry.rs1_ready = 1;
                }
                if (wakeup0_valid && head_pending_entry.data.rs2_preg == wakeup0_preg)
                    || (wakeup1_valid && head_pending_entry.data.rs2_preg == wakeup1_preg)
                    || (wakeup2_valid && head_pending_entry.data.rs2_preg == wakeup2_preg)
                    || (wakeup3_valid && head_pending_entry.data.rs2_preg == wakeup3_preg) {
                    head_entry.rs2_ready = 1;
                }
                head_pending_valid = 0;
            } else if wvalid && wready && count == 0 {
                head_entry.data      = wdata;
                head_entry.rs1_ready = wrs1ready;
                head_entry.rs2_ready = wrs2ready;
            } else if rvalid && rready {
                if wvalid && wready && count == 1 {
                    head_pending_entry.data      = wdata;
                    head_pending_entry.rs1_ready = wrs1ready;
                    head_pending_entry.rs2_ready = wrs2ready;
                    head_pending_valid           = 1;
                } else {
                    head_entry = next_head_entry;
                }
            } else {
                // 通常サイクルはheadのデータを保持し、head自身のready bitだけ更新する。
                if (wakeup0_valid && head_entry.data.rs1_preg == wakeup0_preg)
                    || (wakeup1_valid && head_entry.data.rs1_preg == wakeup1_preg)
                    || (wakeup2_valid && head_entry.data.rs1_preg == wakeup2_preg)
                    || (wakeup3_valid && head_entry.data.rs1_preg == wakeup3_preg) {
                    head_entry.rs1_ready = 1;
                }
                if (wakeup0_valid && head_entry.data.rs2_preg == wakeup0_preg)
                    || (wakeup1_valid && head_entry.data.rs2_preg == wakeup1_preg)
                    || (wakeup2_valid && head_entry.data.rs2_preg == wakeup2_preg)
                    || (wakeup3_valid && head_entry.data.rs2_preg == wakeup3_preg) {
                    head_entry.rs2_ready = 1;
                }
            }
            count    = count_next;
            head_ptr = head_next;
            tail_ptr = tail_next;
            for i in 0..8 {
                valid[i] = valid_next[i];
            }
        }
    }

}
