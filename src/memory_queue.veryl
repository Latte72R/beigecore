import eei::*;
import corectrl::*;

// In-order memory queue with selective removal of a mispredicted branch's
// younger entries.  ROB order and queue insertion order are identical.
module memory_queue (
    clk  : input clock,
    rst  : input reset,
    flush: input logic,

    squash     : input logic ,
    squash_head: input RobTag,
    squash_tag : input RobTag,

    wready: output logic   ,
    wvalid: input  logic   ,
    wdata : input  euq_type,
    rready: input  logic   ,
    rvalid: output logic   ,
    rdata : output euq_type,
) {
    // An 8-slot ring FIFO has the same 7-entry effective capacity.
    var entries     : euq_type    [7];
    var entries_next: euq_type    [7];
    var count       : logic   <3>    ;
    var count_next  : logic   <3>    ;
    var keep_count  : logic   <3>    ;

    always_comb {
        rvalid = count != 0;
        rdata  = entries[0];
        wready = count != 7;
    }

    always_comb {
        entries_next = entries;
        count_next   = count;

        if rvalid && rready {
            for i in 0..6 {
                entries_next[i] = entries_next[i + 1];
            }
            entries_next[6] =  '0;
            count_next      -= 1;
        }

        if wvalid && wready {
            entries_next[count_next] =  wdata;
            count_next               += 1;
        }

        // Younger entries are a suffix because insertion is in program order.
        keep_count = 0;
        if squash {
            for i in 0..7 {
                if i <: count_next && !((entries_next[i].rob_tag - squash_head) >: (squash_tag - squash_head)) {
                    keep_count += 1;
                }
            }
            for i in 0..7 {
                if i >: keep_count {
                    entries_next[i] = '0;
                }
            }
            count_next = keep_count;
        }
    }

    #[allow(missing_reset_statement)]
    always_ff {
        if_reset {
            count = 0;
            for i in 0..7 {
                entries[i] = '0;
            }
        } else if flush {
            count = 0;
            for i in 0..7 {
                entries[i] = '0;
            }
        } else {
            entries = entries_next;
            count   = count_next;
        }
    }
}
